/**
 * DEJOIY Universe — Phase 2 (mobile-first)
 */

.dejoiy-universe-home .page-heading,
.dejoiy-universe-home .woocommerce-breadcrumb,
.dejoiy-universe-home .xstore-breadcrumb {
	display: none !important;
}

.dejoiy-universe-home #dejoiy-universe,
.dejoiy-universe {
	--du-v: #7c3aed;
	--du-p: #ec4899;
	--du-c: #06b6d4;
	--du-ink: #0f172a;
	--du-muted: #64748b;
	--du-line: rgba(15, 23, 42, 0.08);
	--du-glass: rgba(255, 255, 255, 0.72);
	--du-radius: 20px;
	--du-shadow: 0 20px 50px -24px rgba(15, 23, 42, 0.35);
	--du-font: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
	max-width: 100%;
	overflow-x: hidden;
	margin: 0 auto;
	padding: 0 0 3rem;
	font-family: var(--du-font);
	color: var(--du-ink);
	background: linear-gradient(180deg, #faf8ff 0%, #fff 28%, #f8fafc 100%);
}

.dejoiy-universe-home.dejoiy-site-chrome-on .du-footer {
	display: none !important;
}

.dejoiy-universe-home.dejoiy-site-chrome-on .dejoiy-site-chrome-header,
.dejoiy-universe-home.dejoiy-site-chrome-on .dejoiy-site-chrome-header .elementor-location-header,
.dejoiy-universe-home.dejoiy-site-chrome-on .dejoiy-site-chrome-footer,
.dejoiy-universe-home.dejoiy-site-chrome-on .dejoiy-site-chrome-footer .elementor-location-footer {
	display: block !important;
	visibility: visible !important;
}

.dejoiy-universe-home.dejoiy-site-chrome-on .page-wrapper {
	display: flex;
	flex-direction: column;
}

.dejoiy-universe-home.dejoiy-site-chrome-on header.elementor-location-header {
	order: -10;
}

.dejoiy-universe-home.dejoiy-site-chrome-on #dejoiy-universe {
	order: -5;
}

.screen-reader-text {
	clip: rect(1px, 1px, 1px, 1px);
	height: 1px;
	overflow: hidden;
	position: absolute;
	width: 1px;
}

/* —— Hero —— */
.du-hero {
	position: relative;
	padding: clamp(2rem, 6vw, 4.5rem) clamp(1rem, 4vw, 2rem) clamp(2.5rem, 5vw, 3.5rem);
	overflow: hidden;
}

.du-hero__orb {
	position: absolute;
	border-radius: 50%;
	filter: blur(60px);
	opacity: 0.45;
	pointer-events: none;
}

.du-hero__orb--a {
	width: min(420px, 80vw);
	height: min(420px, 80vw);
	background: radial-gradient(circle, rgba(124, 58, 237, 0.5), transparent 70%);
	top: -20%;
	right: -10%;
}

.du-hero__orb--b {
	width: min(320px, 60vw);
	height: min(320px, 60vw);
	background: radial-gradient(circle, rgba(236, 72, 153, 0.35), transparent 70%);
	bottom: -10%;
	left: -5%;
}

.du-hero__in {
	position: relative;
	max-width: 1200px;
	margin: 0 auto;
	text-align: center;
}

.du-hero__kicker {
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.2em;
	text-transform: uppercase;
	color: var(--du-v);
	margin: 0 0 0.5rem;
}

.du-hero__title {
	font-size: clamp(2.25rem, 8vw, 3.75rem);
	font-weight: 800;
	line-height: 1.05;
	margin: 0 0 0.75rem;
	letter-spacing: -0.03em;
	background: linear-gradient(135deg, #0f172a 0%, #7c3aed 55%, #ec4899 100%);
	-webkit-background-clip: text;
	background-clip: text;
	color: transparent;
}

.du-hero__lead {
	font-size: clamp(1rem, 2.5vw, 1.2rem);
	color: var(--du-muted);
	max-width: 36rem;
	margin: 0 auto 2rem;
	line-height: 1.55;
}

.du-gates {
	display: grid;
	grid-template-columns: 1fr;
	gap: 0.85rem;
	max-width: 1100px;
	margin: 0 auto;
}

@media (min-width: 480px) {
	.du-gates {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (min-width: 900px) {
	.du-gates {
		grid-template-columns: repeat(5, 1fr);
		gap: 1rem;
	}
}

.du-gate {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 0.2rem;
	padding: 1.15rem 1.1rem 1rem;
	border-radius: var(--du-radius);
	text-decoration: none;
	color: var(--du-ink);
	background: var(--du-glass);
	border: 1px solid var(--du-line);
	box-shadow: var(--du-shadow);
	overflow: hidden;
	min-height: 148px;
	transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.du-gate:hover {
	transform: translateY(-6px);
	box-shadow: 0 28px 60px -20px rgba(124, 58, 237, 0.35);
}

.du-gate__art {
	position: absolute;
	inset: 0;
	opacity: 0.55;
	pointer-events: none;
}

.du-gate--market .du-gate__art {
	background: linear-gradient(145deg, rgba(124, 58, 237, 0.2), transparent 55%),
		radial-gradient(circle at 90% 20%, rgba(236, 72, 153, 0.25), transparent 45%);
}

.du-gate--nexus .du-gate__art {
	background: linear-gradient(160deg, rgba(15, 23, 42, 0.85), rgba(99, 102, 241, 0.35));
}

.du-gate--studio .du-gate__art {
	background: linear-gradient(135deg, rgba(236, 72, 153, 0.25), rgba(251, 191, 36, 0.2));
}

.du-gate--quickmart .du-gate__art {
	background: linear-gradient(135deg, rgba(6, 182, 212, 0.3), rgba(34, 197, 94, 0.2));
}

.du-gate--services .du-gate__art {
	background: linear-gradient(135deg, rgba(30, 64, 175, 0.25), rgba(148, 163, 184, 0.2));
}

.du-gate__icon {
	position: relative;
	font-size: 1.35rem;
	line-height: 1;
}

.du-gate__verb {
	position: relative;
	font-size: 0.65rem;
	font-weight: 800;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	opacity: 0.7;
}

.du-gate__label {
	position: relative;
	font-size: 1.05rem;
	font-weight: 700;
	line-height: 1.2;
}

.du-gate__tag {
	position: relative;
	font-size: 0.8rem;
	color: var(--du-muted);
	line-height: 1.3;
}

.du-gate--nexus {
	color: #f8fafc;
}

.du-gate--nexus .du-gate__tag {
	color: rgba(248, 250, 252, 0.75);
}

/* —— Story —— */
.du-story {
	padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2rem);
	text-align: center;
}

.du-story__in {
	max-width: 720px;
	margin: 0 auto;
}

.du-story__formula {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: center;
	gap: 0.35rem 0.5rem;
	font-weight: 800;
	font-size: clamp(1.5rem, 5vw, 2.25rem);
	margin: 0 0 1rem;
	letter-spacing: -0.02em;
}

.du-story__you { color: var(--du-v); }
.du-story__joy { color: var(--du-p); }
.du-story__plus,
.du-story__eq {
	color: var(--du-muted);
	font-weight: 600;
}

.du-story__brand {
	background: linear-gradient(90deg, var(--du-v), var(--du-p));
	-webkit-background-clip: text;
	background-clip: text;
	color: transparent;
}

.du-story__title {
	font-size: clamp(1.35rem, 3vw, 1.75rem);
	font-weight: 600;
	margin: 0 0 1.25rem;
	color: var(--du-ink);
}

.du-story__verbs {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 0.5rem 1rem;
}

.du-story__verbs li {
	font-size: 0.95rem;
	font-weight: 600;
	color: var(--du-muted);
	padding: 0.35rem 0.85rem;
	border-radius: 999px;
	background: rgba(124, 58, 237, 0.06);
	border: 1px solid var(--du-line);
}

/* —— JOI —— */
.du-joi {
	padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 2rem);
}

.du-joi__in {
	max-width: 880px;
	margin: 0 auto;
	padding: clamp(1.5rem, 4vw, 2.25rem);
	border-radius: calc(var(--du-radius) + 4px);
	background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(6, 182, 212, 0.06));
	border: 1px solid rgba(124, 58, 237, 0.15);
	box-shadow: var(--du-shadow);
}

.du-joi__badge {
	font-size: 0.7rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	color: var(--du-v);
	margin: 0 0 0.5rem;
}

.du-joi__title {
	font-size: clamp(1.75rem, 5vw, 2.5rem);
	font-weight: 800;
	margin: 0 0 0.5rem;
	letter-spacing: -0.02em;
}

.du-joi__lead {
	color: var(--du-muted);
	margin: 0 0 1.25rem;
	line-height: 1.5;
	font-size: 0.95rem;
}

.du-joi__form {
	display: flex;
	flex-direction: column;
	gap: 0.65rem;
	margin-bottom: 1rem;
}

@media (min-width: 560px) {
	.du-joi__form {
		flex-direction: row;
	}
}

.du-joi__input {
	flex: 1;
	min-width: 0;
	padding: 0.9rem 1rem;
	border-radius: 14px;
	border: 1px solid var(--du-line);
	font-size: 1rem;
	background: #fff;
}

.du-joi__input:focus {
	outline: 2px solid rgba(124, 58, 237, 0.35);
	border-color: var(--du-v);
}

.du-joi__submit {
	padding: 0.9rem 1.35rem;
	border: none;
	border-radius: 14px;
	font-weight: 700;
	font-size: 0.95rem;
	cursor: pointer;
	color: #fff;
	background: linear-gradient(135deg, var(--du-v), #9333ea);
	white-space: nowrap;
}

.du-joi__examples {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.du-joi__chip {
	font-size: 0.8rem;
	font-weight: 600;
	padding: 0.45rem 0.85rem;
	border-radius: 999px;
	text-decoration: none;
	color: var(--du-ink);
	background: #fff;
	border: 1px solid var(--du-line);
	transition: background 0.2s, border-color 0.2s;
}

.du-joi__chip:hover {
	border-color: var(--du-v);
	background: rgba(124, 58, 237, 0.06);
}

/* —— Recommendations —— */
.du-reco {
	padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem);
}

.du-reco__in {
	max-width: 1200px;
	margin: 0 auto;
}

.du-reco__title {
	font-size: clamp(1.35rem, 3vw, 1.85rem);
	font-weight: 800;
	margin: 0 0 1rem;
	letter-spacing: -0.02em;
}

.du-reco__tabs {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
	margin-bottom: 1.25rem;
}

.du-reco__tab {
	padding: 0.5rem 1rem;
	border-radius: 999px;
	border: 1px solid var(--du-line);
	background: #fff;
	font-size: 0.85rem;
	font-weight: 600;
	cursor: pointer;
	color: var(--du-muted);
	transition: all 0.2s;
}

.du-reco__tab.is-active,
.du-reco__tab[aria-selected="true"] {
	background: var(--du-ink);
	color: #fff;
	border-color: var(--du-ink);
}

.du-reco__panel[hidden] {
	display: none !important;
}

/* —— Product Card V2 —— */
.du-shelf-v2 {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 0.85rem;
}

@media (min-width: 600px) {
	.du-shelf-v2 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
}

@media (min-width: 1024px) {
	.du-shelf-v2 {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.15rem;
	}
}

.du-card-v2 {
	position: relative;
	border-radius: 16px;
	background: #fff;
	border: 1px solid var(--du-line);
	box-shadow: 0 8px 30px -18px rgba(15, 23, 42, 0.2);
	transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.du-card-v2:hover {
	transform: translateY(-4px);
	box-shadow: 0 20px 40px -16px rgba(124, 58, 237, 0.22);
}

.du-card-v2__fav {
	position: absolute;
	top: 0.5rem;
	right: 0.5rem;
	z-index: 2;
	width: 2rem;
	height: 2rem;
	border: none;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.92);
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	cursor: pointer;
	font-size: 1rem;
	line-height: 1;
	display: flex;
	align-items: center;
	justify-content: center;
}

.du-card-v2__fav[aria-pressed="true"] {
	color: var(--du-p);
}

.du-card-v2__link {
	display: block;
	text-decoration: none;
	color: inherit;
}

.du-card-v2__media {
	position: relative;
	aspect-ratio: 4 / 5;
	border-radius: 16px 16px 0 0;
	overflow: hidden;
	background: linear-gradient(145deg, #f1f5f9, #e2e8f0);
}

.du-card-v2__img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}

.du-card-v2__ph {
	display: block;
	width: 100%;
	height: 100%;
	background: linear-gradient(135deg, #e9d5ff, #fbcfe8);
}

.du-card-v2__eco {
	position: absolute;
	left: 0.5rem;
	bottom: 0.5rem;
	font-size: 0.65rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	padding: 0.25rem 0.5rem;
	border-radius: 6px;
	background: rgba(15, 23, 42, 0.75);
	color: #fff;
	max-width: calc(100% - 1rem);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.du-card-v2__body {
	padding: 0.75rem 0.85rem 0.9rem;
}

.du-card-v2__dpin {
	display: block;
	font-family: ui-monospace, monospace;
	font-size: 0.65rem;
	color: var(--du-v);
	margin-bottom: 0.25rem;
	letter-spacing: 0.04em;
}

.du-card-v2__title {
	font-size: 0.88rem;
	font-weight: 600;
	line-height: 1.35;
	margin: 0 0 0.35rem;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.du-card-v2__price {
	display: block;
	font-size: 0.9rem;
	font-weight: 700;
	color: var(--du-ink);
	margin-bottom: 0.4rem;
}

.du-card-v2__price .woocommerce-Price-amount {
	font-weight: 700;
}

.du-card-v2__seller {
	display: flex;
	align-items: center;
	gap: 0.35rem;
	font-size: 0.72rem;
	color: var(--du-muted);
}

.du-card-v2__seller-dot {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: #22c55e;
	flex-shrink: 0;
}

/* —— Worlds —— */
.du-world {
	position: relative;
	margin: clamp(1.5rem, 4vw, 2.5rem) clamp(0.75rem, 3vw, 1.5rem);
	border-radius: calc(var(--du-radius) + 6px);
	overflow: hidden;
}

.du-world__banner {
	position: absolute;
	inset: 0;
	pointer-events: none;
	opacity: 0.9;
}

.du-world--nexus {
	background: #0f172a;
	color: #f8fafc;
}

.du-world--nexus .du-world__banner {
	background: radial-gradient(ellipse 80% 60% at 100% 0%, rgba(99, 102, 241, 0.45), transparent),
		radial-gradient(ellipse 60% 50% at 0% 100%, rgba(124, 58, 237, 0.25), transparent);
}

.du-world--studio {
	background: linear-gradient(160deg, #fff7ed, #fce7f3);
}

.du-world--studio .du-world__banner {
	background: radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.2), transparent 50%);
}

.du-world--quickmart {
	background: linear-gradient(160deg, #ecfeff, #f0fdf4);
}

.du-world--quickmart .du-world__banner {
	background: radial-gradient(circle at 10% 90%, rgba(6, 182, 212, 0.2), transparent 55%);
}

.du-world--services {
	background: linear-gradient(160deg, #eff6ff, #f8fafc);
}

.du-world--services .du-world__banner {
	background: radial-gradient(circle at 90% 10%, rgba(37, 99, 235, 0.12), transparent 50%);
}

.du-world__in {
	position: relative;
	padding: clamp(1.5rem, 4vw, 2.25rem);
	max-width: 1200px;
	margin: 0 auto;
}

.du-world__kicker {
	font-size: 0.7rem;
	font-weight: 700;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	opacity: 0.75;
	margin: 0 0 0.35rem;
}

.du-world__title {
	font-size: clamp(1.35rem, 3vw, 1.85rem);
	font-weight: 800;
	margin: 0 0 0.5rem;
	letter-spacing: -0.02em;
}

.du-world__desc {
	font-size: 0.95rem;
	line-height: 1.5;
	opacity: 0.85;
	margin: 0 0 1rem;
	max-width: 32rem;
}

.du-world--nexus .du-world__desc,
.du-world--nexus .du-world__kicker {
	color: rgba(248, 250, 252, 0.8);
}

.du-world__cta {
	display: inline-block;
	font-size: 0.85rem;
	font-weight: 700;
	padding: 0.55rem 1.1rem;
	border-radius: 999px;
	text-decoration: none;
	transition: transform 0.2s, opacity 0.2s;
}

.du-world--nexus .du-world__cta {
	background: #fff;
	color: #0f172a;
}

.du-world--studio .du-world__cta {
	background: var(--du-p);
	color: #fff;
}

.du-world--quickmart .du-world__cta {
	background: var(--du-c);
	color: #fff;
}

.du-world--services .du-world__cta {
	background: #1d4ed8;
	color: #fff;
}

.du-world__cta:hover {
	transform: translateY(-2px);
	opacity: 0.92;
}

.du-world--nexus .du-card-v2 {
	background: rgba(255, 255, 255, 0.06);
	border-color: rgba(255, 255, 255, 0.12);
}

.du-world--nexus .du-card-v2__title,
.du-world--nexus .du-card-v2__price {
	color: #f8fafc;
}

.du-world--nexus .du-card-v2__seller {
	color: rgba(248, 250, 252, 0.65);
}

/* —— Join CTA —— */
.du-join {
	margin: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem) 0;
	padding: clamp(2rem, 5vw, 3rem);
	border-radius: calc(var(--du-radius) + 8px);
	background: linear-gradient(135deg, #0f172a 0%, #312e81 50%, #7c3aed 100%);
	color: #fff;
	text-align: center;
	box-shadow: var(--du-shadow);
}

.du-join__in {
	max-width: 560px;
	margin: 0 auto;
}

.du-join__title {
	font-size: clamp(1.5rem, 4vw, 2rem);
	font-weight: 800;
	margin: 0 0 0.5rem;
}

.du-join__lead {
	opacity: 0.88;
	margin: 0 0 1.25rem;
	line-height: 1.5;
}

.du-join__roles {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 0.5rem;
	margin-bottom: 1.5rem;
}

.du-join__roles span {
	font-size: 0.8rem;
	font-weight: 600;
	padding: 0.4rem 0.75rem;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.12);
	border: 1px solid rgba(255, 255, 255, 0.2);
}

.du-join__btn {
	display: inline-block;
	padding: 0.85rem 1.75rem;
	border-radius: 999px;
	font-weight: 700;
	text-decoration: none;
	color: #0f172a;
	background: #fff;
	transition: transform 0.2s;
}

.du-join__btn:hover {
	transform: translateY(-2px);
}

/* —— Reveal —— */
.du-reveal {
	opacity: 0;
	transform: translateY(18px);
	transition: opacity 0.55s ease, transform 0.55s ease;
}

.du-reveal.du-visible {
	opacity: 1;
	transform: none;
}

@media (prefers-reduced-motion: reduce) {
	.du-hero__orb,
	.du-reveal,
	.du-gate,
	.du-card-v2 {
		animation: none !important;
		transition: none !important;
	}
	.du-reveal {
		opacity: 1;
		transform: none;
	}
}


/* Antigravity accents (CSS-only; respects reduced motion) */
@keyframes du-ag-drift {
	0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
	50% { transform: translate3d(0, -14px, 0) rotate(4deg); }
}

.du-hero__ag,
.du-world__ag {
	pointer-events: none;
	position: absolute;
	inset: 0;
	overflow: hidden;
	z-index: 0;
}

.du-ag-float {
	position: absolute;
	border-radius: 50%;
	opacity: 0.55;
	filter: blur(0.5px);
	animation: du-ag-drift 7s ease-in-out infinite;
	will-change: transform;
}

.du-hero__ag .du-ag-float--1 {
	width: 72px;
	height: 72px;
	top: 12%;
	right: 8%;
	background: radial-gradient(circle at 30% 30%, rgba(167, 139, 250, 0.9), rgba(99, 102, 241, 0.2));
	animation-duration: 8s;
}

.du-hero__ag .du-ag-float--2 {
	width: 48px;
	height: 48px;
	bottom: 18%;
	left: 6%;
	background: radial-gradient(circle at 30% 30%, rgba(56, 189, 248, 0.85), rgba(14, 165, 233, 0.15));
	animation-delay: -2s;
	animation-duration: 9s;
}

.du-hero__ag .du-ag-float--3 {
	width: 36px;
	height: 36px;
	top: 42%;
	left: 42%;
	border-radius: 12px;
	transform: rotate(18deg);
	background: linear-gradient(135deg, rgba(251, 191, 36, 0.7), rgba(244, 114, 182, 0.35));
	animation-delay: -4s;
}

.du-world__ag .du-ag-float {
	opacity: 0.35;
}

.du-world--nexus .du-ag-float--1 {
	width: 56px;
	height: 56px;
	right: 6%;
	top: 20%;
	background: radial-gradient(circle, rgba(192, 132, 252, 0.8), transparent 70%);
}

.du-world--studio .du-ag-float--1 {
	width: 52px;
	height: 52px;
	left: 8%;
	bottom: 24%;
	background: radial-gradient(circle, rgba(244, 114, 182, 0.75), transparent 70%);
	animation-delay: -1.5s;
}

.du-card-v2__media {
	position: relative;
}

.du-card-v2__media::after {
	content: "";
	position: absolute;
	inset: auto 10% 8% 10%;
	height: 12px;
	border-radius: 999px;
	background: radial-gradient(ellipse, rgba(15, 23, 42, 0.22), transparent 70%);
	opacity: 0;
	transition: opacity 0.35s ease, transform 0.35s ease;
	transform: translateY(8px);
	pointer-events: none;
}

.du-card-v2:hover .du-card-v2__img,
.du-card-v2:focus-within .du-card-v2__img {
	transform: translateY(-6px) scale(1.02);
}

.du-card-v2:hover .du-card-v2__media::after,
.du-card-v2:focus-within .du-card-v2__media::after {
	opacity: 1;
	transform: translateY(0);
}

.du-card-v2__img {
	transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.du-gate:hover,
.du-gate:focus-visible {
	transform: translateY(-6px) scale(1.01);
}

@media (prefers-reduced-motion: reduce) {
	.du-ag-float,
	.du-hero__orb {
		animation: none !important;
	}
	.du-card-v2__img,
	.du-gate {
		transition: none;
	}
}

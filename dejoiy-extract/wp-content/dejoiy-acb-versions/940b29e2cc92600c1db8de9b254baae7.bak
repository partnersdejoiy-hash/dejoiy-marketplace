/**
 * DEJOIY Shop Discovery Hub — /shop only
 * Scoped: body.dejoiy-shop-discovery-hub
 */

body.dejoiy-shop-discovery-hub {
	--dsh-violet: #7c3aed;
	--dsh-pink: #ec4899;
	--dsh-cyan: #06b6d4;
	--dsh-ink: #0f172a;
	--dsh-muted: #64748b;
	--dsh-surface: #ffffff;
	--dsh-surface-2: #f8fafc;
	--dsh-border: rgba(15, 23, 42, 0.08);
	--dsh-radius: 14px;
	--dsh-radius-lg: 20px;
	--dsh-shadow: 0 8px 28px rgba(15, 23, 42, 0.07);
	--dsh-shadow-hover: 0 14px 40px rgba(124, 58, 237, 0.12);
	--dsh-max: 1440px;
	--dsh-pad: clamp(0.75rem, 3vw, 1.5rem);
	--dsh-toolbar-sticky: 0px;
}

body.dejoiy-shop-discovery-hub .woocommerce-products-header,
body.dejoiy-shop-discovery-hub .page-title,
body.dejoiy-shop-discovery-hub .woocommerce-breadcrumb:first-of-type {
	display: none !important;
}

body.dejoiy-shop-discovery-hub .site-content,
body.dejoiy-shop-discovery-hub .content-page {
	overflow-x: hidden;
}

/* —— Hub shell —— */
body.dejoiy-shop-discovery-hub .dsh-hub {
	max-width: var(--dsh-max);
	margin: 0 auto;
	padding: 0 var(--dsh-pad) 1.5rem;
	font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
	color: var(--dsh-ink);
}

body.dejoiy-shop-discovery-hub .dsh-banner {
	margin: 0 0 1.25rem;
	padding: clamp(1.25rem, 4vw, 2rem);
	border-radius: var(--dsh-radius-lg);
	background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(236, 72, 153, 0.08), rgba(6, 182, 212, 0.06));
	border: 1px solid var(--dsh-border);
	box-shadow: var(--dsh-shadow);
}

body.dejoiy-shop-discovery-hub .dsh-banner__eyebrow {
	margin: 0 0 0.35rem;
	font-size: 0.72rem;
	font-weight: 700;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	color: var(--dsh-violet);
}

body.dejoiy-shop-discovery-hub .dsh-banner__title {
	margin: 0 0 0.65rem;
	font-size: clamp(1.35rem, 4.5vw, 2rem);
	font-weight: 800;
	line-height: 1.15;
	letter-spacing: -0.02em;
}

body.dejoiy-shop-discovery-hub .dsh-banner__desc {
	margin: 0 0 0.5rem;
	font-size: clamp(0.88rem, 2.5vw, 1.05rem);
	line-height: 1.55;
	color: var(--dsh-muted);
	max-width: 62ch;
}

body.dejoiy-shop-discovery-hub .dsh-banner__note {
	margin: 0;
	font-size: 0.82rem;
	font-weight: 600;
	color: var(--dsh-violet);
}

/* —— Ecosystem legend —— */
body.dejoiy-shop-discovery-hub .dsh-legend {
	margin-bottom: 1rem;
}

body.dejoiy-shop-discovery-hub .dsh-legend__track {
	display: flex;
	gap: 0.75rem;
	overflow-x: auto;
	scroll-snap-type: x mandatory;
	-webkit-overflow-scrolling: touch;
	padding: 0.25rem 0 0.75rem;
	scrollbar-width: none;
}

body.dejoiy-shop-discovery-hub .dsh-legend__track::-webkit-scrollbar {
	display: none;
}

body.dejoiy-shop-discovery-hub .dsh-legend-card {
	flex: 0 0 min(82vw, 260px);
	scroll-snap-align: start;
	padding: 1rem 1.1rem;
	background: var(--dsh-surface);
	border: 1px solid var(--dsh-border);
	border-radius: var(--dsh-radius);
	box-shadow: var(--dsh-shadow);
	position: relative;
}

body.dejoiy-shop-discovery-hub .dsh-legend-card--soon {
	opacity: 0.92;
	background: linear-gradient(180deg, var(--dsh-surface) 0%, rgba(248, 250, 252, 0.95) 100%);
}

body.dejoiy-shop-discovery-hub .dsh-legend-card__soon {
	display: inline-block;
	margin-bottom: 0.35rem;
	padding: 0.2rem 0.5rem;
	font-size: 0.62rem;
	font-weight: 800;
	letter-spacing: 0.1em;
	color: #fff;
	background: linear-gradient(135deg, var(--dsh-violet), var(--dsh-pink));
	border-radius: 999px;
}

body.dejoiy-shop-discovery-hub .dsh-legend-card__launch {
	display: block;
	font-size: 0.68rem;
	color: var(--dsh-muted);
	margin-bottom: 0.25rem;
}

body.dejoiy-shop-discovery-hub .dsh-legend-card__icon {
	display: block;
	font-size: 1.35rem;
	margin-bottom: 0.35rem;
}

body.dejoiy-shop-discovery-hub .dsh-legend-card__title {
	margin: 0 0 0.35rem;
	font-size: 1rem;
	font-weight: 700;
}

body.dejoiy-shop-discovery-hub .dsh-legend-card__desc {
	margin: 0;
	font-size: 0.78rem;
	line-height: 1.45;
	color: var(--dsh-muted);
}

/* —— Toolbar: search + filters —— */
body.dejoiy-shop-discovery-hub .dsh-toolbar {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	margin-bottom: 1rem;
	position: sticky;
	top: var(--dsh-toolbar-sticky, 0);
	z-index: 40;
	padding: 0.65rem 0;
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 70%, rgba(255, 255, 255, 0.85) 100%);
	backdrop-filter: blur(10px);
}

body.dejoiy-shop-discovery-hub .dsh-search {
	display: flex;
	gap: 0.5rem;
	width: 100%;
}

body.dejoiy-shop-discovery-hub .dsh-search__input {
	flex: 1;
	min-width: 0;
	padding: 0.7rem 1rem;
	border: 1px solid var(--dsh-border);
	border-radius: 999px;
	font-size: 0.9rem;
	background: var(--dsh-surface);
}

body.dejoiy-shop-discovery-hub .dsh-search__btn {
	flex-shrink: 0;
	padding: 0.7rem 1.1rem;
	border: none;
	border-radius: 999px;
	font-size: 0.85rem;
	font-weight: 600;
	color: #fff;
	background: linear-gradient(135deg, var(--dsh-violet), var(--dsh-pink));
	cursor: pointer;
}

body.dejoiy-shop-discovery-hub .dsh-filters {
	display: none;
	flex-wrap: wrap;
	gap: 0.45rem;
}

body.dejoiy-shop-discovery-hub .dsh-filters__pill {
	display: inline-flex;
	align-items: center;
	gap: 0.3rem;
	padding: 0.45rem 0.85rem;
	font-size: 0.8rem;
	font-weight: 600;
	text-decoration: none;
	color: var(--dsh-ink);
	background: var(--dsh-surface);
	border: 1px solid var(--dsh-border);
	border-radius: 999px;
	transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

body.dejoiy-shop-discovery-hub .dsh-filters__pill:hover,
body.dejoiy-shop-discovery-hub .dsh-filters__pill.is-active {
	border-color: rgba(124, 58, 237, 0.35);
	box-shadow: 0 4px 14px rgba(124, 58, 237, 0.15);
	transform: translateY(-1px);
}

body.dejoiy-shop-discovery-hub .dsh-filters__pill.is-active {
	background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(236, 72, 153, 0.08));
	color: var(--dsh-violet);
}

body.dejoiy-shop-discovery-hub .dsh-filters__pill--soon {
	opacity: 0.65;
	pointer-events: none;
}

body.dejoiy-shop-discovery-hub .dsh-filters__soon {
	font-size: 0.62rem;
	font-style: normal;
	font-weight: 800;
	text-transform: uppercase;
	color: var(--dsh-pink);
}

body.dejoiy-shop-discovery-hub .dsh-filters-toggle {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	padding: 0.65rem;
	font-size: 0.88rem;
	font-weight: 600;
	border: 1px solid var(--dsh-border);
	border-radius: var(--dsh-radius);
	background: var(--dsh-surface);
	cursor: pointer;
}

body.dejoiy-shop-discovery-hub .dsh-filters-drawer[hidden] {
	display: none;
}

body.dejoiy-shop-discovery-hub .dsh-filters-drawer.is-open {
	position: fixed;
	inset: 0;
	z-index: 100050;
	background: rgba(15, 23, 42, 0.45);
	display: flex;
	align-items: flex-end;
}

body.dejoiy-shop-discovery-hub .dsh-filters-drawer__panel {
	width: 100%;
	max-height: 70vh;
	overflow-y: auto;
	padding: 1rem;
	background: var(--dsh-surface);
	border-radius: var(--dsh-radius-lg) var(--dsh-radius-lg) 0 0;
}

body.dejoiy-shop-discovery-hub .dsh-filters-drawer__item {
	display: block;
	padding: 0.85rem 1rem;
	margin-bottom: 0.35rem;
	text-decoration: none;
	font-weight: 600;
	color: var(--dsh-ink);
	border-radius: var(--dsh-radius);
	border: 1px solid var(--dsh-border);
}

body.dejoiy-shop-discovery-hub .dsh-filters-drawer__item.is-active {
	border-color: var(--dsh-violet);
	background: rgba(124, 58, 237, 0.08);
}

/* —— Catalog / WC loop —— */
body.dejoiy-shop-discovery-hub .dsh-catalog {
	max-width: var(--dsh-max);
	margin: 0 auto;
	padding: 0 var(--dsh-pad) 2rem;
}

body.dejoiy-shop-discovery-hub .woocommerce-result-count,
body.dejoiy-shop-discovery-hub .woocommerce-ordering {
	margin-bottom: 1rem;
}

body.dejoiy-shop-discovery-hub ul.products {
	display: grid !important;
	grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
	gap: clamp(0.65rem, 2.5vw, 1rem) !important;
	margin: 0 !important;
	padding: 0 !important;
	list-style: none !important;
}

body.dejoiy-shop-discovery-hub ul.products::before,
body.dejoiy-shop-discovery-hub ul.products::after {
	display: none !important;
}

body.dejoiy-shop-discovery-hub ul.products li.product {
	width: 100% !important;
	float: none !important;
	margin: 0 !important;
	padding: 0 !important;
	clear: none !important;
}

body.dejoiy-shop-discovery-hub .dsh-product-card {
	display: flex;
	flex-direction: column;
	height: 100%;
	background: var(--dsh-surface);
	border: 1px solid var(--dsh-border);
	border-radius: var(--dsh-radius);
	box-shadow: var(--dsh-shadow);
	overflow: hidden;
	transition: transform 0.2s ease, box-shadow 0.2s ease;
}

body.dejoiy-shop-discovery-hub ul.products li.product:hover .dsh-product-card {
	transform: translateY(-3px);
	box-shadow: var(--dsh-shadow-hover);
}

body.dejoiy-shop-discovery-hub .dsh-product-card .woocommerce-LoopProduct-link {
	display: flex;
	flex-direction: column;
	flex: 1;
	text-decoration: none;
	color: inherit;
	padding: 0.55rem 0.55rem 0.65rem;
}

body.dejoiy-shop-discovery-hub .dsh-product-card .attachment-woocommerce_thumbnail,
body.dejoiy-shop-discovery-hub .dsh-product-card img {
	width: 100%;
	aspect-ratio: 1;
	object-fit: cover;
	border-radius: calc(var(--dsh-radius) - 4px);
	margin: 0 0 0.5rem;
}

body.dejoiy-shop-discovery-hub .dsh-eco-badge {
	position: absolute;
	top: 0.65rem;
	left: 0.65rem;
	z-index: 2;
	display: inline-flex;
	align-items: center;
	gap: 0.25rem;
	max-width: calc(100% - 1.3rem);
	padding: 0.25rem 0.5rem;
	font-size: 0.62rem;
	font-weight: 700;
	line-height: 1.2;
	color: var(--dsh-ink);
	background: rgba(255, 255, 255, 0.94);
	border: 1px solid var(--dsh-border);
	border-radius: 999px;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

body.dejoiy-shop-discovery-hub .dsh-product-card {
	position: relative;
}

body.dejoiy-shop-discovery-hub .dsh-product-card .woocommerce-loop-product__title,
body.dejoiy-shop-discovery-hub .dsh-product-card h2 {
	margin: 0 0 0.35rem !important;
	padding: 0 !important;
	font-size: 0.82rem !important;
	font-weight: 600 !important;
	line-height: 1.35 !important;
	color: var(--dsh-ink) !important;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

body.dejoiy-shop-discovery-hub .dsh-product-card .price {
	margin: 0 !important;
	font-size: 0.85rem !important;
	font-weight: 700 !important;
	color: var(--dsh-violet) !important;
}

body.dejoiy-shop-discovery-hub .dsh-card__meta {
	display: flex;
	flex-direction: column;
	gap: 0.2rem;
	padding: 0 0.55rem 0.6rem;
	margin-top: auto;
}

body.dejoiy-shop-discovery-hub .dsh-card__dpin {
	font-size: 0.65rem;
	font-family: ui-monospace, monospace;
	letter-spacing: 0.05em;
	color: var(--dsh-muted);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

body.dejoiy-shop-discovery-hub .dsh-card__seller {
	display: flex;
	align-items: center;
	gap: 0.35rem;
	font-size: 0.68rem;
	color: var(--dsh-muted);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

body.dejoiy-shop-discovery-hub .dsh-card__seller-dot {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: #22c55e;
	flex-shrink: 0;
}

body.dejoiy-shop-discovery-hub .dsh-product-card .button,
body.dejoiy-shop-discovery-hub .dsh-product-card .add_to_cart_button {
	display: none !important;
}

/* Mobile OS offset */
@media (max-width: 1024px) {
	body.dejoiy-shop-discovery-hub.dejoiy-mobile-os-active {
		--dsh-toolbar-sticky: var(--dm-os-header-h, 52px);
	}

	body.dejoiy-shop-discovery-hub.dejoiy-mobile-os-active .dsh-toolbar {
		top: var(--dm-os-header-h, 52px);
	}

	body.dejoiy-shop-discovery-hub.dejoiy-mobile-os-active {
		padding-bottom: calc(var(--dm-os-bottom-h, 64px) + 1rem);
	}
}

/* —— Tablet —— */
@media (min-width: 768px) {
	body.dejoiy-shop-discovery-hub .dsh-legend__track {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		overflow: visible;
	}

	body.dejoiy-shop-discovery-hub .dsh-legend-card {
		flex: none;
	}

	body.dejoiy-shop-discovery-hub ul.products {
		grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
	}

	body.dejoiy-shop-discovery-hub .dsh-filters-toggle {
		display: none;
	}

	body.dejoiy-shop-discovery-hub .dsh-filters {
		display: flex;
	}

	body.dejoiy-shop-discovery-hub .dsh-toolbar {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	body.dejoiy-shop-discovery-hub .dsh-search {
		flex: 1 1 280px;
		max-width: 420px;
	}
}

/* —— Laptop —— */
@media (min-width: 1024px) {
	body.dejoiy-shop-discovery-hub .dsh-legend__track {
		grid-template-columns: repeat(5, 1fr);
	}

	body.dejoiy-shop-discovery-hub ul.products {
		grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
		gap: 1.1rem !important;
	}

	body.dejoiy-shop-discovery-hub .dsh-product-card .woocommerce-loop-product__title,
	body.dejoiy-shop-discovery-hub .dsh-product-card h2 {
		font-size: 0.9rem !important;
	}
}

/* —— Desktop —— */
@media (min-width: 1440px) {
	body.dejoiy-shop-discovery-hub ul.products {
		grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
	}

	body.dejoiy-shop-discovery-hub .dsh-hub,
	body.dejoiy-shop-discovery-hub .dsh-catalog {
		padding-left: clamp(1.5rem, 3vw, 2.5rem);
		padding-right: clamp(1.5rem, 3vw, 2.5rem);
	}
}

/* —— Ultrawide —— */
@media (min-width: 1680px) {
	body.dejoiy-shop-discovery-hub {
		--dsh-max: 1520px;
	}

	body.dejoiy-shop-discovery-hub ul.products {
		grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
	}
}

@media (prefers-reduced-motion: reduce) {
	body.dejoiy-shop-discovery-hub .dsh-product-card,
	body.dejoiy-shop-discovery-hub .dsh-filters__pill {
		transition: none;
	}
}

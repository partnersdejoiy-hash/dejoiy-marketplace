<?php
/**
 * DEJOIY child theme safe functions.
 *
 * Loads stable child theme styling, custom order numbers, and the guarded
 * DEJOIY Library module. Heavy Studio/DCS modules are intentionally left out
 * of this recovery-safe loader because they can trigger front-end fatals when
 * their plugin dependencies are unhealthy.
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

add_action( 'wp_enqueue_scripts', 'theme_enqueue_styles', 1001 );

/**
 * Load child theme styles.
 */
function theme_enqueue_styles() {
	if ( function_exists( 'etheme_child_styles' ) ) {
		etheme_child_styles();
	}
}

/**
 * Build custom DEJOIY order number.
 *
 * Normal orders: 2605181-482-0000123.
 * Subscription orders: DJS-2605181-0000123.
 *
 * @param WC_Order $order Order object.
 * @return string
 */
function dejoiy_build_custom_order_number( $order ) {
	if ( ! $order || ! is_a( $order, 'WC_Order' ) ) {
		return '';
	}

	$order_id   = $order->get_id();
	$date_part  = wp_date( 'ymdN' );
	$order_part = str_pad( (string) $order_id, 7, '0', STR_PAD_LEFT );

	$is_subscription = false;
	if ( function_exists( 'wcs_order_contains_subscription' ) ) {
		$is_subscription = wcs_order_contains_subscription(
			$order,
			array( 'parent', 'renewal', 'switch', 'resubscribe' )
		);
	}

	if ( $is_subscription ) {
		return 'DJS-' . $date_part . '-' . $order_part;
	}

	$random_part = str_pad( (string) wp_rand( 0, 999 ), 3, '0', STR_PAD_LEFT );
	return $date_part . '-' . $random_part . '-' . $order_part;
}

/**
 * Save custom order number once.
 *
 * @param int $order_id Order ID.
 */
function dejoiy_generate_custom_order_number( $order_id ) {
	if ( ! $order_id || ! function_exists( 'wc_get_order' ) ) {
		return;
	}

	$order = wc_get_order( $order_id );
	if ( ! $order ) {
		return;
	}

	$existing = $order->get_meta( '_dejoiy_custom_order_number', true );
	if ( ! empty( $existing ) ) {
		return;
	}

	$custom_number = dejoiy_build_custom_order_number( $order );
	if ( '' !== $custom_number ) {
		$order->update_meta_data( '_dejoiy_custom_order_number', $custom_number );
		$order->save();
	}
}

add_action( 'woocommerce_checkout_order_processed', 'dejoiy_generate_custom_order_number', 20, 1 );
add_action( 'woocommerce_new_order', 'dejoiy_generate_custom_order_number', 20, 1 );

/**
 * Display custom order number wherever WooCommerce prints order numbers.
 *
 * @param string   $order_number Order number.
 * @param WC_Order $order        Order object.
 * @return string
 */
function dejoiy_display_custom_order_number( $order_number, $order ) {
	if ( ! $order ) {
		return $order_number;
	}

	$custom_number = $order->get_meta( '_dejoiy_custom_order_number', true );
	return ! empty( $custom_number ) ? $custom_number : $order_number;
}

add_filter( 'woocommerce_order_number', 'dejoiy_display_custom_order_number', 10, 2 );

$dlu = get_stylesheet_directory() . '/library-universe.php';
if ( is_readable( $dlu ) ) {
	require_once $dlu;
}

<?php
/**
 * My Nexus — personal library dashboard (full page shell).
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

if ( ! function_exists( 'dejoiy_library_render_book_card' ) ) {
	$cards = get_stylesheet_directory() . '/library-cards.php';
	if ( is_readable( $cards ) ) {
		require_once $cards;
	}
}

require get_stylesheet_directory() . '/library-header.php';

$purchased = array();
if ( is_user_logged_in() && function_exists( 'wc_get_orders' ) && class_exists( 'WooCommerce' ) ) {
	$orders = wc_get_orders(
		array(
			'customer_id' => get_current_user_id(),
			'status'      => array( 'wc-completed', 'wc-processing', 'completed', 'processing' ),
			'limit'       => 20,
			'return'      => 'objects',
		)
	);
	if ( is_array( $orders ) ) {
		foreach ( $orders as $order ) {
			if ( ! is_object( $order ) || ! method_exists( $order, 'get_items' ) ) {
				continue;
			}
			foreach ( $order->get_items() as $item ) {
				if ( ! is_object( $item ) || ! method_exists( $item, 'get_product_id' ) ) {
					continue;
				}
				$pid = (int) $item->get_product_id();
				if ( $pid > 0 && function_exists( 'dejoiy_library_is_book_product' ) && dejoiy_library_is_book_product( $pid ) ) {
					$post = get_post( $pid );
					if ( $post instanceof WP_Post ) {
						$purchased[ $pid ] = $post;
					}
				}
			}
		}
	}
}
?>
<main class="dlu-page dlu-my-universe" id="dlu-my-universe">
	<div class="dlu-page-in">
		<p class="dlu-crumb"><a href="<?php echo esc_url( dejoiy_library_get_landing_url() ); ?>">← DEJOIY Nexus</a></p>
		<h1>My Nexus</h1>
		<p class="dlu-page-sub">Your living knowledge collection.</p>

		<section class="dlu-dash-sec">
			<h2>Continue Reading</h2>
			<div class="dlu-books-grid dlu-books-grid--compact" id="dlu-continue-reading"></div>
			<p class="dlu-empty-inline" id="dlu-continue-empty">Open any book in the reader to track progress here.</p>
		</section>

		<section class="dlu-dash-sec">
			<h2>Purchased Books</h2>
			<?php if ( empty( $purchased ) ) : ?>
				<p class="dlu-empty-inline">No purchased books yet. <a href="<?php echo esc_url( dejoiy_library_get_landing_url() ); ?>#dlu-discover">Discover titles</a>.</p>
			<?php else : ?>
				<div class="dlu-books-grid dlu-books-grid--compact">
					<?php
					foreach ( $purchased as $pid => $post ) {
						if ( function_exists( 'dejoiy_library_render_book_card' ) ) {
							echo dejoiy_library_render_book_card( $post ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
						}
					}
					?>
				</div>
			<?php endif; ?>
		</section>

		<section class="dlu-dash-sec">
			<h2>Favorites &amp; Collections</h2>
			<p class="dlu-empty-inline">Saved with ♡ — stored for DEJOIY Nexus on this device.</p>
			<div id="dlu-favorites" class="dlu-fav-grid"></div>
		</section>
	</div>
</main>
<?php
require get_stylesheet_directory() . '/library-footer.php';

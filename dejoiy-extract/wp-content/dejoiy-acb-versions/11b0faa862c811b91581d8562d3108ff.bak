/**
 * Enqueue Header OS V4 assets.
 */
function dejoiy_header_os_v4_enqueue() {
	if ( is_admin() ) {
		return;
	}

	$dir = get_stylesheet_directory();
	$uri = get_stylesheet_directory_uri();
	$css = $dir . '/dejoiy-header-os-v4.css';
	$js  = $dir . '/dejoiy-header-os-v4.js';

	if ( is_readable( $css ) ) {
		wp_enqueue_style(
			'dejoiy-header-os-v4',
			$uri . '/dejoiy-header-os-v4.css',
			array(),
			(string) filemtime( $css )
		);
	}

	if ( is_readable( $js ) ) {
		wp_enqueue_script(
			'dejoiy-header-os-v4',
			$uri . '/dejoiy-header-os-v4.js',
			array(),
			(string) filemtime( $js ),
			true
		);
		wp_localize_script( 'dejoiy-header-os-v4', 'dejoiyHeaderOsV4', dejoiy_header_os_v4_config() );
	}
}
add_action( 'wp_enqueue_scripts', 'dejoiy_header_os_v4_enqueue', 10055 );

/**
 * Body class for scoped styling.
 *
 * @param array<int, string> $classes Classes.
 * @return array<int, string>
 */
function dejoiy_header_os_v4_body_class( $classes ) {
	$classes[] = 'dejoiy-header-os-v4';
	return $classes;
}
add_filter( 'body_class', 'dejoiy_header_os_v4_body_class', 20 );

/**
 * Launcher + mobile chips markup (injected by JS into header).
 */
function dejoiy_header_os_v4_footer_templates() {
	if ( is_admin() ) {
		return;
	}
	?>
	<div id="dh-os-v4-root" hidden aria-hidden="true">
		<div class="dh-os-v4-launcher" id="dh-os-v4-launcher" role="dialog" aria-modal="true" aria-labelledby="dh-os-v4-launcher-title" hidden>
			<div class="dh-os-v4-launcher__backdrop" data-dh-close></div>
			<div class="dh-os-v4-launcher__panel">
				<header class="dh-os-v4-launcher__head">
					<h2 id="dh-os-v4-launcher-title"><?php esc_html_e( 'Explore Universe', 'dejoiy' ); ?></h2>
					<p><?php esc_html_e( 'One platform. Many worlds.', 'dejoiy' ); ?></p>
					<button type="button" class="dh-os-v4-launcher__close" data-dh-close aria-label="<?php esc_attr_e( 'Close', 'dejoiy' ); ?>">&times;</button>
				</header>
				<div class="dh-os-v4-launcher__grid" id="dh-os-v4-launcher-grid"></div>
			</div>
		</div>
		<template id="dh-os-v4-universe-nav-tpl">
			<nav class="dh-os-v4-universe" aria-label="<?php esc_attr_e( 'DEJOIY Universe', 'dejoiy' ); ?>">
				<div class="dh-os-v4-universe__inner" id="dh-os-v4-universe-inner"></div>
				<button type="button" class="dh-os-v4-explore" id="dh-os-v4-explore-btn">
					<span class="dh-os-v4-explore__icon" aria-hidden="true">&#9670;</span>
					<span><?php esc_html_e( 'Explore Universe', 'dejoiy' ); ?></span>
				</button>
			</nav>
		</template>
		<template id="dh-os-v4-mobile-chips-tpl">
			<div class="dh-os-v4-mobile-chips" id="dh-os-v4-mobile-chips" aria-label="<?php esc_attr_e( 'Quick worlds', 'dejoiy' ); ?>"></div>
		</template>
	</div>
	<?php
}
add_action( 'wp_footer', 'dejoiy_header_os_v4_footer_templates', 5 );

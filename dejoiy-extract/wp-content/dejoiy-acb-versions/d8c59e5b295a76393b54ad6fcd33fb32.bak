/**
 * @param string $cat_key Category key from svc_cat.
 * @return array<int, string>
 */
function dejoiy_services_terms_for_category( $cat_key ) {
	foreach ( dejoiy_services_category_cards() as $card ) {
		if ( $card['key'] === $cat_key ) {
			return $card['terms'];
		}
	}
	return array();
}

/**
 * @param string $cat_key Optional filter.
 * @return string
 */
function dejoiy_services_listing_url( $cat_key = '' ) {
	$args = array();
	if ( $cat_key ) {
		$args['svc_cat'] = $cat_key;
	}
	return add_query_arg( $args, dejoiy_services_base_url() . '#dsv-services' );
}


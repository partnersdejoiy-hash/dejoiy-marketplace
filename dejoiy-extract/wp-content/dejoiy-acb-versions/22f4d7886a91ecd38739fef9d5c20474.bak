<?php
/**
 * DEJOIY Library Universe — dedicated header.
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

$dlu_home    = function_exists( 'dejoiy_library_get_landing_url' ) ? dejoiy_library_get_landing_url() : home_url( '/dejoiy-library/' );
$dlu_cart    = function_exists( 'dejoiy_library_get_cart_url' ) ? dejoiy_library_get_cart_url() : home_url( '/cart/?dejoiy_library=1' );
$dlu_my      = function_exists( 'dejoiy_library_my_universe_url' ) ? dejoiy_library_my_universe_url() : $dlu_home;
$dlu_count   = 0;
if ( function_exists( 'WC' ) && WC()->cart ) {
	foreach ( WC()->cart->get_cart() as $item ) {
		if ( function_exists( 'dejoiy_library_cart_item_is_book' ) && dejoiy_library_cart_item_is_book( $item ) ) {
			$dlu_count += (int) $item['quantity'];
		}
	}
}
?>
<header class="dlu-hdr" id="dlu-hdr">
	<div class="dlu-hdr-in">
		<a class="dlu-brand" href="<?php echo esc_url( $dlu_home ); ?>">
			<span class="dlu-brand-icon" aria-hidden="true">
				<svg viewBox="0 0 32 32" width="28" height="28"><path fill="currentColor" d="M6 4h8l2 24H8L6 4zm10 0h8l2 24h-8l-2-24zM4 8h24v3H4V8zm0 6h24v3H4v-3z"/></svg>
			</span>
			<span class="dlu-brand-text">DEJOIY <em>Library</em></span>
		</a>

		<nav class="dlu-nav" aria-label="Library navigation">
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-discover">Discover</a>
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-categories">Categories</a>
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-collections">Collections</a>
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-bestsellers">Best Sellers</a>
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-free">Free Books</a>
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-joi">AI Picks</a>
			<a href="<?php echo esc_url( $dlu_my ); ?>">My Library</a>
		</nav>

		<div class="dlu-hdr-actions">
			<form class="dlu-hdr-search" action="<?php echo esc_url( $dlu_home ); ?>" method="get" role="search" id="dlu-hdr-search">
				<input type="search" name="dlu_q" placeholder="Search the universe…" aria-label="Search library" autocomplete="off" />
				<button type="submit" class="dlu-search-submit" aria-label="Search">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				</button>
			</form>
			<button type="button" class="dlu-icon-btn" aria-label="Notifications" title="Notifications">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
			</button>
			<button type="button" class="dlu-icon-btn" aria-label="Wishlist" title="Wishlist">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
			</button>
			<button type="button" class="dlu-cart-btn" id="dlu-cart-toggle" aria-label="Library cart" data-count="<?php echo esc_attr( (string) $dlu_count ); ?>">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
				<span class="dlu-cart-badge" <?php echo $dlu_count < 1 ? 'hidden' : ''; ?>><?php echo esc_html( (string) $dlu_count ); ?></span>
			</button>
			<a href="<?php echo esc_url( function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'myaccount' ) : wp_login_url() ); ?>" class="dlu-icon-btn" aria-label="Profile">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
			</a>
			<a href="<?php echo esc_url( $dlu_home ); ?>#dlu-pass" class="dlu-btn-pass">Library Pass</a>
			<button type="button" class="dlu-burger" id="dlu-burger" aria-label="Menu"><span></span><span></span><span></span></button>
		</div>
	</div>
</header>

<aside class="dlu-cart-panel" id="dlu-cart-panel" hidden aria-label="Library cart">
	<div class="dlu-cart-panel-head">
		<h2>Library Cart</h2>
		<button type="button" class="dlu-cart-close" id="dlu-cart-close" aria-label="Close">&times;</button>
	</div>
	<div class="dlu-cart-panel-body" id="dlu-cart-body">
		<p class="dlu-cart-empty">Your shelf is empty. Discover a book to begin your collection.</p>
	</div>
	<div class="dlu-cart-panel-foot">
		<a href="<?php echo esc_url( $dlu_cart ); ?>" class="dlu-btn-primary">View collection shelf</a>
	</div>
</aside>
<div class="dlu-cart-backdrop" id="dlu-cart-backdrop" hidden></div>

<?php
/**
 * Restore Elementor site header & footer on DEJOIY Universe home.
 *
 * Wraps Universe markup with Theme Builder templates via the_content (no output buffering).
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

function dejoiy_site_chrome_should_restore() {
	if ( is_admin() && ! wp_doing_ajax() ) {
		return false;
	}
	if ( ! is_front_page() ) {
		return false;
	}
	if ( function_exists( 'dejoiy_universe_home_is_active' ) && ! dejoiy_universe_home_is_active() ) {
		return false;
	}
	return true;
}

function dejoiy_site_chrome_template_ids( $location ) {
	$defaults = array(
		'header' => array( 4228 ),
		'footer' => array( 4225 ),
	);
	$ids      = isset( $defaults[ $location ] ) ? $defaults[ $location ] : array();
	return array_filter( array_map( 'intval', (array) apply_filters( 'dejoiy_site_chrome_elementor_template_ids', $ids, $location ) ) );
}

function dejoiy_site_chrome_elementor_html( $location ) {
	if ( ! class_exists( '\Elementor\Plugin' ) ) {
		return '';
	}
	$frontend = \Elementor\Plugin::$instance->frontend;
	$html     = '';
	foreach ( dejoiy_site_chrome_template_ids( $location ) as $template_id ) {
		if ( $template_id <= 0 || 'publish' !== get_post_status( $template_id ) ) {
			continue;
		}
		$chunk = $frontend->get_builder_content_for_display( $template_id, true );
		if ( ( ! is_string( $chunk ) || strlen( trim( $chunk ) ) < 1 ) && shortcode_exists( 'elementor-template' ) ) {
			$chunk = do_shortcode( '[elementor-template id="' . $template_id . '"]' );
		}
		if ( is_string( $chunk ) && strlen( trim( $chunk ) ) > 0 ) {
			$html .= $chunk;
		}
	}
	return $html;
}

/**
 * Wrap Universe HTML with Elementor header + footer.
 *
 * @param string $content Post content.
 * @return string
 */
function dejoiy_site_chrome_wrap_universe_content( $content ) {
	if ( ! dejoiy_site_chrome_should_restore() ) {
		return $content;
	}
	if ( false === strpos( $content, 'id="dejoiy-universe"' ) ) {
		return $content;
	}

	static $wrapped = false;
	if ( $wrapped ) {
		return $content;
	}
	$wrapped = true;

	$header = dejoiy_site_chrome_elementor_html( 'header' );
	$footer = dejoiy_site_chrome_elementor_html( 'footer' );
	$out    = '';

	if ( strlen( trim( wp_strip_all_tags( $header ) ) ) > 40 ) {
		$out .= '<div class="dejoiy-site-chrome-header">' . $header . '</div>';
	}
	$out .= $content;
	if ( strlen( trim( wp_strip_all_tags( $footer ) ) ) > 40 ) {
		$out .= '<div class="et-footers-wrapper dejoiy-site-chrome-footer">' . $footer . '</div>';
	}

	return $out;
}
add_filter( 'the_content', 'dejoiy_site_chrome_wrap_universe_content', 10000 );
add_filter( 'elementor/frontend/the_content', 'dejoiy_site_chrome_wrap_universe_content', 10000 );

function dejoiy_site_chrome_body_class( $classes ) {
	if ( dejoiy_site_chrome_should_restore() ) {
		$classes[] = 'dejoiy-site-chrome-on';
	}
	return $classes;
}
add_filter( 'body_class', 'dejoiy_site_chrome_body_class', 25 );

/**
 * @param string $eco Ecosystem slug.
 * @param int    $limit Max products.
 * @return array<int, WP_Post>
 */
function dejoiy_mobile_home_sample_products( $eco, $limit = 3 ) {
	if ( ! function_exists( 'dejoiy_universe_get_products' ) ) {
		return array();
	}
	$args = array( 'posts_per_page' => $limit, 'orderby' => 'rand' );
	if ( 'market' === $eco || 'marketplace' === $eco ) {
		$args['meta_query'] = array(
			'relation' => 'OR',
			array(
				'key'     => '_dejoiy_ecosystem',
				'compare' => 'NOT EXISTS',
			),
			array(
				'key'     => '_dejoiy_ecosystem',
				'value'   => array( 'studio', 'nexus' ),
				'compare' => 'NOT IN',
			),
		);
	} else {
		$args['meta_query'] = array(
			array(
				'key'     => '_dejoiy_ecosystem',
				'value'   => sanitize_key( $eco ),
				'compare' => '=',
			),
		);
	}
	return dejoiy_universe_get_products( $args );
}

/**
 * @return array<int, int>
 */
function dejoiy_mobile_home_recently_viewed_ids() {
	$raw = isset( $_COOKIE['woocommerce_recently_viewed'] ) ? wp_unslash( $_COOKIE['woocommerce_recently_viewed'] ) : ''; // phpcs:ignore
	if ( ! $raw ) {
		return array();
	}
	$ids = array_filter( array_map( 'absint', explode( '|', $raw ) ) );
	return array_slice( array_values( $ids ), 0, 12 );
}

/**
 * Render mobile product card.
 *
 * @param int    $product_id Product ID.
 * @param string $world      World slug.
 */
function dejoiy_mobile_home_render_card( $product_id, $world = 'market' ) {
	if ( ! function_exists( 'wc_get_product' ) ) {
		return;
	}
	$product = wc_get_product( $product_id );
	if ( ! $product ) {
		return;
	}

	$url = function_exists( 'dejoiy_ecosystem_product_url' )
		? dejoiy_ecosystem_product_url( $product_id )
		: get_permalink( $product_id );

	$cover = '';
	$fb    = '';
	if ( function_exists( 'dejoiy_universe_product_cover_urls' ) ) {
		$covers = dejoiy_universe_product_cover_urls( $product_id );
		$cover  = $covers['src'];
		$fb     = $covers['fallback'];
	} else {
		$cover = get_the_post_thumbnail_url( $product_id, 'woocommerce_thumbnail' );
	}

	$badge  = function_exists( 'dejoiy_universe_eco_badge' ) ? dejoiy_universe_eco_badge( $product_id ) : '';
	$dpin   = function_exists( 'dejoiy_get_product_dpin' ) ? dejoiy_get_product_dpin( $product_id ) : '';
	$seller = function_exists( 'dejoiy_universe_seller_label' ) ? dejoiy_universe_seller_label( $product_id ) : __( 'Verified seller', 'dejoiy' );
	?>
	<article class="dm-card dm-card--<?php echo esc_attr( $world ); ?>" data-product-id="<?php echo esc_attr( (string) $product_id ); ?>">
		<button type="button" class="dm-card__fav" aria-label="<?php esc_attr_e( 'Add to favorites', 'dejoiy' ); ?>" data-fav-id="<?php echo esc_attr( (string) $product_id ); ?>">♡</button>
		<a class="dm-card__link" href="<?php echo esc_url( $url ); ?>">
			<div class="dm-card__media">
				<?php if ( $cover ) : ?>
					<img src="<?php echo esc_url( $cover ); ?>" alt="" loading="lazy" decoding="async"<?php echo $fb ? ' data-fallback="' . esc_url( $fb ) . '" onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;}"' : ''; ?> />
				<?php else : ?>
					<span class="dm-card__ph" aria-hidden="true"></span>
				<?php endif; ?>
				<?php if ( $badge ) : ?>
					<span class="dm-card__eco"><?php echo esc_html( $badge ); ?></span>
				<?php endif; ?>
			</div>
			<div class="dm-card__body">
				<?php if ( $dpin ) : ?>
					<span class="dm-card__dpin"><?php echo esc_html( $dpin ); ?></span>
				<?php endif; ?>
				<h3 class="dm-card__title"><?php echo esc_html( $product->get_name() ); ?></h3>
				<span class="dm-card__price"><?php echo wp_kses_post( $product->get_price_html() ); ?></span>
				<span class="dm-card__seller"><span class="dm-card__dot" aria-hidden="true"></span><?php echo esc_html( $seller ); ?></span>
			</div>
		</a>
	</article>
	<?php
}

/**
 * @param string               $title Shelf title.
 * @param array<string, mixed> $query_args WP_Query args.
 * @param string               $world World slug.
 */
function dejoiy_mobile_home_render_shelf( $title, $query_args, $world = 'market' ) {
	if ( ! function_exists( 'dejoiy_universe_get_products' ) ) {
		return;
	}
	$query_args['posts_per_page'] = isset( $query_args['posts_per_page'] ) ? $query_args['posts_per_page'] : 8;
	$posts = dejoiy_universe_get_products( $query_args );
	if ( empty( $posts ) ) {
		return;
	}
	?>
	<section class="dm-shelf dm-reveal">
		<h2 class="dm-shelf__title"><?php echo esc_html( $title ); ?></h2>
		<div class="dm-shelf__track" tabindex="0">
			<?php
			foreach ( $posts as $p ) {
				dejoiy_mobile_home_render_card( $p->ID, $world );
			}
			?>
		</div>
	</section>
	<?php
}


/**
 * Combined personal product IDs (DEJOIY viewed cookie + WooCommerce recently viewed).
 *
 * @return array<int, int>
 */
function dejoiy_mobile_home_personal_product_ids() {
	$ids = dejoiy_mobile_home_recently_viewed_ids();
	if ( function_exists( 'dejoiy_home_get_viewed_ids' ) ) {
		$ids = array_merge( $ids, dejoiy_home_get_viewed_ids() );
	}
	$ids = array_map( 'absint', $ids );
	$ids = array_filter( $ids );
	return array_values( array_unique( $ids ) );
}

/**
 * Query args: recommendations based on last viewed categories.
 *
 * @return array<string, mixed>
 */
function dejoiy_mobile_home_smart_pick_args() {
	$exclude = dejoiy_mobile_home_personal_product_ids();
	$args    = array(
		'posts_per_page' => 8,
		'orderby'        => 'rand',
	);
	if ( $exclude ) {
		$args['post__not_in'] = $exclude;
		$terms = wp_get_object_terms( $exclude[0], 'product_cat', array( 'fields' => 'slugs' ) );
		if ( ! is_wp_error( $terms ) && ! empty( $terms ) ) {
			$args['tax_query'] = array(
				array(
					'taxonomy' => 'product_cat',
					'field'    => 'slug',
					'terms'    => array_slice( $terms, 0, 3 ),
				),
			);
		}
	}
	return $args;
}

/**
 * Horizontal promo chips below categories.
 */
function dejoiy_mobile_home_render_promos() {
	$shop = function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'shop' ) : home_url( '/shop/' );
	$promos = array(
		array( 'label' => __( 'Joy Deals', 'dejoiy' ), 'url' => add_query_arg( 'on_sale', '1', $shop ), 'style' => 'gold' ),
		array( 'label' => __( 'Free Delivery', 'dejoiy' ), 'url' => $shop, 'style' => 'blue' ),
		array( 'label' => __( 'Top Rated', 'dejoiy' ), 'url' => add_query_arg( 'orderby', 'rating', $shop ), 'style' => 'violet' ),
		array( 'label' => __( 'New Arrivals', 'dejoiy' ), 'url' => add_query_arg( 'orderby', 'date', $shop ), 'style' => 'green' ),
	);
	?>
	<section class="dm-promos dm-reveal" aria-label="<?php esc_attr_e( 'Highlights', 'dejoiy' ); ?>">
		<div class="dm-promos__track">
			<?php foreach ( $promos as $promo ) : ?>
				<a class="dm-promo dm-promo--<?php echo esc_attr( $promo['style'] ); ?>" href="<?php echo esc_url( $promo['url'] ); ?>"><?php echo esc_html( $promo['label'] ); ?></a>
			<?php endforeach; ?>
		</div>
	</section>
	<?php
}

/**
 * Intelligence-driven shelves (view history + smart picks).
 */
function dejoiy_mobile_home_render_intelligence_shelves() {
	$personal = dejoiy_mobile_home_personal_product_ids();
	if ( ! empty( $personal ) ) {
		dejoiy_mobile_home_render_shelf(
			__( 'Because You Viewed', 'dejoiy' ),
			array(
				'post__in'       => array_slice( $personal, 0, 12 ),
				'orderby'        => 'post__in',
				'posts_per_page' => 8,
			),
			'market'
		);

		dejoiy_mobile_home_render_shelf(
			__( 'More Picks For You', 'dejoiy' ),
			dejoiy_mobile_home_smart_pick_args(),
			'market'
		);
	}

	$loc = function_exists( 'dejoiy_mobile_os_delivery_label' ) ? dejoiy_mobile_os_delivery_label() : '';
	if ( $loc && __( 'Set delivery location', 'dejoiy' ) !== $loc ) {
		dejoiy_mobile_home_render_shelf(
			sprintf(
				/* translators: %s: city or region */
				__( 'Trending near %s', 'dejoiy' ),
				$loc
			),
			array(
				'meta_key'       => 'total_sales',
				'orderby'        => 'meta_value_num',
				'order'          => 'DESC',
				'posts_per_page' => 8,
			),
			'market'
		);
	}

	dejoiy_mobile_home_render_shelf(
		__( 'Top Deals Today', 'dejoiy' ),
		array(
			'posts_per_page' => 8,
			'meta_query'     => array(
				array(
					'key'     => '_sale_price',
					'value'   => '',
					'compare' => '!=',
				),
			),
		),
		'market'
	);
}


/**
 * Large hero deal banners (Amazon / Flipkart style).
 */
function dejoiy_mobile_home_render_hero_banners() {
	$shop = function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'shop' ) : home_url( '/shop/' );
	$slides = array(
		array(
			'title' => __( 'Joy Deals', 'dejoiy' ),
			'sub'   => __( 'Up to 40% off today', 'dejoiy' ),
			'url'   => add_query_arg( 'on_sale', '1', $shop ),
			'color' => '#1d4ed8',
			'tag'   => __( 'HOT', 'dejoiy' ),
		),
		array(
			'title' => __( 'Free Delivery', 'dejoiy' ),
			'sub'   => __( 'On eligible orders', 'dejoiy' ),
			'url'   => $shop,
			'color' => '#7c3aed',
			'tag'   => __( 'NEW', 'dejoiy' ),
		),
		array(
			'title' => __( 'Custom Studio', 'dejoiy' ),
			'sub'   => __( 'Design your product', 'dejoiy' ),
			'url'   => home_url( '/dejoiy-custom-studio/' ),
			'color' => '#db2777',
			'tag'   => '✿',
		),
		array(
			'title' => __( 'Nexus Books', 'dejoiy' ),
			'sub'   => __( 'Learn something new', 'dejoiy' ),
			'url'   => home_url( '/dejoiy-library/?dejoiy_library=1' ),
			'color' => '#0d9488',
			'tag'   => '✦',
		),
	);

	$featured = array();
	if ( function_exists( 'dejoiy_universe_get_products' ) ) {
		$featured = dejoiy_universe_get_products(
			array(
				'posts_per_page' => 3,
				'meta_key'       => 'total_sales',
				'orderby'        => 'meta_value_num',
				'order'          => 'DESC',
			)
		);
	}
	?>
	<section class="dm-hero-banners dm-reveal" aria-label="<?php esc_attr_e( 'Featured offers', 'dejoiy' ); ?>">
		<div class="dm-hero-banners__track" id="dm-hero-banners">
			<?php
			$idx = 0;
			foreach ( $slides as $slide ) :
				$bg_img = '';
				if ( isset( $featured[ $idx ] ) ) {
					$pid = $featured[ $idx ]->ID;
					$bg_img = get_the_post_thumbnail_url( $pid, 'medium_large' );
					if ( ! $bg_img && function_exists( 'dejoiy_universe_product_cover_urls' ) ) {
						$c      = dejoiy_universe_product_cover_urls( $pid );
						$bg_img = $c['src'];
					}
				}
				$idx++;
				$style = '--dm-slide:' . esc_attr( $slide['color'] ) . ';';
				if ( $bg_img ) {
					$style .= 'background-image:linear-gradient(120deg, color-mix(in srgb, ' . esc_attr( $slide['color'] ) . ' 88%, #000) 0%, color-mix(in srgb, ' . esc_attr( $slide['color'] ) . ' 55%, transparent) 55%), url(' . esc_url( $bg_img ) . ');';
				}
				?>
				<a class="dm-hero-banner" href="<?php echo esc_url( $slide['url'] ); ?>" style="<?php echo esc_attr( $style ); ?>">
					<span class="dm-hero-banner__tag"><?php echo esc_html( $slide['tag'] ); ?></span>
					<strong><?php echo esc_html( $slide['title'] ); ?></strong>
					<span><?php echo esc_html( $slide['sub'] ); ?></span>
				</a>
			<?php endforeach; ?>
		</div>
	</section>
	<?php
}

/**
 * Quick deals grid with product images.
 */
function dejoiy_mobile_home_render_deals_grid() {
	if ( ! function_exists( 'dejoiy_universe_get_products' ) ) {
		return;
	}
	$posts = dejoiy_universe_get_products(
		array(
			'posts_per_page' => 4,
			'meta_query'     => array(
				array(
					'key'     => '_sale_price',
					'value'   => '',
					'compare' => '!=',
				),
			),
		)
	);
	if ( empty( $posts ) ) {
		$posts = dejoiy_universe_get_products( array( 'posts_per_page' => 4, 'orderby' => 'rand' ) );
	}
	if ( empty( $posts ) ) {
		return;
	}
	?>
	<section class="dm-deals dm-reveal">
		<h2 class="dm-deals__title"><?php esc_html_e( 'Deals of the Day', 'dejoiy' ); ?></h2>
		<div class="dm-deals__grid">
			<?php foreach ( $posts as $p ) :
				$product = wc_get_product( $p->ID );
				if ( ! $product ) {
					continue;
				}
				$url   = function_exists( 'dejoiy_ecosystem_product_url' ) ? dejoiy_ecosystem_product_url( $p->ID ) : get_permalink( $p->ID );
				$cover = get_the_post_thumbnail_url( $p->ID, 'woocommerce_thumbnail' );
				?>
				<a class="dm-deals__card" href="<?php echo esc_url( $url ); ?>">
					<div class="dm-deals__media">
						<?php if ( $cover ) : ?>
							<img src="<?php echo esc_url( $cover ); ?>" alt="" loading="lazy" />
						<?php endif; ?>
						<span class="dm-deals__off"><?php esc_html_e( 'Deal', 'dejoiy' ); ?></span>
					</div>
					<span class="dm-deals__name"><?php echo esc_html( wp_trim_words( $product->get_name(), 4, '…' ) ); ?></span>
					<span class="dm-deals__price"><?php echo wp_kses_post( $product->get_price_html() ); ?></span>
				</a>
			<?php endforeach; ?>
		</div>
	</section>
	<?php
}

/**
 * Explore universe section with banners + dedicated pages.
 */
function dejoiy_mobile_home_render_explore() {
	?>
	<section class="dm-explore dm-reveal" aria-label="<?php esc_attr_e( 'Explore DEJOIY Universe', 'dejoiy' ); ?>">
		<h2 class="dm-explore__title"><?php esc_html_e( 'Explore Universe', 'dejoiy' ); ?></h2>
		<div class="dm-explore__banners" id="dm-universe-carousel">
			<?php
			foreach ( dejoiy_mobile_home_v2_explore_banners() as $banner ) :
				$samples = dejoiy_mobile_home_sample_products( (string) $banner['eco'], 3 );
				?>
				<a class="dm-explore-banner" href="<?php echo esc_url( $banner['url'] ); ?>" style="--dm-banner:<?php echo esc_attr( $banner['color'] ); ?>">
					<div class="dm-explore-banner__top">
						<span class="dm-explore-banner__icon" aria-hidden="true"><?php echo esc_html( $banner['icon'] ); ?></span>
						<div class="dm-explore-banner__copy">
							<strong><?php echo esc_html( $banner['label'] ); ?></strong>
							<span><?php echo esc_html( $banner['desc'] ); ?></span>
						</div>
						<span class="dm-explore-banner__go" aria-hidden="true">→</span>
					</div>
					<?php if ( ! empty( $samples ) ) : ?>
						<div class="dm-explore-banner__thumbs">
							<?php
							foreach ( $samples as $p ) :
								$thumb = get_the_post_thumbnail_url( $p->ID, 'woocommerce_thumbnail' );
								if ( ! $thumb && function_exists( 'dejoiy_universe_product_cover_urls' ) ) {
									$c     = dejoiy_universe_product_cover_urls( $p->ID );
									$thumb = $c['src'];
								}
								if ( $thumb ) :
									?>
									<img src="<?php echo esc_url( $thumb ); ?>" alt="" loading="lazy" decoding="async" />
								<?php endif; endforeach; ?>
						</div>
					<?php endif; ?>
				</a>
			<?php endforeach; ?>
		</div>
		<div class="dm-eco-grid">
			<?php foreach ( dejoiy_mobile_home_v2_eco_pages() as $page ) : ?>
				<a class="dm-eco-grid__card" href="<?php echo esc_url( $page['url'] ); ?>" style="--dm-accent:<?php echo esc_attr( $page['color'] ); ?>">
					<span class="dm-eco-grid__ico" aria-hidden="true"><?php echo esc_html( $page['icon'] ); ?></span>
					<span class="dm-eco-grid__label"><?php echo esc_html( $page['label'] ); ?></span>
				</a>
			<?php endforeach; ?>
		</div>
	</section>
	<?php
}

/**
 * Mobile homepage body only (header/footer from Mobile OS).
 *
 * @return string
 */
function dejoiy_mobile_home_v2_html() {
	if ( ! class_exists( 'WooCommerce' ) ) {
		return '';
	}

	ob_start();
	?>
	<div id="dejoiy-mobile-home" class="dejoiy-mobile-home-v2" data-version="2.4">
		<div class="dm-sheet">
			<?php
			dejoiy_mobile_home_render_hero_banners();
			dejoiy_mobile_home_render_deals_grid();
			dejoiy_mobile_home_render_explore();
			?>
			<?php dejoiy_mobile_home_render_promos(); ?>

			<main class="dm-main" id="dm-main">
				<?php
				dejoiy_mobile_home_render_intelligence_shelves();

				dejoiy_mobile_home_render_shelf(
					__( 'Custom Studio Picks', 'dejoiy' ),
					array(
						'posts_per_page' => 8,
						'meta_query'     => array(
							array(
								'key'     => '_dejoiy_ecosystem',
								'value'   => 'studio',
								'compare' => '=',
							),
						),
					),
					'studio'
				);

				dejoiy_mobile_home_render_shelf(
					__( 'Marketplace — Recommended', 'dejoiy' ),
					array(
						'orderby'        => 'rand',
						'posts_per_page' => 8,
						'meta_query'     => array(
							'relation' => 'OR',
							array(
								'key'     => '_dejoiy_ecosystem',
								'compare' => 'NOT EXISTS',
							),
							array(
								'key'     => '_dejoiy_ecosystem',
								'value'   => 'studio',
								'compare' => '!=',
							),
						),
					),
					'market'
				);

				dejoiy_mobile_home_render_shelf(
					__( 'Trending Today', 'dejoiy' ),
					array(
						'meta_key'       => 'total_sales',
						'orderby'        => 'meta_value_num',
						'order'          => 'DESC',
						'posts_per_page' => 8,
					),
					'market'
				);

				dejoiy_mobile_home_render_shelf(
					__( 'JOI Picks', 'dejoiy' ),
					array( 'orderby' => 'date', 'order' => 'DESC', 'posts_per_page' => 8 ),
					'market'
				);

				dejoiy_mobile_home_render_shelf(
					__( 'Most Loved', 'dejoiy' ),
					array( 'orderby' => 'comment_count', 'order' => 'DESC', 'posts_per_page' => 8 ),
					'market'
				);
				?>
			</main>
		</div>
	</div>
	<?php
	return (string) ob_get_clean();
}

/**
 * Replace front page content once (prevents duplicate headers / blocks).
 *
 * @param string $content Post content.
 * @return string
 */
function dejoiy_mobile_home_v2_replace_content( $content ) {
	if ( ! dejoiy_mobile_home_v2_active() ) {
		return $content;
	}

	static $done = false;
	if ( $done ) {
		return $content;
	}
	if ( false !== strpos( $content, 'id="dejoiy-mobile-home"' ) ) {
		$done = true;
		return $content;
	}
	$done = true;

	$desktop = $content;
	if ( false === strpos( $desktop, 'dejoiy-universe' ) && function_exists( 'dejoiy_universe_home_html' ) ) {
		$desktop = dejoiy_universe_home_html();
	}

	return '<div class="dejoiy-universe-desktop-only">' . $desktop . '</div>' . dejoiy_mobile_home_v2_html();
}
add_filter( 'the_content', 'dejoiy_mobile_home_v2_replace_content', 10000 );

/**
 * @param array<int, string> $classes Body classes.
 * @return array<int, string>
 */
function dejoiy_mobile_home_v2_body_class( $classes ) {
	if ( dejoiy_mobile_home_v2_active() ) {
		$classes[] = 'dejoiy-mobile-home-v2-active';
	}
	return $classes;
}
add_filter( 'body_class', 'dejoiy_mobile_home_v2_body_class', 25 );

/**
 * Enqueue mobile home assets (screen-scoped).
 */
function dejoiy_mobile_home_v2_assets() {
	if ( ! dejoiy_mobile_home_v2_active() ) {
		return;
	}
	$uri = get_stylesheet_directory_uri();
	$dir = get_stylesheet_directory();
	$css = $dir . '/dejoiy-mobile-home-v2.css';
	$js  = $dir . '/dejoiy-mobile-home-v2.js';
	if ( is_readable( $css ) ) {
		wp_enqueue_style(
			'dejoiy-mobile-home-v2',
			$uri . '/dejoiy-mobile-home-v2.css',
			array( 'dejoiy-mobile-os' ),
			(string) filemtime( $css ),
			'screen and (max-width: 1024px)'
		);
	}
	if ( is_readable( $js ) ) {
		wp_enqueue_script(
			'dejoiy-mobile-home-v2',
			$uri . '/dejoiy-mobile-home-v2.js',
			array(),
			(string) filemtime( $js ),
			true
		);
	}
}
add_action( 'wp_enqueue_scripts', 'dejoiy_mobile_home_v2_assets', 1009 );

/**
 * Scope desktop universe CSS to large screens only.
 */
function dejoiy_mobile_home_v2_scope_desktop_assets() {
	if ( ! dejoiy_mobile_home_v2_active() ) {
		return;
	}
	global $wp_styles;
	if ( ! $wp_styles ) {
		return;
	}
	foreach ( array( 'dejoiy-universe-home', 'dejoiy-universe-responsive' ) as $handle ) {
		if ( isset( $wp_styles->registered[ $handle ] ) ) {
			$wp_styles->registered[ $handle ]->args = 'screen and (min-width: 1025px)';
		}
	}
}
add_action( 'wp_enqueue_scripts', 'dejoiy_mobile_home_v2_scope_desktop_assets', 1010 );

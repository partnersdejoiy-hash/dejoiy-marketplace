/**
 * DEJOIY Desktop Marketplace Header (dmh) — laptop/desktop ≥1025px only.
 * Row 1: light gradient utility bar · Row 2: dark #0F172A category nav · Hero stays light.
 */

#dejoiy-marketplace-header {
	display: none !important;
	visibility: hidden !important;
}

@media (min-width: 1025px) {
	:root {
		--dmh-accent: #06b6d4;
		--dmh-accent-dim: #0891b2;
		--dmh-accent-glow: rgba(6, 182, 212, 0.28);
		--dmh-bg: linear-gradient(135deg, #f8fafc 0%, #eef2ff 50%, #e0e7ff 100%);
		--dmh-glass: linear-gradient(
			135deg,
			rgba(248, 250, 252, 0.94) 0%,
			rgba(238, 242, 255, 0.9) 50%,
			rgba(224, 231, 255, 0.88) 100%
		);
		--dmh-ink: #0f172a;
		--dmh-ink-2: #1e293b;
		--dmh-muted: #64748b;
		--dmh-border: rgba(15, 23, 42, 0.1);
		--dmh-border-strong: rgba(15, 23, 42, 0.14);
		--dmh-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
		--dmh-shadow-scrolled: 0 12px 40px rgba(15, 23, 42, 0.12);
		--dmh-radius: 14px;
		--dmh-radius-lg: 16px;
		--dmh-ease: 300ms cubic-bezier(0.4, 0, 0.2, 1);
		--dmh-top-h: 68px;
		--dmh-sub-h: 44px;
		--dmh-nav-dark: #0f172a;
		--dmh-nav-dark-border: rgba(255, 255, 255, 0.08);
		--dmh-nav-bg: linear-gradient(90deg, #0b1220 0%, #111827 25%, #1e1b4b 65%, #312e81 100%);
		--dmh-brand-blue: #3b82f6;
		--dmh-brand-indigo: #6366f1;
		--dmh-pink: #ec4899;
	}

	body.dejoiy-dmh-standalone .elementor-location-header,
	body.dejoiy-dmh-standalone header.elementor-4228,
	body.dejoiy-dmh-standalone .etheme-elementor-header-sticky,
	body.dejoiy-dmh-standalone .page-wrapper > header.elementor-location-header,
	body.dejoiy-dmh-standalone .page-wrapper > .elementor-location-header,
	body.dejoiy-dmh-standalone .header-wrapper,
	body.dejoiy-dmh-standalone .mobile-header-wrapper,
	body.dejoiy-dmh-standalone #dejoiy-mobile-os-header {
		display: none !important;
	}

	body.dejoiy-dmh-standalone #dejoiy-marketplace-header {
		display: block !important;
		visibility: visible !important;
	}

	.dmh {
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		color: var(--dmh-ink);
		position: relative;
		z-index: 300;
		isolation: isolate;
	}

	.dmh__sticky {
		position: sticky;
		top: 0;
		z-index: 310;
		background: transparent;
		border-bottom: none;
		box-shadow: 0 8px 30px rgba(15, 23, 42, 0.1);
		transition: box-shadow var(--dmh-ease);
	}

	.dmh__sticky.is-scrolled {
		box-shadow: 0 12px 40px rgba(15, 23, 42, 0.16);
	}

	.dmh__top {
		background: var(--dmh-bg);
		background-image: var(--dmh-bg);
		backdrop-filter: blur(14px) saturate(1.2);
		-webkit-backdrop-filter: blur(14px) saturate(1.2);
		border-bottom: 1px solid rgba(15, 23, 42, 0.08);
	}

	.dmh__inner {
		max-width: var(--dmh-max);
		margin: 0 auto;
		min-height: var(--dmh-top-h);
		padding: 0.65rem 1.5rem;
		display: grid;
		grid-template-columns: minmax(160px, 240px) auto minmax(320px, 1fr) auto auto auto auto;
		align-items: center;
		gap: 0.75rem 1.1rem;
	}

	/* Logo — premium glass capsule, ~70% larger for brand visibility */
	.dmh__logo-wrap {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.4rem 0.65rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.42);
		backdrop-filter: blur(10px) saturate(1.15);
		-webkit-backdrop-filter: blur(10px) saturate(1.15);
		border: 1px solid rgba(255, 255, 255, 0.65);
		box-shadow: 0 2px 12px rgba(15, 23, 42, 0.07);
		transition: box-shadow var(--dmh-ease), background var(--dmh-ease);
	}

	.dmh__logo-wrap:hover {
		background: rgba(255, 255, 255, 0.58);
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.09);
	}

	.dmh-logo {
		display: inline-flex;
		align-items: center;
		max-width: 240px;
		text-decoration: none;
		color: var(--dmh-ink);
		line-height: 0;
		transition: transform var(--dmh-ease), opacity var(--dmh-ease);
	}

	.dmh-logo:hover {
		transform: translateY(-1px);
		opacity: 0.94;
	}

	.dmh-logo img,
	.dmh-logo__img,
	.dmh-logo .custom-logo {
		max-height: 82px !important;
		max-width: 240px !important;
		width: auto !important;
		height: auto !important;
		display: block;
		object-fit: contain;
	}

	.dmh-logo--text {
		gap: 0.55rem;
		line-height: 1;
	}

	.dmh-logo--text .dmh-logo__mark {
		width: 56px;
		height: 56px;
		border-radius: 12px;
		background: linear-gradient(135deg, var(--dmh-accent), #7c3aed);
		color: #fff;
		font-weight: 800;
		display: grid;
		place-items: center;
		font-size: 1.35rem;
		box-shadow: 0 4px 14px var(--dmh-accent-glow);
	}

	.dmh-logo__word {
		font-weight: 800;
		font-size: 1.35rem;
		letter-spacing: 0.05em;
		color: var(--dmh-ink);
	}

	/* Location */
	.dmh-loc {
		display: flex;
		align-items: flex-start;
		gap: 0.35rem;
		padding: 0.5rem 0.7rem;
		border-radius: var(--dmh-radius);
		text-decoration: none;
		color: var(--dmh-ink-2);
		border: 1px solid transparent;
		background: rgba(255, 255, 255, 0.35);
		transition: background var(--dmh-ease), border-color var(--dmh-ease), transform var(--dmh-ease), box-shadow var(--dmh-ease);
		max-width: 10.5rem;
	}

	.dmh-loc:hover {
		background: rgba(255, 255, 255, 0.82);
		border-color: var(--dmh-border);
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
	}

	.dmh-loc .dmh-ico {
		color: var(--dmh-accent);
		margin-top: 2px;
		flex-shrink: 0;
	}

	.dmh-loc__text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
		min-width: 0;
	}

	.dmh-loc__kicker {
		font-size: 0.7rem;
		color: var(--dmh-muted);
		font-weight: 500;
	}

	.dmh-loc__value {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--dmh-ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Search — primary visual focus */
	.dmh-search {
		position: relative;
		display: flex;
		align-items: stretch;
		min-width: 0;
		min-height: 48px;
		background: #fff;
		border: 1.5px solid rgba(15, 23, 42, 0.1);
		border-radius: var(--dmh-radius-lg);
		overflow: visible;
		box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(255, 255, 255, 0.6) inset;
		transition: border-color var(--dmh-ease), box-shadow var(--dmh-ease), transform var(--dmh-ease);
	}

	.dmh-search:hover {
		border-color: rgba(6, 182, 212, 0.25);
		box-shadow: 0 6px 24px rgba(15, 23, 42, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.7) inset;
	}

	.dmh-search:focus-within {
		border-color: var(--dmh-accent);
		box-shadow: 0 8px 32px var(--dmh-accent-glow), 0 0 0 3px rgba(6, 182, 212, 0.15);
		transform: translateY(-1px);
	}

	.dmh-search__input {
		flex: 1;
		min-width: 0;
		border: none;
		padding: 0.75rem 1.15rem;
		font-size: 0.9375rem;
		outline: none;
		color: var(--dmh-ink);
		background: transparent;
		border-radius: var(--dmh-radius-lg) 0 0 var(--dmh-radius-lg);
	}

	.dmh-search__input::placeholder {
		color: #94a3b8;
	}

	.dmh-search__submit {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0 1.35rem;
		border: none;
		background: linear-gradient(135deg, var(--dmh-accent) 0%, #0891b2 100%);
		color: #fff;
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		cursor: pointer;
		border-radius: 0 var(--dmh-radius-lg) var(--dmh-radius-lg) 0;
		transition: background var(--dmh-ease), filter var(--dmh-ease), transform var(--dmh-ease), box-shadow var(--dmh-ease);
		white-space: nowrap;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}

	.dmh-search__submit:hover {
		filter: brightness(1.06);
		box-shadow: 0 4px 16px var(--dmh-accent-glow);
	}

	.dmh-search__submit:active {
		transform: scale(0.98);
	}

	.dmh-search__submit .dmh-ico {
		color: #fff;
	}

	.dmh-search__results {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(100% + 8px);
		background: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--dmh-border);
		border-radius: var(--dmh-radius);
		box-shadow: var(--dmh-shadow-scrolled);
		max-height: 400px;
		overflow: auto;
		z-index: 60;
	}

	.dmh-search__group-label {
		padding: 0.5rem 0.9rem;
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--dmh-muted);
		background: #f8fafc;
	}

	.dmh-search__result {
		display: flex;
		gap: 0.75rem;
		padding: 0.7rem 0.9rem;
		text-decoration: none;
		color: var(--dmh-ink);
		border-bottom: 1px solid #f1f5f9;
		transition: background var(--dmh-ease), transform var(--dmh-ease);
	}

	.dmh-search__result:hover {
		background: rgba(6, 182, 212, 0.08);
	}

	.dmh-search__result img {
		width: 44px;
		height: 44px;
		object-fit: cover;
		border-radius: 10px;
	}

	.dmh-search__result-badge {
		font-size: 0.62rem;
		font-weight: 700;
		color: var(--dmh-accent-dim);
		text-transform: uppercase;
	}

	.dmh-search__empty {
		padding: 1.15rem;
		margin: 0;
		color: var(--dmh-muted);
		font-size: 0.875rem;
	}

	/* Language */
	.dmh-lang {
		position: relative;
	}

	.dmh-lang__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.65rem;
		border: 1px solid var(--dmh-border);
		border-radius: var(--dmh-radius);
		background: rgba(255, 255, 255, 0.55);
		color: var(--dmh-ink-2);
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		transition: background var(--dmh-ease), border-color var(--dmh-ease), transform var(--dmh-ease), box-shadow var(--dmh-ease);
	}

	.dmh-lang__btn:hover {
		background: rgba(255, 255, 255, 0.92);
		border-color: rgba(6, 182, 212, 0.3);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
	}

	.dmh-lang__menu {
		position: absolute;
		right: 0;
		top: calc(100% + 6px);
		min-width: 150px;
		margin: 0;
		padding: 0.4rem 0;
		list-style: none;
		background: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--dmh-border);
		border-radius: var(--dmh-radius);
		box-shadow: var(--dmh-shadow);
		z-index: 50;
	}

	.dmh-lang__item {
		display: block;
		width: 100%;
		text-align: left;
		padding: 0.55rem 0.9rem;
		border: none;
		background: none;
		font-size: 0.84rem;
		cursor: pointer;
		color: var(--dmh-ink);
		transition: background var(--dmh-ease);
	}

	.dmh-lang__item:hover {
		background: rgba(6, 182, 212, 0.1);
	}

	/* Account */
	.dmh-account {
		position: relative;
	}

	.dmh-account__btn {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.65rem;
		border: 1px solid transparent;
		border-radius: var(--dmh-radius);
		background: rgba(255, 255, 255, 0.3);
		color: var(--dmh-ink-2);
		cursor: pointer;
		text-align: left;
		transition: background var(--dmh-ease), border-color var(--dmh-ease), transform var(--dmh-ease), box-shadow var(--dmh-ease);
	}

	.dmh-account__btn:hover {
		background: rgba(255, 255, 255, 0.85);
		border-color: var(--dmh-border);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
	}

	.dmh-account__text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}

	.dmh-account__kicker {
		font-size: 0.7rem;
		color: var(--dmh-muted);
		font-weight: 500;
	}

	.dmh-account__label {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--dmh-ink);
	}

	.dmh-account__menu {
		position: absolute;
		right: 0;
		top: calc(100% + 6px);
		min-width: 220px;
		padding: 0.5rem 0;
		background: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--dmh-border);
		border-radius: var(--dmh-radius);
		box-shadow: var(--dmh-shadow);
		z-index: 50;
	}

	.dmh-account__link {
		display: block;
		padding: 0.6rem 1rem;
		color: var(--dmh-ink);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: background var(--dmh-ease), color var(--dmh-ease), padding-left var(--dmh-ease);
	}

	.dmh-account__link:hover {
		background: rgba(6, 182, 212, 0.1);
		color: var(--dmh-accent-dim);
		padding-left: 1.15rem;
	}

	/* Orders */
	.dmh-orders {
		display: flex;
		flex-direction: column;
		padding: 0.45rem 0.65rem;
		border-radius: var(--dmh-radius);
		text-decoration: none;
		color: var(--dmh-ink-2);
		line-height: 1.2;
		border: 1px solid transparent;
		background: rgba(255, 255, 255, 0.3);
		white-space: nowrap;
		transition: background var(--dmh-ease), border-color var(--dmh-ease), transform var(--dmh-ease), box-shadow var(--dmh-ease);
	}

	.dmh-orders:hover {
		background: rgba(255, 255, 255, 0.85);
		border-color: var(--dmh-border);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
	}

	.dmh-orders__kicker {
		font-size: 0.7rem;
		color: var(--dmh-muted);
		font-weight: 500;
	}

	.dmh-orders__label {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--dmh-ink);
	}

	/* Cart */
	.dmh-cart {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		padding: 0.4rem 0.6rem;
		border-radius: var(--dmh-radius);
		text-decoration: none;
		color: var(--dmh-ink-2);
		border: 1px solid transparent;
		background: rgba(255, 255, 255, 0.35);
		transition: background var(--dmh-ease), border-color var(--dmh-ease), transform var(--dmh-ease), box-shadow var(--dmh-ease);
	}

	.dmh-cart:hover {
		background: rgba(6, 182, 212, 0.12);
		border-color: rgba(6, 182, 212, 0.35);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px var(--dmh-accent-glow);
	}

	.dmh-cart__icon-wrap {
		position: relative;
		display: grid;
		place-items: center;
	}

	.dmh-cart .dmh-ico {
		color: var(--dmh-accent);
	}

	.dmh-cart__badge {
		position: absolute;
		top: -7px;
		right: -11px;
		min-width: 1.2rem;
		height: 1.2rem;
		padding: 0 0.3rem;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--dmh-accent), #0891b2);
		color: #fff;
		font-size: 0.65rem;
		font-weight: 800;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 10px var(--dmh-accent-glow);
		border: 2px solid #fff;
	}

	.dmh-cart__label {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--dmh-ink);
	}

	/* Sub navigation — world-class DEJOIY brand bar */
	.dmh__sub {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--dmh-nav-bg);
		color: #fff;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 12px 40px rgba(15, 23, 42, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.dmh__sub::before {
		content: '';
		position: absolute;
		inset: -50% -15%;
		background:
			radial-gradient(ellipse 55% 90% at 25% 50%, rgba(59, 130, 246, 0.1), transparent 58%),
			radial-gradient(ellipse 45% 80% at 75% 45%, rgba(236, 72, 153, 0.07), transparent 55%),
			radial-gradient(ellipse 40% 70% at 50% 100%, rgba(99, 102, 241, 0.08), transparent 50%);
		animation: dmh-nav-ambient 20s ease-in-out infinite alternate;
		pointer-events: none;
		z-index: 0;
	}

	@keyframes dmh-nav-ambient {
		0% {
			transform: translate3d(-2%, 0, 0);
			opacity: 0.75;
		}
		100% {
			transform: translate3d(2%, -1%, 0);
			opacity: 1;
		}
	}

	.dmh__sub-inner {
		position: relative;
		z-index: 1;
		max-width: var(--dmh-max);
		margin: 0 auto;
		min-height: var(--dmh-sub-h);
		padding: 0.5rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.dmh-cat-drop {
		position: relative;
		flex: 0 0 auto;
		z-index: 2;
	}

	.dmh-mega-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.48rem 0.95rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: var(--dmh-radius);
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 700;
		cursor: pointer;
		white-space: nowrap;
		box-shadow: 0 2px 14px rgba(0, 0, 0, 0.18);
		transition: background 250ms ease, border-color 250ms ease, transform 250ms ease, box-shadow 250ms ease;
	}

	.dmh-mega-btn .dmh-ico {
		color: currentColor;
		transition: transform 250ms ease;
	}

	.dmh-mega-btn:hover,
	.dmh-mega-btn[aria-expanded='true'] {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.16);
		color: #fff;
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.22);
	}

	.dmh-mega-btn:hover .dmh-ico:first-child,
	.dmh-mega-btn[aria-expanded='true'] .dmh-ico:first-child {
		transform: scale(1.08);
	}

	.dmh-cat-drop__panel {
		position: absolute;
		left: 0;
		top: calc(100% + 10px);
		width: min(720px, 92vw);
		max-height: min(520px, 70vh);
		overflow: auto;
		background: rgba(255, 255, 255, 0.97);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.85);
		border-radius: 20px;
		box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
		z-index: 320;
		padding: 24px 0;
		scrollbar-width: thin;
		scrollbar-color: rgba(99, 102, 241, 0.35) transparent;
	}

	.dmh-cat-drop__panel::-webkit-scrollbar {
		width: 6px;
	}

	.dmh-cat-drop__panel::-webkit-scrollbar-thumb {
		background: rgba(99, 102, 241, 0.28);
		border-radius: 999px;
	}

	.dmh-cat-drop__title {
		margin: 0;
		padding: 0 24px 14px;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--dmh-muted);
	}

	.dmh-cat-drop__list {
		list-style: none;
		margin: 0;
		padding: 0 16px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2px 8px;
	}

	.dmh-cat-drop__link {
		display: block;
		padding: 0.58rem 12px;
		margin-bottom: 0;
		border-radius: 12px;
		text-decoration: none;
		color: var(--dmh-ink);
		font-size: 0.84rem;
		font-weight: 500;
		line-height: 1.35;
		transition: background 250ms ease, color 250ms ease, transform 250ms ease, box-shadow 250ms ease;
	}

	.dmh-cat-drop__link:hover {
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(236, 72, 153, 0.06));
		color: #312e81;
		transform: translateX(2px);
		box-shadow: inset 0 0 0 1px rgba(99, 102, 241, 0.12);
	}

	.dmh__sub-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		padding: 0 0.15rem;
	}

	.dmh__sub-links::-webkit-scrollbar {
		display: none;
	}

	.dmh-nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		border: 1px solid transparent;
		color: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		font-size: 0.84rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		white-space: nowrap;
		position: relative;
		transition: all 250ms ease;
	}

	.dmh-nav-link::after {
		display: none;
	}

	.dmh-nav-link:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
		border-color: transparent;
		transform: translateY(-1px);
		box-shadow: none;
		text-shadow: none;
	}

	.dmh-nav-link--active:not(.dmh-nav-link--joi) {
		background: linear-gradient(135deg, rgba(236, 72, 153, 0.18), rgba(99, 102, 241, 0.18));
		border: 1px solid rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		color: #fff;
		box-shadow: 0 0 20px rgba(236, 72, 153, 0.18);
	}

	.dmh-nav-link--active:not(.dmh-nav-link--joi):hover {
		color: #fff;
		background: linear-gradient(135deg, rgba(236, 72, 153, 0.22), rgba(99, 102, 241, 0.22));
		transform: translateY(-1px);
	}

	.dmh-nav-link--primary {
		font-weight: 700;
		color: rgba(255, 255, 255, 0.92);
	}

	.dmh-nav-link--primary:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
	}

	.dmh-nav-link__pill {
		font-size: 0.58rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.18rem 0.45rem;
		border-radius: 6px;
	}

	.dmh-nav-link--soon .dmh-nav-link__pill {
		background: rgba(6, 182, 212, 0.12);
		border: 1px solid rgba(6, 182, 212, 0.35);
		color: var(--dmh-accent);
	}

	.dmh-nav-link--joi {
		background: linear-gradient(135deg, rgba(236, 72, 153, 0.2), rgba(59, 130, 246, 0.2));
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #fff;
		box-shadow: 0 0 24px rgba(59, 130, 246, 0.25);
		animation: dmh-joi-ai-glow 5s ease-in-out infinite;
	}

	.dmh-nav-link--joi:hover,
	.dmh-nav-link--joi.dmh-nav-link--active {
		color: #fff;
		background: linear-gradient(135deg, rgba(236, 72, 153, 0.28), rgba(59, 130, 246, 0.28));
		border-color: rgba(255, 255, 255, 0.24);
		box-shadow: 0 0 32px rgba(59, 130, 246, 0.38);
		animation: none;
		transform: translateY(-1px);
	}

	@keyframes dmh-joi-ai-glow {
		0%,
		100% {
			box-shadow: 0 0 20px rgba(59, 130, 246, 0.22);
		}
		50% {
			box-shadow: 0 0 28px rgba(59, 130, 246, 0.32), 0 0 40px rgba(236, 72, 153, 0.12);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dmh__sub::before,
		.dmh-nav-link--joi {
			animation: none;
		}
	}

	.dmh-nav-link--refurb .dmh-nav-link__pill {
		background: rgba(6, 182, 212, 0.22);
		color: var(--dmh-accent);
	}

	.dmh-promo {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		background: rgba(6, 182, 212, 0.1);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		white-space: nowrap;
		border: 1px solid rgba(6, 182, 212, 0.35);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 0 16px rgba(6, 182, 212, 0.12);
		transition: all 250ms ease;
	}

	.dmh-promo:hover {
		background: rgba(6, 182, 212, 0.14);
		border-color: rgba(6, 182, 212, 0.48);
		box-shadow: 0 0 22px rgba(6, 182, 212, 0.22);
		transform: translateY(-1px);
	}

	.dmh-promo .dmh-ico {
		color: var(--dmh-accent);
	}

	.dmh-ico--chev {
		opacity: 0.65;
		transition: transform 250ms ease;
	}

	.dmh-mega-btn[aria-expanded='true'] .dmh-ico--chev {
		transform: rotate(180deg);
	}
}

@media (min-width: 1025px) and (max-width: 1280px) {
	.dmh__inner {
		grid-template-columns: minmax(150px, 220px) auto minmax(220px, 1fr) auto auto auto;
		padding: 0.55rem 1.15rem;
		gap: 0.6rem 0.85rem;
	}

	.dmh-lang {
		display: none;
	}

	.dmh-search__submit span {
		display: none;
	}

	.dmh-promo span {
		max-width: 11rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.dmh-nav-link {
		padding: 0.4rem 0.55rem;
		font-size: 0.8rem;
	}

	.dmh-cat-drop__panel {
		width: min(620px, 92vw);
	}

	.dmh-cat-drop__list {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}

@media (min-width: 1025px) and (max-width: 1180px) {
	.dmh-loc__value {
		max-width: 6.5rem;
	}
}

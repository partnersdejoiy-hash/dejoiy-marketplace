add_action( 'wp_footer', 'dejoiy_header_os_v4_footer_templates', 5 );


/**
 * After logout, return to DEJOIY home (no WordPress branded interstitial).
 *
 * @param string  $redirect_to Redirect target.
 * @param string  $requested   Requested redirect.
 * @param WP_User $user        User.
 * @return string
 */
function dejoiy_header_os_v4_logout_redirect( $redirect_to, $requested, $user ) {
	unset( $user );
	if ( $requested ) {
		return $requested;
	}
	return home_url( '/' );
}
add_filter( 'logout_redirect', 'dejoiy_header_os_v4_logout_redirect', 20, 3 );

/**
 * DEJOIY Universe home — light interactions only.
 */
(function () {
  'use strict';

  var root = document.getElementById('dejoiy-universe');
  if (!root) {
    return;
  }

  if ('IntersectionObserver' in window) {
    var blocks = root.querySelectorAll('.du-block, .du-world, .du-hub');
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('du-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.06, rootMargin: '0px 0px -24px 0px' }
    );
    blocks.forEach(function (el) {
      el.classList.add('du-reveal');
      io.observe(el);
    });
  }
})();

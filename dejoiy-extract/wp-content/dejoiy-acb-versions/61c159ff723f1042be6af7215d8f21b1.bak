/**
 * DEJOIY Shop Discovery Hub — mobile filters + legend scroll hint
 */
(function () {
	'use strict';

	var hub = document.getElementById('dejoiy-shop-discovery-hub');
	if (!hub) {
		return;
	}

	var toggle = document.getElementById('dsh-filters-toggle');
	var drawer = document.getElementById('dsh-filters-drawer');
	var body = document.body;

	if (toggle && drawer) {
		var openDrawer = function () {
			drawer.hidden = false;
			drawer.classList.add('is-open');
			toggle.setAttribute('aria-expanded', 'true');
			body.style.overflow = 'hidden';
		};
		var closeDrawer = function () {
			drawer.classList.remove('is-open');
			drawer.hidden = true;
			toggle.setAttribute('aria-expanded', 'false');
			body.style.overflow = '';
		};
		toggle.addEventListener('click', function () {
			if (drawer.classList.contains('is-open')) {
				closeDrawer();
			} else {
				openDrawer();
			}
		});
		drawer.addEventListener('click', function (e) {
			if (e.target === drawer) {
				closeDrawer();
			}
		});
		drawer.querySelectorAll('.dsh-filters-drawer__item:not(.is-disabled)').forEach(function (link) {
			link.addEventListener('click', closeDrawer);
		});
	}

	/* Mark mobile OS for sticky offset */
	if (window.matchMedia('(max-width: 1024px)').matches && document.getElementById('dejoiy-mobile-os-mkt')) {
		body.classList.add('dejoiy-mobile-os-active');
	}
})();

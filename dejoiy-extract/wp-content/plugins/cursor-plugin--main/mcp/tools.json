    "endpoint": "POST /mcp/execute",
    "inputSchema": {
      "type": "object",
      "properties": {
        "zone": { "type": "string", "enum": ["wp-content", "themes", "plugins", "uploads", "mu-plugins"] },
        "path": { "type": "string" }

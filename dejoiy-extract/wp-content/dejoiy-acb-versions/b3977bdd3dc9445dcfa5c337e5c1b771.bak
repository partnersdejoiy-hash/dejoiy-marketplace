<?php
/**
 * DEJOIY Nexus — book card markup (shared by landing, My Nexus, AJAX).
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * Render one book card.
 *
 * @param WP_Post $post Product post.
 * @return string
 */
function dejoiy_library_render_book_card( $post ) {
	if ( ! $post instanceof WP_Post ) {
		return '';
	}

	$id         = (int) $post->ID;
	$title      = get_the_title( $id );
	$view_url   = function_exists( 'dejoiy_library_reader_url' )
		? dejoiy_library_reader_url( $id )
		: get_permalink( $id );
	$cover      = dejoiy_library_get_cover_url( $id, 'medium' );
	$fallback   = function_exists( 'dejoiy_library_get_cover_fallback_url' )
		? dejoiy_library_get_cover_fallback_url( $id )
		: $cover;
	$author     = dejoiy_library_get_author( $id );
	$time       = dejoiy_library_get_reading_time( $id );
	$product    = function_exists( 'wc_get_product' ) ? wc_get_product( $id ) : null;
	$price_html = $product ? wp_strip_all_tags( $product->get_price_html() ) : '₹101';
	$buy_label  = $product && $product->get_price()
		? sprintf( 'Buy %s', wp_strip_all_tags( wc_price( $product->get_price() ) ) )
		: 'Buy ₹101';
	$slug       = get_post_meta( $id, '_dejoiy_library_category', true );
	$accent     = dejoiy_library_category_color( $slug ? (string) $slug : 'business' );
	$cart_url   = function_exists( 'dejoiy_library_get_add_to_cart_url' )
		? dejoiy_library_get_add_to_cart_url( $id )
		: add_query_arg( 'add-to-cart', $id, dejoiy_library_get_landing_url() );
	$excerpt    = $product ? wp_trim_words( wp_strip_all_tags( $product->get_short_description() ), 28, '…' ) : '';

	return sprintf(
		'<article class="dlu-book" data-dlu-reveal style="--dlu-accent:%s"
			data-id="%d"
			data-title="%s"
			data-author="%s"
			data-cover="%s"
			data-cover-fallback="%s"
			data-price="%s"
			data-read-url="%s"
			data-buy-url="%s"
			data-excerpt="%s">
			<a href="%s" class="dlu-book-cover">
				<img src="%s" alt="%s" loading="lazy" width="200" height="300" data-fallback="%s" onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.onerror=null;}" />
				<span class="dlu-book-reflection"></span>
				<button type="button" class="dlu-book-save" data-id="%d" aria-label="Save to Nexus wishlist">♡</button>
				<button type="button" class="dlu-book-preview" aria-label="Quick preview">Preview</button>
			</a>
			<div class="dlu-book-meta">
				<h3><a href="%s">%s</a></h3>
				<p class="dlu-book-author">%s</p>
				<div class="dlu-book-foot">
					<span class="dlu-book-time">%s</span>
					<span class="dlu-book-rating">★ 4.%d</span>
					<span class="dlu-book-price">%s</span>
				</div>
				<div class="dlu-book-actions">
					<a href="%s" class="dlu-book-read">Read</a>
					<a href="%s" class="dlu-book-buy">%s</a>
					<a href="%s" class="dlu-book-add">Add to shelf</a>
				</div>
			</div>
		</article>',
		esc_attr( $accent ),
		(int) $id,
		esc_attr( $title ),
		esc_attr( $author ),
		esc_url( $cover ),
		esc_url( $fallback ),
		esc_attr( $price_html ),
		esc_url( $view_url ),
		esc_url( $cart_url ),
		esc_attr( $excerpt ),
		esc_url( $view_url ),
		esc_url( $cover ),
		esc_attr( $title ),
		esc_url( $fallback ),
		(int) $id,
		esc_url( $view_url ),
		esc_html( $title ),
		esc_html( $author ),
		esc_html( $time ),
		(int) wp_rand( 5, 9 ),
		esc_html( $price_html ),
		esc_url( $view_url ),
		esc_url( $cart_url ),
		esc_html( $buy_label ),
		esc_url( $cart_url )
	);
}

<?php
/**
 * DEJOIY Services — landing + viewer HTML.
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * WCFM vendor registration page (same as site-wide seller signup).
 *
 * @return string
 */
function dejoiy_services_vendor_registration_url() {
	$url = home_url( '/vendor-register/' );

	if ( function_exists( 'wcfm_get_page_id' ) ) {
		$page_id = wcfm_get_page_id( 'vendor_registration' );
		if ( $page_id ) {
			$permalink = get_permalink( $page_id );
			if ( $permalink && ! is_wp_error( $permalink ) ) {
				$url = $permalink;
			}
		}
	}

	return (string) apply_filters( 'dejoiy_services_vendor_registration_url', $url );
}

/**
 * Compact logo markup (never output full-size custom logo HTML).
 *
 * @return string
 */
function dejoiy_services_logo_html() {
	$home    = home_url( '/' );
	$logo_id = (int) get_theme_mod( 'custom_logo' );

	if ( $logo_id > 0 ) {
		$img = wp_get_attachment_image(
			$logo_id,
			array( 140, 48 ),
			false,
			array(
				'class'    => 'dsv-logo__img',
				'alt'      => get_bloginfo( 'name', 'display' ),
				'loading'  => 'eager',
				'decoding' => 'async',
			)
		);
		if ( $img ) {
			return '<a class="dsv-logo" href="' . esc_url( $home ) . '" aria-label="' . esc_attr__( 'DEJOIY Home', 'dejoiy' ) . '">' . $img . '</a>';
		}
	}

	return '<a class="dsv-logo dsv-logo--text" href="' . esc_url( $home ) . '"><span class="dsv-logo__mark">DEJOIY</span></a>';
}

/**
 * @return int
 */
function dejoiy_services_cart_count() {
	if ( ! function_exists( 'WC' ) || ! WC()->cart ) {
		return 0;
	}
	return (int) WC()->cart->get_cart_contents_count();
}


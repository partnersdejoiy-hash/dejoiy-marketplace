<?php
/**
 * DEJOIY Mobile / tablet single product — no marketplace header or footer.
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * Single product focus view (mobile/tablet).
 *
 * @return bool
 */
function dejoiy_mobile_product_is_product_focus() {
	if ( is_admin() && ! wp_doing_ajax() ) {
		return false;
	}
	return function_exists( 'is_product' ) && is_product();
}

/**
 * Checkout chromeless layout — never during AJAX or payment return endpoints.
 *
 * @return bool
 */
function dejoiy_mobile_checkout_is_chromeless() {
	if ( is_admin() || wp_doing_ajax() ) {
		return false;
	}
	if ( ! function_exists( 'is_checkout' ) || ! is_checkout() ) {
		return false;
	}
	if ( is_wc_endpoint_url( 'order-received' ) || is_wc_endpoint_url( 'order-pay' ) ) {
		return false;
	}
	return true;
}

/**
 * @return bool
 */
function dejoiy_mobile_product_is_focus_view() {
	return dejoiy_mobile_product_is_product_focus() || dejoiy_mobile_checkout_is_chromeless();
}

/**
 * @param array<int, string> $classes Body classes.
 * @return array<int, string>
 */
function dejoiy_mobile_product_body_class( $classes ) {
	if ( dejoiy_mobile_product_is_focus_view() ) {
		$classes[] = 'dejoiy-mobile-product-view';
		$classes[] = 'dejoiy-mobile-os-off';
		if ( function_exists( 'is_checkout' ) && is_checkout() ) {
			$classes[] = 'dejoiy-mobile-checkout-view';
		}
	}
	return $classes;
}
add_filter( 'body_class', 'dejoiy_mobile_product_body_class', 22 );




/**
 * Whether a sub-nav link matches the current request (desktop active state).
 *
 * @param array<string, mixed> $link Nav item.
 * @return bool
 */
function dejoiy_dm_header_nav_link_is_active( $link ) {
	if ( empty( $link['key'] ) ) {
		return false;
	}

	$uri = strtolower( (string) wp_unslash( $_SERVER['REQUEST_URI'] ?? '' ) );
	$key = (string) $link['key'];

	switch ( $key ) {
		case 'home':
			return is_front_page();
		case 'shop':
			return ( function_exists( 'is_shop' ) && is_shop() )
				|| ( function_exists( 'is_product_taxonomy' ) && is_product_taxonomy() )
				|| ( function_exists( 'is_product' ) && is_product() );
		case 'nexus':
			return ( false !== strpos( $uri, 'dejoiy-library' ) ) || ( false !== strpos( $uri, 'dejoiy_library' ) );
		case 'custom-studio':
			return false !== strpos( $uri, 'dejoiy-custom-studio' );
		case 'refurbished':
			return false !== strpos( $uri, 'dejoiy-refurbished' );
		case 'services':
			return false !== strpos( $uri, 'dejoiy-services' );
		case 'quickmart':
			return false !== strpos( $uri, 'dejoiy-quick-mart' );
		case 'support':
			return ( is_page() && 'contact' === get_post_field( 'post_name', get_queried_object_id() ) )
				|| ( false !== strpos( $uri, '/contact' ) );
		case 'meet-joi':
			return ( is_page() && 'joi' === get_post_field( 'post_name', get_queried_object_id() ) )
				|| ( false !== strpos( $uri, '/joi/' ) )
				|| ( rtrim( $uri, '/' ) === '/joi' );
	}

	return false;
}

/**
 * @return array<string, mixed>
 */
function dejoiy_dm_header_config() {
	$account = home_url( '/my-account/' );
	$orders  = function_exists( 'wc_get_account_endpoint_url' )
		? wc_get_account_endpoint_url( 'orders' )
		: $account;
	$v4      = function_exists( 'dejoiy_header_os_v4_config' ) ? dejoiy_header_os_v4_config() : array();

	$cats = array();
	foreach ( dejoiy_dm_header_search_categories() as $cat ) {
		$cats[] = array(
			'slug'  => $cat['slug'],
			'label' => $cat['label'],
		);
	}

	$menu = array();
	if ( function_exists( 'dejoiy_header_os_v4_account_menu' ) ) {
		foreach ( dejoiy_header_os_v4_account_menu() as $item ) {
			$menu[] = array(
				'label' => $item['label'],
				'url'   => $item['url'],
				'key'   => $item['key'],
			);
		}
	}

	$mega = array();
	foreach ( dejoiy_dm_header_main_categories() as $cat ) {
		$mega[] = array(
			'label' => $cat['label'],
			'url'   => $cat['url'],
			'icon'  => isset( $cat['icon'] ) ? $cat['icon'] : '',
		);
	}

	return array(
		'version'      => DEJOIY_DM_HEADER_VERSION,
		'ajaxUrl'      => admin_url( 'admin-ajax.php' ),
		'nonce'        => function_exists( 'dejoiy_header_os_v4_config' ) && isset( $v4['nonce'] ) ? $v4['nonce'] : wp_create_nonce( 'dejoiy_header_os_v4' ),
		'cartCount'    => function_exists( 'dejoiy_mobile_os_get_cart_count' ) ? dejoiy_mobile_os_get_cart_count() : 0,
		'isLoggedIn'   => is_user_logged_in() ? 1 : 0,
		'customerName' => function_exists( 'dejoiy_header_os_v4_customer_name' ) ? dejoiy_header_os_v4_customer_name() : '',
		'deliveryUrl'  => function_exists( 'dejoiy_mobile_os_delivery_url' ) ? dejoiy_mobile_os_delivery_url() : $account,
		'accountUrl'   => $account,
		'ordersUrl'    => $orders,
		'cartUrl'      => function_exists( 'wc_get_cart_url' ) ? wc_get_cart_url() : home_url( '/cart/' ),
		'searchScopes' => isset( $v4['searchScopes'] ) ? $v4['searchScopes'] : array(),
		'categories'   => $cats,
		'accountMenu'  => $menu,
		'megaCategories' => $mega,
		'i18n'         => array(
			'searchPlaceholder' => __( 'Search products, brands and more…', 'dejoiy' ),
			'noResults'         => __( 'No results found', 'dejoiy' ),
			'search'            => __( 'Search', 'dejoiy' ),
			'allCategories'     => __( 'All Categories', 'dejoiy' ),
		),
	);
}

/**
 * Standalone marketplace header markup.
 *
 * @return string
 */
function dejoiy_desktop_marketplace_header_html() {
	$shop     = function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'shop' ) : home_url( '/shop/' );
	$cart     = function_exists( 'wc_get_cart_url' ) ? wc_get_cart_url() : home_url( '/cart/' );
	$account  = home_url( '/my-account/' );
	$orders   = function_exists( 'wc_get_account_endpoint_url' ) ? wc_get_account_endpoint_url( 'orders' ) : $account;
	$delivery = function_exists( 'dejoiy_mobile_os_delivery_url' ) ? dejoiy_mobile_os_delivery_url() : $account;
	$cart_ct  = function_exists( 'dejoiy_mobile_os_get_cart_count' ) ? dejoiy_mobile_os_get_cart_count() : 0;
	$nav      = dejoiy_dm_header_nav_links();
	$langs    = dejoiy_dm_header_languages();
	$greet    = is_user_logged_in()
		? ( function_exists( 'dejoiy_header_os_v4_customer_name' ) && dejoiy_header_os_v4_customer_name()
			? sprintf( /* translators: %s name */ __( 'Hello, %s', 'dejoiy' ), dejoiy_header_os_v4_customer_name() )
			: __( 'Hello', 'dejoiy' ) )
		: __( 'Hello, Sign In', 'dejoiy' );

	ob_start();
	?>
	<header id="dejoiy-marketplace-header" class="dmh" data-dmh-header role="banner" hidden aria-hidden="true">
		<div class="dmh__sticky">
			<div class="dmh__top">
				<div class="dmh__inner">
					<div class="dmh__logo-wrap">
						<?php echo dejoiy_dm_header_logo_html(); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?>
					</div>

					<a class="dmh-loc" href="<?php echo esc_url( $delivery ); ?>">
						<?php echo dejoiy_dm_header_icon( 'map-pin' ); // phpcs:ignore ?>
						<span class="dmh-loc__text">
							<span class="dmh-loc__kicker"><?php esc_html_e( 'Deliver to', 'dejoiy' ); ?></span>
							<span class="dmh-loc__value"><?php echo esc_html( function_exists( 'dejoiy_mobile_os_delivery_label' ) ? dejoiy_mobile_os_delivery_label() : __( 'Set location', 'dejoiy' ) ); ?></span>
						</span>
					</a>

					<form class="dmh-search" action="<?php echo esc_url( $shop ); ?>" method="get" role="search" data-dmh-search-form>
						<label class="screen-reader-text" for="dmh-search-input"><?php esc_html_e( 'Search DEJOIY', 'dejoiy' ); ?></label>
						<input id="dmh-search-input" class="dmh-search__input" type="search" name="s" placeholder="<?php esc_attr_e( 'Search products, brands and more…', 'dejoiy' ); ?>" autocomplete="off" data-dmh-search-input />
						<input type="hidden" name="post_type" value="product" />
						<button type="submit" class="dmh-search__submit" aria-label="<?php esc_attr_e( 'Search', 'dejoiy' ); ?>">
							<?php echo dejoiy_dm_header_icon( 'search' ); // phpcs:ignore ?>
							<span><?php esc_html_e( 'Search', 'dejoiy' ); ?></span>
						</button>
						<div class="dmh-search__results" id="dmh-search-results" hidden></div>
					</form>

					<div class="dmh-lang" data-dmh-dropdown-wrap>
						<button type="button" class="dmh-lang__btn" data-dmh-lang-toggle aria-expanded="false">
							<?php echo dejoiy_dm_header_icon( 'globe' ); // phpcs:ignore ?>
							<span><?php echo esc_html( $langs[0]['flag'] . ' ' . $langs[0]['label'] ); ?></span>
							<?php echo dejoiy_dm_header_icon( 'chevron' ); // phpcs:ignore ?>
						</button>
						<ul class="dmh-lang__menu" data-dmh-lang-menu hidden>
							<?php foreach ( $langs as $lang ) : ?>
								<li>
									<button type="button" class="dmh-lang__item" data-lang="<?php echo esc_attr( $lang['code'] ); ?>">
										<?php echo esc_html( $lang['flag'] . ' ' . $lang['label'] ); ?>
									</button>
								</li>
							<?php endforeach; ?>
						</ul>
					</div>

					<div class="dmh-account" data-dmh-dropdown-wrap>
						<button type="button" class="dmh-account__btn" data-dmh-account-toggle aria-expanded="false">
							<?php echo dejoiy_dm_header_icon( 'user' ); // phpcs:ignore ?>
							<span class="dmh-account__text">
								<span class="dmh-account__kicker"><?php echo esc_html( $greet ); ?></span>
								<span class="dmh-account__label"><?php esc_html_e( 'Account & Lists', 'dejoiy' ); ?></span>
							</span>
						</button>
						<div class="dmh-account__menu" data-dmh-account-menu hidden>
							<?php if ( function_exists( 'dejoiy_header_os_v4_account_menu' ) ) : ?>
								<?php foreach ( dejoiy_header_os_v4_account_menu() as $item ) : ?>
									<a class="dmh-account__link" href="<?php echo esc_url( $item['url'] ); ?>"><?php echo esc_html( $item['label'] ); ?></a>
								<?php endforeach; ?>
							<?php else : ?>
								<a class="dmh-account__link" href="<?php echo esc_url( $account ); ?>"><?php esc_html_e( 'Sign In', 'dejoiy' ); ?></a>
							<?php endif; ?>
						</div>
					</div>

					<a class="dmh-orders" href="<?php echo esc_url( $orders ); ?>">
						<span class="dmh-orders__kicker"><?php esc_html_e( 'Returns', 'dejoiy' ); ?></span>
						<span class="dmh-orders__label"><?php esc_html_e( 'and Orders', 'dejoiy' ); ?></span>
					</a>

					<a class="dmh-cart" href="<?php echo esc_url( $cart ); ?>" aria-label="<?php esc_attr_e( 'Cart', 'dejoiy' ); ?>">
						<span class="dmh-cart__icon-wrap">
							<?php echo dejoiy_dm_header_icon( 'cart' ); // phpcs:ignore ?>
							<?php if ( $cart_ct > 0 ) : ?>
								<span class="dmh-cart__badge" data-dmh-cart-badge><?php echo esc_html( $cart_ct > 99 ? '99+' : (string) $cart_ct ); ?></span>
							<?php else : ?>
								<span class="dmh-cart__badge" data-dmh-cart-badge hidden>0</span>
							<?php endif; ?>
						</span>
						<span class="dmh-cart__label"><?php esc_html_e( 'Cart', 'dejoiy' ); ?></span>
					</a>
				</div>
			</div>

			<nav class="dmh__sub" aria-label="<?php esc_attr_e( 'Marketplace navigation', 'dejoiy' ); ?>">
				<div class="dmh__sub-inner">
					<div class="dmh-cat-drop" data-dmh-dropdown-wrap>
						<button type="button" class="dmh-mega-btn" data-dmh-catlist-toggle aria-expanded="false" aria-haspopup="true">
							<?php echo dejoiy_dm_header_icon( 'menu' ); // phpcs:ignore ?>
							<span><?php esc_html_e( 'All Categories', 'dejoiy' ); ?></span>
							<?php echo dejoiy_dm_header_icon( 'chevron' ); // phpcs:ignore ?>
						</button>
						<div class="dmh-cat-drop__panel" data-dmh-catlist-panel hidden role="menu">
							<p class="dmh-cat-drop__title"><?php esc_html_e( 'Shop by category', 'dejoiy' ); ?></p>
							<ul class="dmh-cat-drop__list">
								<?php foreach ( dejoiy_dm_header_main_categories() as $cat ) : ?>
									<li role="none">
										<a class="dmh-cat-drop__link" role="menuitem" href="<?php echo esc_url( $cat['url'] ); ?>">
											<?php echo esc_html( $cat['label'] ); ?>
										</a>
									</li>
								<?php endforeach; ?>
							</ul>
						</div>
					</div>

					<div class="dmh__sub-links">
						<?php foreach ( $nav['items'] as $link ) : ?>
							<?php $nav_active = dejoiy_dm_header_nav_link_is_active( $link ); ?>
							<a class="dmh-nav-link<?php echo ! empty( $link['soon'] ) ? ' dmh-nav-link--soon' : ''; ?><?php echo ! empty( $link['joi'] ) ? ' dmh-nav-link--joi' : ''; ?><?php echo $nav_active ? ' dmh-nav-link--active' : ''; ?>" href="<?php echo esc_url( $link['url'] ); ?>"<?php echo $nav_active ? ' aria-current="page"' : ''; ?>>
								<?php echo esc_html( $link['label'] ); ?>
								<?php if ( ! empty( $link['pill'] ) ) : ?>
									<span class="dmh-nav-link__pill"><?php echo esc_html( $link['pill'] ); ?></span>
								<?php endif; ?>
							</a>
						<?php endforeach; ?>
					</div>

					<div class="dmh-promo" aria-label="<?php esc_attr_e( 'Promotion', 'dejoiy' ); ?>">
						<?php echo dejoiy_dm_header_icon( 'shield' ); // phpcs:ignore ?>
						<span><?php esc_html_e( 'Up to 70% Off Refurbished Devices', 'dejoiy' ); ?></span>
					</div>
				</div>
			</nav>
		</div>
	</header>
	<?php
	return (string) ob_get_clean();
}

/**
 * Mark standalone active and print header when theme header is absent.
 */
function dejoiy_desktop_marketplace_ensure_header() {
	if ( ! dejoiy_desktop_marketplace_should_bootstrap_standalone() ) {
		return;
	}
	if ( dejoiy_desktop_marketplace_is_mobile_client() ) {
		return;
	}
	static $done = false;
	if ( $done ) {
		return;
	}

	// phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
	echo dejoiy_desktop_marketplace_header_html();
	do_action( 'dejoiy_desktop_marketplace_header_printed' );
	$done = true;
}

/**
 * Critical CSS: desktop header must never appear on mobile/tablet (≤1024px).
 */
function dejoiy_desktop_marketplace_viewport_guard() {
	if ( ! dejoiy_desktop_marketplace_should_bootstrap_standalone() ) {
		return;
	}
	echo '<style id="dmh-viewport-guard">';
	echo '@media (max-width:1024px){#dejoiy-marketplace-header,.dmh{display:none!important;visibility:hidden!important;position:absolute!important;left:-9999px!important;width:0!important;height:0!important;overflow:hidden!important;pointer-events:none!important;}}';
	echo '@media (min-width:1025px){body.dejoiy-dmh-standalone #dejoiy-marketplace-header{display:block!important;visibility:visible!important;position:relative!important;left:auto!important;width:auto!important;height:auto!important;overflow:visible!important;pointer-events:auto!important;}}';
	echo '</style>';
}
add_action( 'wp_head', 'dejoiy_desktop_marketplace_viewport_guard', 2 );
add_action( 'wp_body_open', 'dejoiy_desktop_marketplace_ensure_header', 1 );
add_action( 'etheme_after_body_open', 'dejoiy_desktop_marketplace_ensure_header', 1 );

/**
 * @param array<int, string> $classes Body classes.
 * @return array<int, string>
 */
function dejoiy_desktop_marketplace_header_body_class( $classes ) {
	if ( ! dejoiy_desktop_marketplace_header_enabled() ) {
		return $classes;
	}
	$classes[] = 'dejoiy-dm-header';
	if ( dejoiy_desktop_marketplace_standalone_is_active() && ! dejoiy_desktop_marketplace_is_mobile_client() ) {
		$classes[] = 'dejoiy-dmh-standalone';
	}
	return $classes;
}
add_filter( 'body_class', 'dejoiy_desktop_marketplace_header_body_class', 21 );

/**
 * Enqueue desktop-only assets.
 */
function dejoiy_desktop_marketplace_header_assets() {
	if ( ! dejoiy_desktop_marketplace_header_enabled() ) {
		return;
	}

	$dir = get_stylesheet_directory();
	$uri = get_stylesheet_directory_uri();
	$css = $dir . '/dejoiy-desktop-marketplace-header.css';
	$js  = $dir . '/dejoiy-desktop-marketplace-header.js';
	$ver = defined( 'DEJOIY_DM_HEADER_VERSION' ) ? DEJOIY_DM_HEADER_VERSION : '1.0.0';

	if ( is_readable( $css ) ) {
		wp_enqueue_style(
			'dejoiy-desktop-marketplace-header',
			$uri . '/dejoiy-desktop-marketplace-header.css',
			array(),
			$ver . '.' . (string) filemtime( $css )
		);
	}

	if ( ! dejoiy_desktop_marketplace_is_mobile_client() && is_readable( $js ) ) {
		wp_enqueue_script(
			'dejoiy-desktop-marketplace-header',
			$uri . '/dejoiy-desktop-marketplace-header.js',
			array(),
			$ver . '.' . (string) filemtime( $js ),
			true
		);
		wp_localize_script( 'dejoiy-desktop-marketplace-header', 'dejoiyDmHeader', dejoiy_dm_header_config() );
	}
}
add_action( 'wp_enqueue_scripts', 'dejoiy_desktop_marketplace_header_assets', 10060 );

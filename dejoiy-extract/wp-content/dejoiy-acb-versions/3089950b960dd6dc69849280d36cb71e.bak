<?php
/**
 * DEJOIY Product Identification Number (DPIN) — DPN-########
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * @return string
 */
function dejoiy_dpin_meta_key() {
	return '_dejoiy_dpin';
}

/**
 * Allocate next DPIN string.
 *
 * @return string
 */
function dejoiy_dpin_allocate() {
	$next = (int) get_option( 'dejoiy_dpin_counter', 0 );
	++$next;
	update_option( 'dejoiy_dpin_counter', $next, false );
	return 'DPN-' . str_pad( (string) $next, 8, '0', STR_PAD_LEFT );
}

/**
 * @param int $product_id Product ID.
 * @return string
 */
function dejoiy_get_product_dpin( $product_id ) {
	$product_id = (int) $product_id;
	if ( $product_id < 1 ) {
		return '';
	}
	return (string) get_post_meta( $product_id, dejoiy_dpin_meta_key(), true );
}

/**
 * Assign DPIN on product save if missing.
 *
 * @param int $product_id Product ID.
 */
function dejoiy_dpin_maybe_assign( $product_id ) {
	$product_id = (int) $product_id;
	if ( $product_id < 1 || 'product' !== get_post_type( $product_id ) ) {
		return;
	}
	if ( get_post_meta( $product_id, dejoiy_dpin_meta_key(), true ) ) {
		return;
	}
	$dpin = dejoiy_dpin_allocate();
	update_post_meta( $product_id, dejoiy_dpin_meta_key(), $dpin );
}

add_action( 'woocommerce_new_product', 'dejoiy_dpin_maybe_assign', 20 );
add_action( 'save_post_product', 'dejoiy_dpin_maybe_assign', 25 );

/**
 * Backfill DPINs for existing products (batched).
 */
function dejoiy_dpin_backfill_batch() {
	if ( get_option( 'dejoiy_dpin_backfill_done' ) ) {
		return;
	}
	$q = new WP_Query(
		array(
			'post_type'      => 'product',
			'post_status'    => 'any',
			'posts_per_page' => 40,
			'fields'         => 'ids',
			'meta_query'     => array( // phpcs:ignore WordPress.DB.SlowDBQuery.slow_db_query_meta_query
				array(
					'key'     => dejoiy_dpin_meta_key(),
					'compare' => 'NOT EXISTS',
				),
			),
		)
	);
	if ( empty( $q->posts ) ) {
		update_option( 'dejoiy_dpin_backfill_done', '1' );
		return;
	}
	foreach ( $q->posts as $pid ) {
		dejoiy_dpin_maybe_assign( (int) $pid );
	}
}
add_action( 'init', 'dejoiy_dpin_backfill_batch', 99 );

/**
 * Resolve product ID from DPIN.
 *
 * @param string $dpin DPIN.
 * @return int
 */
function dejoiy_dpin_resolve_product_id( $dpin ) {
	$dpin = strtoupper( trim( (string) $dpin ) );
	if ( ! preg_match( '/^DPN-\d{8}$/', $dpin ) ) {
		return 0;
	}
	$ids = get_posts(
		array(
			'post_type'      => 'product',
			'post_status'    => 'publish',
			'posts_per_page' => 1,
			'fields'         => 'ids',
			'meta_key'       => dejoiy_dpin_meta_key(), // phpcs:ignore WordPress.DB.SlowDBQuery.slow_db_query_meta_key
			'meta_value'     => $dpin,
		)
	);
	return ! empty( $ids[0] ) ? (int) $ids[0] : 0;
}

/**
 * ?dpin=DPN-00000001 → canonical product URL.
 */
function dejoiy_dpin_redirect_request() {
	if ( is_admin() ) {
		return;
	}
	$raw = isset( $_GET['dpin'] ) ? sanitize_text_field( wp_unslash( $_GET['dpin'] ) ) : ''; // phpcs:ignore WordPress.Security.NonceVerification.Recommended
	if ( '' === $raw ) {
		return;
	}
	$pid = dejoiy_dpin_resolve_product_id( $raw );
	if ( $pid > 0 ) {
		$url = function_exists( 'dejoiy_ecosystem_product_url' )
			? dejoiy_ecosystem_product_url( $pid )
			: get_permalink( $pid );
		if ( $url ) {
			wp_safe_redirect( $url, 302 );
			exit;
		}
	}
}
add_action( 'template_redirect', 'dejoiy_dpin_redirect_request', 5 );

/**
 * Extend product search with DPIN meta.
 *
 * @param array<string, mixed> $query Main query.
 * @return array<string, mixed>
 */
function dejoiy_dpin_extend_product_search( $query ) {
	if ( is_admin() || ! $query->is_main_query() || ! is_search() ) {
		return $query;
	}
	if ( 'product' !== $query->get( 'post_type' ) && ! in_array( 'product', (array) $query->get( 'post_type' ), true ) ) {
		return $query;
	}
	$term = $query->get( 's' );
	if ( ! $term || ! preg_match( '/^DPN-\d+/i', $term ) ) {
		return $query;
	}
	$pid = dejoiy_dpin_resolve_product_id( $term );
	if ( $pid > 0 ) {
		$query->set( 's', '' );
		$query->set( 'post__in', array( $pid ) );
	}
	return $query;
}
add_action( 'pre_get_posts', 'dejoiy_dpin_extend_product_search', 20 );

/**
 * Show DPIN on single product.
 */
function dejoiy_dpin_single_product_display() {
	global $product;
	if ( ! $product ) {
		return;
	}
	$dpin = dejoiy_get_product_dpin( $product->get_id() );
	if ( '' === $dpin ) {
		return;
	}
	echo '<p class="dejoiy-dpin"><span class="dejoiy-dpin-label">' . esc_html__( 'DEJOIY ID', 'dejoiy' ) . '</span> <code class="dejoiy-dpin-code">' . esc_html( $dpin ) . '</code></p>';
}
add_action( 'woocommerce_single_product_summary', 'dejoiy_dpin_single_product_display', 6 );

/**
 * Admin product list column.
 *
 * @param array<string, string> $columns Columns.
 * @return array<string, string>
 */
function dejoiy_dpin_admin_column( $columns ) {
	$columns['dejoiy_dpin'] = __( 'DPIN', 'dejoiy' );
	return $columns;
}
add_filter( 'manage_edit-product_columns', 'dejoiy_dpin_admin_column' );

/**
 * @param string $column Column key.
 * @param int    $post_id Post ID.
 */
function dejoiy_dpin_admin_column_render( $column, $post_id ) {
	if ( 'dejoiy_dpin' !== $column ) {
		return;
	}
	$dpin = dejoiy_get_product_dpin( $post_id );
	echo $dpin ? esc_html( $dpin ) : '—';
}
add_action( 'manage_product_posts_custom_column', 'dejoiy_dpin_admin_column_render', 10, 2 );

/**
 * WCFM / seller product editor field (read-only display).
 */
function dejoiy_dpin_wcfm_field() {
	global $wp;
	if ( empty( $wp->query_vars['wcfm-products-manage'] ) && empty( $_GET['wcfm-products-manage'] ) ) { // phpcs:ignore WordPress.Security.NonceVerification.Recommended
		return;
	}
	$product_id = isset( $_GET['products_manage'] ) ? absint( $_GET['products_manage'] ) : 0; // phpcs:ignore WordPress.Security.NonceVerification.Recommended
	if ( $product_id < 1 ) {
		return;
	}
	$dpin = dejoiy_get_product_dpin( $product_id );
	if ( '' === $dpin ) {
		dejoiy_dpin_maybe_assign( $product_id );
		$dpin = dejoiy_get_product_dpin( $product_id );
	}
	if ( $dpin ) {
		echo '<div class="wcfm-container"><p><strong>' . esc_html__( 'DEJOIY Product ID (DPIN)', 'dejoiy' ) . ':</strong> <code>' . esc_html( $dpin ) . '</code></p></div>';
	}
}
add_action( 'wcfm_product_manager_left_panel_after', 'dejoiy_dpin_wcfm_field', 15 );

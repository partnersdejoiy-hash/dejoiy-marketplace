						<span class="qm-header__loc-kicker"><?php echo $pin ? esc_html__( 'Delivering to', 'dejoiy' ) : esc_html__( 'Enter pincode', 'dejoiy' ); ?></span>
						<span class="qm-header__loc-value"><?php echo esc_html( $pin ? $pin . ' · ' . $loc : $loc ); ?></span>
					</span>
				</button>
				<nav class="qm-header__actions" aria-label="<?php esc_attr_e( 'Account', 'dejoiy' ); ?>">
					<a href="<?php echo esc_url( $account ); ?>"><?php esc_html_e( 'Login', 'dejoiy' ); ?></a>
					<a href="<?php echo esc_url( $orders ); ?>"><?php esc_html_e( 'Orders', 'dejoiy' ); ?></a>
					<a href="<?php echo esc_url( home_url( '/my-account/?et-wishlist-page' ) ); ?>"><?php esc_html_e( 'Wishlist', 'dejoiy' ); ?></a>
					<button type="button" class="qm-header__cart" data-qm-open-cart aria-label="<?php esc_attr_e( 'QuickMart cart', 'dejoiy' ); ?>">

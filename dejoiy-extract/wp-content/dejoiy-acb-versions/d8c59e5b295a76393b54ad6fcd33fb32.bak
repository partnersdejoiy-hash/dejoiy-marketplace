							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
						</span>
						<input type="search" id="dsv-search-input" class="dsv-header__search-input" name="s" value="<?php echo esc_attr( $search_q ); ?>" placeholder="<?php esc_attr_e( 'Search services only…', 'dejoiy' ); ?>" data-dsv-search-input />
						<input type="hidden" name="post_type" value="product" />
						<input type="hidden" name="dejoiy_services_search" value="1" />
					</form>
				</div>
			</div>
			<div class="dsv-header__results" id="dsv-search-results" hidden></div>
		</header>

		<nav class="dsv-eco-bar" aria-label="<?php esc_attr_e( 'DEJOIY ecosystems', 'dejoiy' ); ?>">
			<div class="dsv-eco-bar__track">
				<?php foreach ( dejoiy_services_ecosystem_nav() as $eco ) : ?>
					<a class="dsv-eco-bar__item<?php echo ! empty( $eco['active'] ) ? ' is-active' : ''; ?><?php echo ! empty( $eco['coming_soon'] ) ? ' is-soon' : ''; ?>" href="<?php echo esc_url( $eco['url'] ); ?>"<?php echo ! empty( $eco['coming_soon'] ) ? ' aria-disabled="true" tabindex="-1"' : ''; ?>>
						<span class="dsv-eco-bar__icon" aria-hidden="true"><?php echo esc_html( $eco['icon'] ); ?></span>
						<span class="dsv-eco-bar__label"><?php echo esc_html( $eco['label'] ); ?></span>
						<?php if ( ! empty( $eco['coming_soon'] ) ) : ?>

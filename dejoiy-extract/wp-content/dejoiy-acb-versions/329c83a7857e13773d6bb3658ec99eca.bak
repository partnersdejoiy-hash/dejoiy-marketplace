<?php
/**
 * DEJOIY Universe — premium front page (replaces Elementor body on home only).
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * @return bool
 */
function dejoiy_universe_home_is_active() {
	if ( is_admin() && ! wp_doing_ajax() ) {
		return false;
	}
	return '1' === get_option( 'dejoiy_universe_home_active', '1' );
}

/**
 * Ecosystem gateway definitions.
 *
 * @return array<string, array{label: string, tagline: string, url: string, icon: string, theme: string}>
 */
function dejoiy_universe_gateways() {
	$shop = function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'shop' ) : home_url( '/shop/' );
	return array(
		'marketplace' => array(
			'label'   => __( 'Marketplace', 'dejoiy' ),
			'tagline' => __( 'Discover everything', 'dejoiy' ),
			'url'     => $shop,
			'icon'    => '◆',
			'theme'   => 'market',
		),
		'nexus'       => array(
			'label'   => __( 'Nexus', 'dejoiy' ),
			'tagline' => __( 'Books & knowledge', 'dejoiy' ),
			'url'     => home_url( '/dejoiy-library/?dejoiy_library=1' ),
			'icon'    => '✦',
			'theme'   => 'nexus',
		),
		'studio'      => array(
			'label'   => __( 'Custom Studio', 'dejoiy' ),
			'tagline' => __( 'Create your vision', 'dejoiy' ),
			'url'     => home_url( '/dejoiy-custom-studio/' ),
			'icon'    => '✿',
			'theme'   => 'studio',
		),
		'quickmart'   => array(
			'label'   => __( 'QuickMart', 'dejoiy' ),
			'tagline' => __( 'Instant essentials', 'dejoiy' ),
			'url'     => home_url( '/dejoiy-quick-mart/' ),
			'icon'    => '⚡',
			'theme'   => 'quickmart',
		),
		'services'    => array(
			'label'   => __( 'Services', 'dejoiy' ),
			'tagline' => __( 'Expert help, booked', 'dejoiy' ),
			'url'     => home_url( '/dejoiy-services/' ),
			'icon'    => '◎',
			'theme'   => 'services',
		),
	);
}

/**
 * @param array<string, mixed> $args WP_Query args.
 * @return array<int, WP_Post>
 */
function dejoiy_universe_get_products( $args = array() ) {
	$defaults = array(
		'post_type'      => 'product',
		'post_status'    => 'publish',
		'posts_per_page' => 8,
		'no_found_rows'  => true,
	);
	$q = new WP_Query( array_merge( $defaults, $args ) );
	$posts = $q->posts;
	wp_reset_postdata();
	return is_array( $posts ) ? $posts : array();
}

/**
 * @param int    $product_id Product ID.
 * @param string $world      World theme slug.
 */
function dejoiy_universe_render_card( $product_id, $world = 'market' ) {
	$product = wc_get_product( $product_id );
	if ( ! $product ) {
		return;
	}
	$url   = function_exists( 'dejoiy_ecosystem_product_url' ) ? dejoiy_ecosystem_product_url( $product_id ) : get_permalink( $product_id );
	$cover = get_the_post_thumbnail_url( $product_id, 'woocommerce_thumbnail' );
	if ( ! $cover && function_exists( 'dejoiy_library_get_cover_url' ) ) {
		$cover = dejoiy_library_get_cover_url( $product_id, 'medium' );
	}
	?>
	<article class="du-card du-card--<?php echo esc_attr( $world ); ?>">
		<a class="du-card__link" href="<?php echo esc_url( $url ); ?>">
			<?php if ( $cover ) : ?>
				<img class="du-card__img" src="<?php echo esc_url( $cover ); ?>" alt="" loading="lazy" width="220" height="280" />
			<?php else : ?>
				<span class="du-card__ph" aria-hidden="true"></span>
			<?php endif; ?>
			<h3 class="du-card__title"><?php echo esc_html( $product->get_name() ); ?></h3>
			<span class="du-card__price"><?php echo wp_kses_post( $product->get_price_html() ); ?></span>
		</a>
	</article>
	<?php
}

/**
 * Product shelf — only output if products exist.
 *
 * @param string               $world World class.
 * @param array<string, mixed> $args  Query args.
 * @return bool Rendered.
 */
function dejoiy_universe_render_shelf( $world, $args ) {
	$posts = dejoiy_universe_get_products( $args );
	if ( empty( $posts ) ) {
		return false;
	}
	echo '<div class="du-shelf du-shelf--' . esc_attr( $world ) . '">';
	foreach ( $posts as $p ) {
		dejoiy_universe_render_card( $p->ID, $world );
	}
	echo '</div>';
	return true;
}

/**
 * @return array<int, string>
 */
function dejoiy_universe_get_searched_terms() {
	$raw = isset( $_COOKIE['dejoiy_searched'] ) ? wp_unslash( $_COOKIE['dejoiy_searched'] ) : ''; // phpcs:ignore
	$list = $raw ? json_decode( $raw, true ) : array();
	if ( ! is_array( $list ) ) {
		return array();
	}
	return array_slice( array_filter( array_map( 'sanitize_text_field', $list ) ), 0, 6 );
}

/**
 * Track search from Nexus / shop.
 */
function dejoiy_universe_track_search_cookie() {
	if ( is_admin() ) {
		return;
	}
	$term = '';
	if ( isset( $_GET['dlu_q'] ) ) { // phpcs:ignore
		$term = sanitize_text_field( wp_unslash( $_GET['dlu_q'] ) ); // phpcs:ignore
	} elseif ( isset( $_GET['s'] ) && isset( $_GET['post_type'] ) && 'product' === $_GET['post_type'] ) { // phpcs:ignore
		$term = sanitize_text_field( wp_unslash( $_GET['s'] ) ); // phpcs:ignore
	}
	if ( strlen( $term ) < 2 ) {
		return;
	}
	$list   = dejoiy_universe_get_searched_terms();
	$list   = array_values( array_diff( $list, array( $term ) ) );
	array_unshift( $list, $term );
	$list = array_slice( $list, 0, 8 );
	setcookie( 'dejoiy_searched', wp_json_encode( $list ), time() + MONTH_IN_SECONDS, COOKIEPATH, COOKIE_DOMAIN, is_ssl(), true );
}
add_action( 'template_redirect', 'dejoiy_universe_track_search_cookie', 8 );


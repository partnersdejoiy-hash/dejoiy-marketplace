/* Studio header & footer */
.dsu-hdr {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.82);
  border-bottom: 1px solid rgba(255, 215, 0, 0.35);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.dsu-hdr-in {
  max-width: 1400px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  gap: 20px;
}

.dsu-hdr-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none !important;
  flex-shrink: 0;
}

.dsu-hdr-logo img { height: 38px; width: auto; }

.dsu-hdr-wordmark {
  font-weight: 900;
  font-size: 20px;
  color: #ffd700;
  letter-spacing: 0.06em;
}

.dsu-hdr-tag {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.2em;
  color: #fff;
  padding: 4px 8px;
  border: 1px solid #ffd700;
  border-radius: 4px;
}

.dsu-hdr-search { flex: 1; max-width: 520px; margin: 0 auto; }

.dsu-hdr-search-wrap { position: relative; }

.dsu-hdr-search input {
  width: 100%;
  height: 44px;
  padding: 0 48px 0 16px;
  border-radius: 999px;
  border: 1px solid rgba(255, 215, 0, 0.45);
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}

.dsu-hdr-search input::placeholder { color: rgba(255, 255, 255, 0.55); }

.dsu-hdr-search input:focus {
  outline: none;
  border-color: #ffd700;
  box-shadow: 0 0 24px rgba(255, 215, 0, 0.25);
}

.dsu-hdr-search button {
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  border: none;
  border-radius: 50%;
  background: #ffd700;
  color: #000;
  cursor: pointer;
  display: grid;
  place-items: center;
}

.dsu-hdr-search-drop {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background: #0a0a0a;
  border: 1px solid rgba(255, 215, 0, 0.4);
  border-radius: 16px;
  max-height: 360px;
  overflow-y: auto;
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6);
}

.dsu-hdr-search-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  color: #fff !important;
  text-decoration: none !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.dsu-hdr-search-item:hover { background: rgba(255, 215, 0, 0.08); }

.dsu-hdr-search-item img {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid rgba(255, 215, 0, 0.3);
}

.dsu-hdr-search-item strong { display: block; font-size: 14px; color: #fff; }
.dsu-hdr-search-item small { color: #ffd700; font-weight: 700; }

.dsu-hdr-nav {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.dsu-hdr-nav a {
  color: #fff !important;
  text-decoration: none !important;
  font-size: 13px;
  font-weight: 700;
}

.dsu-hdr-nav a:hover { color: #ffd700 !important; }

.dsu-hdr-home {
  border: 1px solid rgba(255, 215, 0, 0.5);
  padding: 8px 14px;
  border-radius: 999px;
}

.dsu-hdr-badge {
  display: inline-flex;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  margin-left: 4px;
  align-items: center;
  justify-content: center;
  background: #ffd700;
  color: #000;
  font-size: 11px;
  font-weight: 800;
  border-radius: 999px;
}

.dsu-hdr-burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  padding: 8px;
  cursor: pointer;
}

.dsu-hdr-burger span {
  display: block;
  width: 22px;
  height: 2px;
  background: #ffd700;
}

.dsu-hdr-drawer {
  position: fixed;
  top: 68px;
  right: 0;
  z-index: 199;
  width: min(280px, 85vw);
  background: #000;
  border-left: 1px solid rgba(255, 215, 0, 0.35);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dsu-hdr-drawer a {
  color: #fff !important;
  font-weight: 700;
  text-decoration: none !important;
  padding: 10px 0;
}

.dsu-ftr {
  background: #000;
  border-top: 1px solid rgba(255, 215, 0, 0.3);
  padding: 48px 20px 24px;
}

.dsu-ftr-in {
  max-width: 1280px;
  margin: 0 auto 32px;
  display: grid;
  grid-template-columns: 1.4fr repeat(3, 1fr);
  gap: 32px;
}

.dsu-ftr-brand strong {
  display: block;
  color: #ffd700;
  font-size: 18px;
  margin-bottom: 8px;
}

.dsu-ftr-brand p {
  color: #fff;
  font-size: 14px;
  line-height: 1.6;
  margin: 0;
  max-width: 280px;
}

.dsu-ftr-col h4 {
  color: #ffd700;
  font-size: 12px;
  letter-spacing: 0.15em;
  margin: 0 0 12px;
}

.dsu-ftr-col a {
  display: block;
  color: #fff !important;
  text-decoration: none !important;
  font-size: 14px;
  margin-bottom: 8px;
  font-weight: 500;
}

.dsu-ftr-col a:hover { color: #ffd700 !important; }

.dsu-ftr-bottom {
  max-width: 1280px;
  margin: 0 auto;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  color: #fff;
  font-size: 13px;
}

.dsu-btn-sm {
  min-height: 40px;
  padding: 0 18px;
  font-size: 13px;
}

@media (max-width: 960px) {
  .dsu-hdr-nav { display: none; }
  .dsu-hdr-burger { display: flex; }
  .dsu-ftr-in { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 560px) {
  .dsu-hdr-search { max-width: none; order: 3; flex: 1 1 100%; }
  .dsu-hdr-in { flex-wrap: wrap; }
  .dsu-ftr-in { grid-template-columns: 1fr; }
}

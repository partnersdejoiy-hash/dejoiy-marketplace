					<h2 class="dlu-sec-title"><?php echo esc_html( $group['label'] ); ?></h2>
					<div class="dlu-books-grid">
						<?php
						$cat_q = dejoiy_library_query_books(
							array(
								'posts_per_page' => 10,
								'tax_query'      => array( // phpcs:ignore WordPress.DB.SlowDBQuery.slow_db_query_tax_query

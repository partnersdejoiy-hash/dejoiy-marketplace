/**
 * @return string
 */
function dejoiy_dm_header_logo_html() {
	$home = home_url( '/' );
	$logo_id = (int) get_theme_mod( 'custom_logo' );
	if ( $logo_id > 0 ) {
		$img = wp_get_attachment_image(
			$logo_id,
			array( 240, 88 ),
			false,
			array(
				'class'    => 'dmh-logo__img',
				'alt'      => get_bloginfo( 'name', 'display' ),
				'loading'  => 'eager',
				'decoding' => 'async',
			)
		);
		if ( $img ) {
			return '<a class="dmh-logo" href="' . esc_url( $home ) . '" aria-label="' . esc_attr__( 'DEJOIY Home', 'dejoiy' ) . '">' . $img . '</a>';
		}
	}
	if ( function_exists( 'get_custom_logo' ) ) {
		$logo = get_custom_logo();
		if ( $logo ) {
			return '<a class="dmh-logo" href="' . esc_url( $home ) . '" aria-label="' . esc_attr__( 'DEJOIY Home', 'dejoiy' ) . '">' . $logo . '</a>';
		}
	}
	return '<a class="dmh-logo dmh-logo--text" href="' . esc_url( $home ) . '" aria-label="' . esc_attr__( 'DEJOIY Home', 'dejoiy' ) . '">'
		. '<span class="dmh-logo__mark">D</span><span class="dmh-logo__word">DEJOIY</span></a>';
}

/**
 * Search category options for dropdown.
 *
 * @return array<int, array{slug:string,label:string,url:string}>
 */
function dejoiy_dm_header_search_categories() {
	$shop  = function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'shop' ) : home_url( '/shop/' );
	$items = array(
		array(
			'slug'  => 'all',
			'label' => __( 'All Departments', 'dejoiy' ),
			'url'   => $shop,
		),
	);
	if ( taxonomy_exists( 'product_cat' ) ) {
		$terms = get_terms(
			array(
				'taxonomy'   => 'product_cat',
				'hide_empty' => true,
				'parent'     => 0,
				'number'     => 10,
				'orderby'    => 'count',
				'order'      => 'DESC',
			)
		);
		if ( ! is_wp_error( $terms ) ) {
			foreach ( $terms as $term ) {
				if ( in_array( $term->slug, array( 'uncategorized', 'uncategorised' ), true ) ) {
					continue;
				}
				$link = get_term_link( $term );
				if ( is_wp_error( $link ) ) {
					continue;
				}
				$items[] = array(
					'slug'  => $term->slug,
					'label' => $term->name,
					'url'   => $link,
				);
			}
		}
	}
	return $items;
}

/**
 * All top-level WooCommerce categories for the desktop All Categories dropdown.
 *
 * @return array<int, array{slug:string,label:string,url:string}>
 */
function dejoiy_dm_header_main_categories() {
	static $cached = null;

	if ( null !== $cached ) {
		return $cached;
	}

	$cached = array();

	if ( ! taxonomy_exists( 'product_cat' ) ) {
		if ( function_exists( 'dejoiy_mobile_os_market_categories' ) ) {
			$cached = dejoiy_mobile_os_market_categories();
		}
		return $cached;
	}

	$terms = get_terms(
		array(
			'taxonomy'   => 'product_cat',
			'hide_empty' => false,
			'parent'     => 0,
			'orderby'    => 'name',
			'order'      => 'ASC',
		)
	);

	if ( is_wp_error( $terms ) || empty( $terms ) ) {
		if ( function_exists( 'dejoiy_mobile_os_market_categories' ) ) {
			$cached = dejoiy_mobile_os_market_categories();
		}
		return $cached;
	}

	foreach ( $terms as $term ) {
		if ( in_array( $term->slug, array( 'uncategorized', 'uncategorised' ), true ) ) {
			continue;
		}
		$link = get_term_link( $term );
		if ( is_wp_error( $link ) ) {
			continue;
		}
		$cached[] = array(
			'slug'  => $term->slug,
			'label' => $term->name,
			'url'   => $link,
		);
	}

	if ( empty( $cached ) && function_exists( 'dejoiy_mobile_os_market_categories' ) ) {
		$cached = dejoiy_mobile_os_market_categories();
	}

	return $cached;
}

/**
 * @return array<int, array{code:string,label:string,flag:string}>
 */
function dejoiy_dm_header_languages() {
	$flags = array(
		'en' => '🇬🇧',
		'hi' => '🇮🇳',
		'bn' => '🇧🇩',
		'ta' => '🇮🇳',
	);
	$out   = array();
	$langs = function_exists( 'dejoiy_library_get_languages' ) ? dejoiy_library_get_languages() : array();
	$pick  = array( 'en', 'hi', 'bn', 'ta' );
	foreach ( $pick as $code ) {
		if ( ! isset( $langs[ $code ] ) ) {
			continue;
		}
		$out[] = array(
			'code'  => $code,
			'label' => $langs[ $code ]['native'],
			'flag'  => isset( $flags[ $code ] ) ? $flags[ $code ] : '🌐',
		);
	}
	if ( empty( $out ) ) {
		$out[] = array(
			'code'  => 'en',
			'label' => 'English',
			'flag'  => '🇬🇧',
		);
	}
	return $out;
}


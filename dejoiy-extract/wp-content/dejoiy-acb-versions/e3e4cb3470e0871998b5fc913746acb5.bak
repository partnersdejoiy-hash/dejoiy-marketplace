	if ( ! dejoiy_quickmart_is_app_page() ) {
		return;
	}
	static $done = false;
	if ( $done ) {
		return;
	}
	$done = true;

	$home    = home_url( '/dejoiy-quick-mart/' );
	$cart    = dejoiy_quickmart_get_cart_url();

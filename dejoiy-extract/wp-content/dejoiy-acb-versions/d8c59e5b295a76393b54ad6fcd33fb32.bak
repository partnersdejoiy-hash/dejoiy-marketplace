}

/**
 * @param int $product_id Product ID.
 * @return string
 */
function dejoiy_services_delivery_label( $product_id ) {
	$custom = (string) get_post_meta( $product_id, '_dejoiy_service_delivery', true );
	if ( '' !== $custom ) {
		return $custom;
	}
	$days = (string) get_post_meta( $product_id, '_dejoiy_delivery_days', true );
	if ( '' !== $days && is_numeric( $days ) ) {
		/* translators: %d: number of days */
		return sprintf( _n( '%d day delivery', '%d days delivery', (int) $days, 'dejoiy' ), (int) $days );
	}
	return __( '3–7 days delivery', 'dejoiy' );
}

/**
 * @param int $product_id Product ID.
 * @return string
 */
function dejoiy_services_rating_html( $product_id ) {
	if ( ! function_exists( 'wc_get_product' ) ) {
		return '';
	}
	$product = wc_get_product( $product_id );
	if ( ! $product ) {
		return '';
	}
	$avg   = (float) $product->get_average_rating();
	$count = (int) $product->get_rating_count();
	if ( $count < 1 ) {
		return '<span class="dsv-card__rating dsv-card__rating--new">' . esc_html__( 'New provider', 'dejoiy' ) . '</span>';
	}
	return sprintf(
		'<span class="dsv-card__rating" aria-label="%1$s"><span aria-hidden="true">★</span> %2$s <em>(%3$d)</em></span>',
		esc_attr( sprintf( __( 'Rated %1$s out of 5', 'dejoiy' ), number_format( $avg, 1 ) ) ),
		esc_html( number_format( $avg, 1 ) ),
		$count
	);
}

/**
 * @param int $product_id Product ID.
 * @return string
 */
function dejoiy_services_render_service_card( $product_id ) {
	$product = function_exists( 'wc_get_product' ) ? wc_get_product( $product_id ) : null;
	if ( ! $product ) {
		return '';
	}

	$url    = function_exists( 'dejoiy_ecosystem_product_url' ) ? dejoiy_ecosystem_product_url( $product_id ) : get_permalink( $product_id );
	$cover  = get_the_post_thumbnail_url( $product_id, 'woocommerce_thumbnail' );
	$seller = function_exists( 'dejoiy_universe_seller_label' ) ? dejoiy_universe_seller_label( $product_id ) : __( 'Verified provider', 'dejoiy' );
	$delivery = dejoiy_services_delivery_label( $product_id );
	$rating = dejoiy_services_rating_html( $product_id );

	ob_start();
	?>
	<article class="dsv-card" data-reveal data-product-id="<?php echo esc_attr( (string) $product_id ); ?>">
		<a class="dsv-card__link" href="<?php echo esc_url( $url ); ?>">
			<div class="dsv-card__media">
				<?php if ( $cover ) : ?>
					<img class="dsv-card__img" src="<?php echo esc_url( $cover ); ?>" alt="<?php echo esc_attr( $product->get_name() ); ?>" loading="lazy" decoding="async" width="320" height="240" />
				<?php else : ?>
					<span class="dsv-card__ph" aria-hidden="true">◎</span>
				<?php endif; ?>
				<span class="dsv-card__badge"><?php esc_html_e( 'Services', 'dejoiy' ); ?></span>
			</div>
			<div class="dsv-card__body">
				<h3 class="dsv-card__title"><?php echo esc_html( $product->get_name() ); ?></h3>
				<p class="dsv-card__price"><?php echo wp_kses_post( $product->get_price_html() ); ?></p>
				<p class="dsv-card__seller"><?php echo esc_html( $seller ); ?></p>
				<?php echo $rating; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?>
				<p class="dsv-card__delivery"><?php echo esc_html( $delivery ); ?></p>
				<span class="dsv-card__cta"><?php esc_html_e( 'View Service', 'dejoiy' ); ?></span>
			</div>
		</a>
		<?php if ( $product->is_purchasable() && $product->is_in_stock() ) : ?>
			<button type="button" class="dsv-card__book dsv-btn dsv-btn--book" data-dsv-book="<?php echo esc_attr( (string) $product_id ); ?>"><?php esc_html_e( 'Book this service', 'dejoiy' ); ?></button>
		<?php endif; ?>
	</article>
	<?php
	return (string) ob_get_clean();
}

/**
 * Full landing page markup.
 *
 * @return string
 */
function dejoiy_services_landing_html() {
	// phpcs:ignore WordPress.Security.NonceVerification.Recommended
	$svc_cat   = isset( $_GET['svc_cat'] ) ? sanitize_key( wp_unslash( $_GET['svc_cat'] ) ) : '';
	// phpcs:ignore WordPress.Security.NonceVerification.Recommended
	$search    = isset( $_GET['s'] ) ? sanitize_text_field( wp_unslash( $_GET['s'] ) ) : '';
	$provider  = dejoiy_services_vendor_registration_url();
	$list_url  = dejoiy_services_listing_url();

	$query_args = array(
		'posts_per_page' => 12,
		'paged'          => max( 1, (int) get_query_var( 'paged' ) ),
	);
	if ( $search ) {
		$query_args['s'] = $search;
	}
	if ( $svc_cat ) {
		$terms = dejoiy_services_terms_for_category( $svc_cat );
		if ( ! empty( $terms ) ) {
			$query_args['tax_query'] = array(
				array(
					'taxonomy'         => 'product_cat',
					'field'            => 'slug',
					'terms'            => $terms,
					'operator'         => 'IN',
					'include_children' => true,
				),
			);
		}
	}

	$query = dejoiy_services_query_products( $query_args );

	ob_start();
	?>
	<div class="dsv-app" id="dejoiy-services-app">
		<section class="dsv-hero" data-reveal>
			<div class="dsv-hero__bg" aria-hidden="true">
				<span class="dsv-hero__orb dsv-hero__orb--1"></span>
				<span class="dsv-hero__orb dsv-hero__orb--2"></span>
				<span class="dsv-hero__orb dsv-hero__orb--3"></span>
			</div>
			<div class="dsv-hero__in">
				<p class="dsv-hero__eyebrow"><?php esc_html_e( 'DEJOIY Services Marketplace', 'dejoiy' ); ?></p>
				<h1 class="dsv-hero__title"><?php esc_html_e( 'Premium Services for Every Need', 'dejoiy' ); ?></h1>
				<p class="dsv-hero__desc"><?php esc_html_e( 'Hire experts. Book services. Get professional work done faster with DEJOIY Services.', 'dejoiy' ); ?></p>
				<div class="dsv-hero__actions">
					<a class="dsv-btn dsv-btn--primary" href="<?php echo esc_url( $list_url ); ?>"><?php esc_html_e( 'Browse Services', 'dejoiy' ); ?></a>
					<a class="dsv-btn dsv-btn--ghost" href="<?php echo esc_url( $provider ); ?>"><?php esc_html_e( 'Become a Service Provider', 'dejoiy' ); ?></a>
				</div>
			</div>
		</section>

		<section class="dsv-categories" aria-labelledby="dsv-categories-title" data-reveal>
			<div class="dsv-section__head">
				<h2 id="dsv-categories-title" class="dsv-section__title"><?php esc_html_e( 'Browse by category', 'dejoiy' ); ?></h2>
				<button type="button" class="dsv-filter-toggle" id="dsv-filter-toggle" aria-expanded="false" aria-controls="dsv-filter-sheet"><?php esc_html_e( 'Filters', 'dejoiy' ); ?></button>
			</div>
			<div class="dsv-categories__grid">
				<?php foreach ( dejoiy_services_category_cards() as $card ) : ?>
					<a class="dsv-cat-card<?php echo $svc_cat === $card['key'] ? ' is-active' : ''; ?>" href="<?php echo esc_url( dejoiy_services_listing_url( $card['key'] ) ); ?>" data-reveal>
						<span class="dsv-cat-card__icon" aria-hidden="true"><?php echo esc_html( $card['icon'] ); ?></span>
						<h3 class="dsv-cat-card__title"><?php echo esc_html( $card['title'] ); ?></h3>
						<p class="dsv-cat-card__desc"><?php echo esc_html( $card['desc'] ); ?></p>
					</a>
				<?php endforeach; ?>
			</div>
		</section>

		<section class="dsv-listing" id="dsv-services" aria-labelledby="dsv-listing-title" data-reveal>
			<div class="dsv-section__head">
				<h2 id="dsv-listing-title" class="dsv-section__title">
					<?php
					if ( $search ) {
						/* translators: %s: search query */
						printf( esc_html__( 'Results for “%s”', 'dejoiy' ), esc_html( $search ) );
					} elseif ( $svc_cat ) {
						esc_html_e( 'Services in this category', 'dejoiy' );
					} else {
						esc_html_e( 'Featured services', 'dejoiy' );
					}
					?>
				</h2>
				<?php if ( $svc_cat || $search ) : ?>
					<a class="dsv-clear" href="<?php echo esc_url( dejoiy_services_base_url() . '#dsv-services' ); ?>"><?php esc_html_e( 'Clear filters', 'dejoiy' ); ?></a>
				<?php endif; ?>
			</div>
			<div class="dsv-listing__grid" id="dsv-listing-grid">
				<?php
				if ( $query->have_posts() ) {
					while ( $query->have_posts() ) {
						$query->the_post();
						$pid = get_the_ID();
						if ( dejoiy_services_is_product( $pid ) ) {
							echo dejoiy_services_render_service_card( $pid ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
						}
					}
					wp_reset_postdata();
				} else {
					echo '<p class="dsv-empty">' . esc_html__( 'No services match your filters yet. Try another category or search.', 'dejoiy' ) . '</p>';
				}
				?>
			</div>
			<?php if ( $query->max_num_pages > 1 ) : ?>
				<nav class="dsv-pagination" aria-label="<?php esc_attr_e( 'Services pagination', 'dejoiy' ); ?>">
					<?php
					echo wp_kses_post(
						paginate_links(
							array(
								'total'   => $query->max_num_pages,
								'current' => max( 1, (int) get_query_var( 'paged' ) ),
								'format'  => '?paged=%#%',
							)
						)
					);
					?>
				</nav>
			<?php endif; ?>
		</section>
	</div>

	<div class="dsv-filter-sheet" id="dsv-filter-sheet" hidden>
		<div class="dsv-filter-sheet__panel" role="dialog" aria-label="<?php esc_attr_e( 'Service filters', 'dejoiy' ); ?>">
			<header class="dsv-filter-sheet__head">
				<strong><?php esc_html_e( 'Categories', 'dejoiy' ); ?></strong>
				<button type="button" class="dsv-filter-sheet__close" id="dsv-filter-close" aria-label="<?php esc_attr_e( 'Close', 'dejoiy' ); ?>">×</button>
			</header>
			<div class="dsv-filter-sheet__list">
				<a class="dsv-filter-sheet__item<?php echo '' === $svc_cat ? ' is-active' : ''; ?>" href="<?php echo esc_url( dejoiy_services_listing_url( '' ) ); ?>"><?php esc_html_e( 'All services', 'dejoiy' ); ?></a>
				<?php foreach ( dejoiy_services_category_cards() as $card ) : ?>
					<a class="dsv-filter-sheet__item<?php echo $svc_cat === $card['key'] ? ' is-active' : ''; ?>" href="<?php echo esc_url( dejoiy_services_listing_url( $card['key'] ) ); ?>"><?php echo esc_html( $card['title'] ); ?></a>
				<?php endforeach; ?>
			</div>
		</div>
	</div>
	<?php
	return (string) ob_get_clean();
}

/**
 * Single service viewer (not default WooCommerce template).
 *
 * @param int $product_id Product ID.
 * @return string
 */
function dejoiy_services_viewer_html( $product_id ) {
	$product_id = (int) $product_id;
	$product    = function_exists( 'wc_get_product' ) ? wc_get_product( $product_id ) : null;
	if ( ! $product || ! dejoiy_services_is_product( $product_id ) ) {
		return dejoiy_services_landing_html();
	}

	$cover    = get_the_post_thumbnail_url( $product_id, 'large' );
	$gallery  = $product->get_gallery_image_ids();
	$seller   = function_exists( 'dejoiy_universe_seller_label' ) ? dejoiy_universe_seller_label( $product_id ) : '';
	$vendor   = (int) get_post_field( 'post_author', $product_id );
	$store    = ( $vendor && function_exists( 'wcfmmp_get_store_url' ) ) ? wcfmmp_get_store_url( $vendor ) : '';
	$delivery = dejoiy_services_delivery_label( $product_id );
	$rating   = dejoiy_services_rating_html( $product_id );
	$dpin     = function_exists( 'dejoiy_display_product_dpin' ) ? dejoiy_display_product_dpin( $product_id ) : '';
	$desc     = $product->get_description() ?: $product->get_short_description();
	$atc_url  = $product->add_to_cart_url();

	ob_start();
	?>
	<div class="dsv-app dsv-app--viewer" id="dejoiy-services-viewer">
		<main class="dsv-viewer" data-reveal>
			<p class="dsv-viewer__crumb"><a href="<?php echo esc_url( dejoiy_services_base_url() ); ?>">&larr; <?php esc_html_e( 'All Services', 'dejoiy' ); ?></a></p>
			<div class="dsv-viewer__layout">
				<div class="dsv-viewer__gallery">
					<?php if ( $cover ) : ?>
						<img class="dsv-viewer__img" src="<?php echo esc_url( $cover ); ?>" alt="<?php echo esc_attr( $product->get_name() ); ?>" loading="eager" decoding="async" />
					<?php endif; ?>
					<?php foreach ( array_slice( $gallery, 0, 4 ) as $gid ) : ?>
						<?php $gurl = wp_get_attachment_image_url( (int) $gid, 'medium' ); ?>
						<?php if ( $gurl ) : ?>
							<img class="dsv-viewer__thumb" src="<?php echo esc_url( $gurl ); ?>" alt="" loading="lazy" decoding="async" />
						<?php endif; ?>
					<?php endforeach; ?>
				</div>
				<div class="dsv-viewer__summary">
					<span class="dsv-viewer__badge">💼 <?php esc_html_e( 'Services', 'dejoiy' ); ?></span>
					<h1 class="dsv-viewer__title"><?php echo esc_html( $product->get_name() ); ?></h1>
					<?php if ( $dpin ) : ?>
						<p class="dsv-viewer__dpin"><?php echo esc_html( $dpin ); ?></p>
					<?php endif; ?>
					<p class="dsv-viewer__price"><?php echo wp_kses_post( $product->get_price_html() ); ?></p>
					<?php echo $rating; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?>
					<p class="dsv-viewer__delivery"><?php echo esc_html( $delivery ); ?></p>
					<p class="dsv-viewer__seller">
						<?php esc_html_e( 'Provider:', 'dejoiy' ); ?>
						<?php if ( $store ) : ?>
							<a href="<?php echo esc_url( $store ); ?>"><?php echo esc_html( $seller ); ?></a>
						<?php else : ?>
							<?php echo esc_html( $seller ); ?>
						<?php endif; ?>
					</p>
					<?php if ( $desc ) : ?>
						<div class="dsv-viewer__desc"><?php echo wp_kses_post( wpautop( $desc ) ); ?></div>
					<?php endif; ?>
					<div class="dsv-viewer__actions">
						<?php if ( $product->is_purchasable() && $product->is_in_stock() ) : ?>
							<button type="button" class="dsv-btn dsv-btn--primary" data-dsv-book="<?php echo esc_attr( (string) $product_id ); ?>"><?php esc_html_e( 'Book this service', 'dejoiy' ); ?></button>
						<?php endif; ?>
						<a href="<?php echo esc_url( dejoiy_services_base_url() ); ?>" class="dsv-btn dsv-btn--ghost"><?php esc_html_e( 'Browse more', 'dejoiy' ); ?></a>
					</div>
				</div>
			</div>
		</main>

		<section class="dsv-listing dsv-listing--related" aria-labelledby="dsv-related-title" data-reveal>
			<h2 id="dsv-related-title" class="dsv-section__title"><?php esc_html_e( 'More services you may like', 'dejoiy' ); ?></h2>
			<div class="dsv-listing__grid">
				<?php
				$related = dejoiy_services_query_products(
					array(
						'posts_per_page' => 4,
						'post__not_in'   => array( $product_id ),
						'orderby'        => 'rand',
					)
				);
				while ( $related->have_posts() ) {
					$related->the_post();
					echo dejoiy_services_render_service_card( get_the_ID() ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
				}
				wp_reset_postdata();
				?>
			</div>
		</section>
	</div>
	<?php
	return (string) ob_get_clean();
}

/**
 * Global booking modal markup (lazy-filled via JS).
 *
 * @return string
 */
function dejoiy_services_booking_modal_html() {
	ob_start();
	?>
	<div class="dsv-booking" id="dsv-booking" hidden aria-hidden="true">
		<div class="dsv-booking__backdrop" data-dsv-booking-close></div>
		<div class="dsv-booking__panel" role="dialog" aria-modal="true" aria-labelledby="dsv-booking-title">
			<header class="dsv-booking__head">
				<div class="dsv-booking__head-text">
					<p class="dsv-booking__eyebrow"><?php esc_html_e( 'DEJOIY Services', 'dejoiy' ); ?></p>
					<h2 id="dsv-booking-title" class="dsv-booking__title"><?php esc_html_e( 'Book this service', 'dejoiy' ); ?></h2>
				</div>
				<button type="button" class="dsv-booking__close" data-dsv-booking-close aria-label="<?php esc_attr_e( 'Close', 'dejoiy' ); ?>">×</button>
			</header>
			<div class="dsv-booking__loader" id="dsv-booking-loader" hidden>
				<span class="dsv-booking__spinner"></span>
				<p><?php esc_html_e( 'Loading service details…', 'dejoiy' ); ?></p>
			</div>
			<form class="dsv-booking__form" id="dsv-booking-form" hidden enctype="multipart/form-data">
				<input type="hidden" name="product_id" id="dsv-booking-product-id" value="" />
				<input type="hidden" name="service_type" id="dsv-booking-service-type" value="" />
				<input type="hidden" name="price_type" id="dsv-booking-price-type" value="fixed" />

				<div class="dsv-booking__summary" id="dsv-booking-summary"></div>

				<div class="dsv-booking__field">
					<label for="dsv-booking-delivery"><?php esc_html_e( 'Delivery timeline', 'dejoiy' ); ?></label>
					<select id="dsv-booking-delivery" name="delivery_timeline">
						<option value=""><?php esc_html_e( 'Use default delivery', 'dejoiy' ); ?></option>
						<option value="Express (1–2 days)"><?php esc_html_e( 'Express (1–2 days)', 'dejoiy' ); ?></option>
						<option value="Standard (3–7 days)"><?php esc_html_e( 'Standard (3–7 days)', 'dejoiy' ); ?></option>
						<option value="Extended (7–14 days)"><?php esc_html_e( 'Extended (7–14 days)', 'dejoiy' ); ?></option>
					</select>
				</div>

				<div class="dsv-booking__fields dsv-booking__fields--design" data-type="design" hidden>
					<div class="dsv-booking__field">
						<label for="dsv-req-design"><?php esc_html_e( 'Requirements', 'dejoiy' ); ?> <span class="req">*</span></label>
						<textarea id="dsv-req-design" name="requirements" rows="4" placeholder="<?php esc_attr_e( 'Describe what you need designed…', 'dejoiy' ); ?>"></textarea>
					</div>
					<div class="dsv-booking__field">
						<label for="dsv-brand"><?php esc_html_e( 'Brand name', 'dejoiy' ); ?></label>
						<input type="text" id="dsv-brand" name="brand_name" />
					</div>
					<div class="dsv-booking__field">
						<label for="dsv-files-design"><?php esc_html_e( 'Reference files', 'dejoiy' ); ?></label>
						<input type="file" id="dsv-files-design" name="booking_files[]" accept="image/*,.pdf,.zip" multiple />
					</div>
				</div>

				<div class="dsv-booking__fields dsv-booking__fields--development" data-type="development" hidden>
					<div class="dsv-booking__field">
						<label for="dsv-proj-desc"><?php esc_html_e( 'Project description', 'dejoiy' ); ?> <span class="req">*</span></label>
						<textarea id="dsv-proj-desc" name="project_description" rows="4"></textarea>
					</div>
					<div class="dsv-booking__field">
						<label for="dsv-tech"><?php esc_html_e( 'Tech stack preference', 'dejoiy' ); ?></label>
						<input type="text" id="dsv-tech" name="tech_stack" placeholder="WordPress, React, PHP…" />
					</div>
					<div class="dsv-booking__field">
						<label for="dsv-deadline"><?php esc_html_e( 'Deadline', 'dejoiy' ); ?></label>
						<input type="date" id="dsv-deadline" name="deadline" />
					</div>
					<div class="dsv-booking__field">
						<label for="dsv-files-dev"><?php esc_html_e( 'Project files', 'dejoiy' ); ?></label>
						<input type="file" id="dsv-files-dev" name="booking_files[]" accept="image/*,.pdf,.zip,.doc,.docx" multiple />
					</div>
				</div>

				<div class="dsv-booking__fields dsv-booking__fields--marketing dsv-booking__fields--business dsv-booking__fields--personal" data-type="business" hidden>
					<div class="dsv-booking__field">
						<label for="dsv-consult"><?php esc_html_e( 'Consultation details', 'dejoiy' ); ?></label>
						<textarea id="dsv-consult" name="consultation_details" rows="4"></textarea>
					</div>
					<div class="dsv-booking__field">
						<label for="dsv-slot"><?php esc_html_e( 'Preferred meeting slot', 'dejoiy' ); ?></label>
						<input type="text" id="dsv-slot" name="meeting_slot" placeholder="<?php esc_attr_e( 'e.g. Mon 10am IST', 'dejoiy' ); ?>" />
					</div>
				</div>

				<div class="dsv-booking__field">
					<label for="dsv-notes"><?php esc_html_e( 'Additional notes', 'dejoiy' ); ?></label>
					<textarea id="dsv-notes" name="customer_notes" rows="2"></textarea>
				</div>

				<p class="dsv-booking__error" id="dsv-booking-error" hidden role="alert"></p>

				<footer class="dsv-booking__foot">
					<button type="button" class="dsv-btn dsv-btn--ghost" data-dsv-booking-close><?php esc_html_e( 'Cancel', 'dejoiy' ); ?></button>
					<button type="submit" class="dsv-btn dsv-btn--primary" id="dsv-booking-submit"><?php esc_html_e( 'Confirm booking', 'dejoiy' ); ?></button>
				</footer>
			</form>
		</div>
	</div>
	<?php
	return (string) ob_get_clean();
}

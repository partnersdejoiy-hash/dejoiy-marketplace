/**
 * Dock category links.
 *
 * @return string
 */
function dejoiy_studio_universe_dock_items() {
	$items = array(
		array( '🖼', 'Posters', 'https://dejoiy.tech/product-category/customized-products/' ),
		array( '🎁', 'Gift Boxes', 'https://dejoiy.tech/product-category/customized-products/corporate-gifts/' ),
		array( '🧢', 'Caps', 'https://dejoiy.tech/product-category/customized-products/' ),
		array( '👕', 'Custom T-Shirts', 'https://dejoiy.tech/product-category/customized-products/custom-t-shirts/' ),
		array( '📱', 'Phone Cases', 'https://dejoiy.tech/product-category/customized-products/phone-cases/' ),
		array( '☕', 'Mugs', 'https://dejoiy.tech/product-category/customized-products/mugs/' ),
		array( '🎒', 'Backpacks', 'https://dejoiy.tech/product-category/customized-products/' ),
		array( '📚', 'Notebooks', 'https://dejoiy.tech/product-category/customized-products/' ),
	);
	$html = '';
	foreach ( $items as $item ) {
		$html .= sprintf(
			'<a href="%s" class="dsu-dock-item"><span class="dsu-dock-ico">%s</span><span class="dsu-dock-txt">%s</span></a>',
			esc_url( $item[2] ),
			esc_html( $item[0] ),
			esc_html( $item[1] )
		);
	}
	return $html . $html;
}

/**
 * Query studio products.
 *
 * @return array<int, WP_Post>
 */
function dejoiy_studio_universe_products() {
	$args = array(
		'post_type'      => 'product',
		'posts_per_page' => 12,
		'post_status'    => 'publish',
		'tax_query'      => array( // phpcs:ignore WordPress.DB.SlowDBQuery.slow_db_query_tax_query
			array(
				'taxonomy' => 'product_cat',
				'field'    => 'term_id',
				'terms'    => array( 143, 153, 154, 155, 156 ),
				'operator' => 'IN',
			),
		),
	);
	$q = new WP_Query( $args );
	if ( ! $q->have_posts() ) {
		$q = new WP_Query(
			array(
				'post_type'      => 'product',
				'posts_per_page' => 12,
				'post_status'    => 'publish',
			)
		);
	}
	$posts = $q->posts;
	wp_reset_postdata();
	return is_array( $posts ) ? $posts : array();
}

/**
 * Product wall markup.
 *
 * @param array<int, WP_Post> $posts Posts.
 * @return string
 */
function dejoiy_studio_universe_product_wall( $posts ) {
	$html = '';
	foreach ( $posts as $p ) {
		$id    = $p->ID;
		$title = get_the_title( $id );
		$link  = get_permalink( $id );
		$img   = get_the_post_thumbnail_url( $id, 'medium_large' );
		if ( ! $img && function_exists( 'wc_placeholder_img_src' ) ) {
			$img = wc_placeholder_img_src();
		}
		$html .= sprintf(
			'<a href="%s" class="dsu-wall-card" data-dsu-reveal><div class="dsu-wall-img" style="background-image:url(%s)"></div><div class="dsu-wall-meta"><h3>%s</h3><span>Customize →</span></div></a>',
			esc_url( $link ),
			esc_url( $img ),
			esc_html( $title )
		);
	}
	return $html;
}

/**
 * Showcase strip markup.
 *
 * @param array<int, WP_Post> $posts Posts.
 * @return string
 */
function dejoiy_studio_universe_showcase( $posts ) {
	$html = '';
	foreach ( array_slice( $posts, 0, 8 ) as $p ) {
		$id    = $p->ID;
		$title = get_the_title( $id );
		$img   = get_the_post_thumbnail_url( $id, 'thumbnail' );
		if ( ! $img && function_exists( 'wc_placeholder_img_src' ) ) {
			$img = wc_placeholder_img_src();
		}
		$html .= sprintf(
			'<div class="dsu-show-card"><img src="%s" alt="%s" loading="lazy" width="120" height="120"><p>%s</p></div>',
			esc_url( $img ),
			esc_attr( $title ),
			esc_html( $title )
		);
	}
	return $html . $html;
}

<?php
/**
 * DEJOIY Desktop Marketplace Header — premium standalone chrome (≥1025px).
 *
 * Premium standalone chrome on all pages (desktop/laptop ≥1025px) except dedicated
 * ecosystem landings (Nexus, Refurbished, Custom Studio, Services, QuickMart).
 * Mobile/tablet use Mobile OS (≤1024px).
 * Disable: define( 'DEJOIY_DM_HEADER_DISABLED', true );
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

define( 'DEJOIY_DM_HEADER_VERSION', '1.3.1' );

/**
 * Ecosystem pages with their own dedicated chrome (Nexus, Refurbished, Studio, Services, QuickMart).
 *
 * @return bool
 */
function dejoiy_desktop_marketplace_is_dedicated_ecosystem_page() {
	if ( function_exists( 'dejoiy_mobile_os_is_dedicated_page' ) ) {
		return dejoiy_mobile_os_is_dedicated_page();
	}

	if ( is_admin() ) {
		return false;
	}

	$uri = strtolower( (string) wp_unslash( $_SERVER['REQUEST_URI'] ?? '' ) );
	$needles = array(
		'dejoiy-custom-studio',
		'dejoiy-quick-mart',
		'dejoiy-services',
		'dejoiy-refurbished',
		'dejoiy-library',
		'dejoiy_library=1',
	);

	foreach ( $needles as $needle ) {
		if ( false !== strpos( $uri, $needle ) ) {
			return true;
		}
	}

	if ( is_page() ) {
		$slug = (string) get_post_field( 'post_name', get_queried_object_id() );
		$dedicated = array(
			'dejoiy-custom-studio',
			'dejoiy-quick-mart',
			'dejoiy-services',
			'dejoiy-refurbished',
			'dejoiy-library',
		);
		if ( in_array( $slug, $dedicated, true ) ) {
			return true;
		}
	}

	return (bool) apply_filters( 'dejoiy_desktop_marketplace_is_dedicated_ecosystem_page', false );
}

/**
 * @return bool
 */
function dejoiy_desktop_marketplace_header_enabled() {
	if ( defined( 'DEJOIY_DM_HEADER_DISABLED' ) && DEJOIY_DM_HEADER_DISABLED ) {
		return false;
	}
	if ( is_admin() && ! wp_doing_ajax() ) {
		return false;
	}
	if ( function_exists( 'wp_is_json_request' ) && wp_is_json_request() ) {
		return false;
	}
	if ( ! function_exists( 'dejoiy_evolution_is_enabled' ) || ! dejoiy_evolution_is_enabled() ) {
		return false;
	}
	if ( dejoiy_desktop_marketplace_is_dedicated_ecosystem_page() ) {
		return false;
	}
	if ( function_exists( 'is_checkout' ) && is_checkout() && ! is_wc_endpoint_url( 'order-received' ) ) {
		return false;
	}
	return true;
}

/**
 * Whether the standalone marketplace header replaces theme chrome (desktop/laptop).
 *
 * @return bool
 */
function dejoiy_desktop_marketplace_should_bootstrap_standalone() {
	if ( ! dejoiy_desktop_marketplace_header_enabled() ) {
		return false;
	}
	if ( apply_filters( 'dejoiy_desktop_marketplace_skip_standalone', false ) ) {
		return false;
	}
	if ( apply_filters( 'dejoiy_desktop_marketplace_force_standalone', false ) ) {
		return true;
	}
	/**
	 * Default: all non-dedicated pages use the marketplace header on desktop/laptop.
	 * Dedicated ecosystem landings keep their own headers.
	 */
	return (bool) apply_filters( 'dejoiy_desktop_marketplace_should_bootstrap_standalone', true );
}

/**
 * @return bool
 */
function dejoiy_desktop_marketplace_standalone_is_active() {
	if ( ! dejoiy_desktop_marketplace_should_bootstrap_standalone() ) {
		return false;
	}
	return ! dejoiy_desktop_marketplace_is_mobile_client();
}

/**
 * Phone/tablet user-agent guard (viewport CSS is the source of truth for laptops).
 *
 * @return bool
 */
function dejoiy_desktop_marketplace_is_mobile_client() {
	return function_exists( 'wp_is_mobile' ) && wp_is_mobile();
}


if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * Seller hub URL (WCFM / fallback).
 */
function dejoiy_header_os_v4_seller_hub_url() {
	if ( function_exists( 'wcfm_get_dashboard_url' ) ) {
		return wcfm_get_dashboard_url();
	}
	if ( function_exists( 'get_wcfm_page' ) ) {
		return get_wcfm_page();
	}
	return home_url( '/store-manager/' );
}

/**
 * Current customer display name for header greeting.
 */
function dejoiy_header_os_v4_customer_name() {
	if ( ! is_user_logged_in() ) {
		return '';
	}
	$user = wp_get_current_user();
	$name = trim( (string) $user->first_name );
	if ( '' === $name ) {
		$name = trim( (string) $user->display_name );
	}
	if ( '' === $name ) {
		$name = trim( (string) $user->user_login );
	}
	return $name;
}

/**
 * @return array<int, array{label: string, url: string, key: string}>
 */
function dejoiy_header_os_v4_account_menu() {
	$account = home_url( '/my-account/' );
	$items   = array(
		array(
			'key'   => 'account',
			'label' => 'My Account',
			'url'   => $account,
		),
		array(
			'key'   => 'orders',
			'label' => 'My Orders',
			'url'   => function_exists( 'wc_get_account_endpoint_url' )
				? wc_get_account_endpoint_url( 'orders' )
				: $account,
		),
		array(
			'key'   => 'favorites',
			'label' => 'Favorites',
			'url'   => home_url( '/my-account/?et-wishlist-page' ),
		),
		array(
			'key'   => 'seller',
			'label' => 'Seller Hub',
			'url'   => dejoiy_header_os_v4_seller_hub_url(),
		),
		array(
			'key'   => 'settings',
			'label' => 'Settings',
			'url'   => function_exists( 'wc_get_account_endpoint_url' )
				? wc_get_account_endpoint_url( 'edit-account' )
				: $account,
		),
	);

	if ( is_user_logged_in() ) {
		$items[] = array(
			'key'   => 'logout',
			'label' => 'Logout',
			'url'   => wp_logout_url( home_url( '/' ) ),
		);
	} else {
		$items[] = array(
			'key'   => 'login',
			'label' => 'Sign In',
			'url'   => $account,
		);
	}

	return $items;
}


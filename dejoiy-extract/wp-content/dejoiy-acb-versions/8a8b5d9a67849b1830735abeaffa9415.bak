/* DEJOIY CUSTOM STUDIO UNIVERSE v9 — high contrast, cinematic */
:root {
  --dsu-black: #000000;
  --dsu-gold: #ffd700;
  --dsu-gold-2: #f5c542;
  --dsu-white: #ffffff;
  --dsu-glow: #ffe066;
  --dsu-success: #00ffb3;
  --dsu-font: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

body.dejoiy-studio-universe-active .elementor,
body.dejoiy-studio-universe-active .site-content > .elementor {
  display: none !important;
}

body.dejoiy-studio-universe-active {
  background: var(--dsu-black) !important;
  color: var(--dsu-white) !important;
}

.dsu-root {
  --mx: 0;
  --my: 0;
  position: relative;
  z-index: 5;
  background: var(--dsu-black);
  color: var(--dsu-white);
  font-family: var(--dsu-font);
  overflow-x: clip;
  min-height: 100vh;
}

.dsu-noise {
  pointer-events: none;
  position: fixed;
  inset: 0;
  z-index: 1;
  opacity: 0.04;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* ── HERO ── */
.dsu-hero {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
  display: grid;
  place-items: center;
  overflow: hidden;
  isolation: isolate;
}

#dsu-hero-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.dsu-hero-beams {
  position: absolute;
  inset: -20%;
  z-index: 1;
  background:
    conic-gradient(from 210deg at 50% 50%, transparent 0deg, rgba(255, 215, 0, 0.14) 40deg, transparent 80deg),
    conic-gradient(from 30deg at 60% 40%, transparent 0deg, rgba(255, 224, 102, 0.1) 50deg, transparent 100deg);
  filter: blur(40px);
  animation: dsuBeamSpin 24s linear infinite;
  pointer-events: none;
}

@keyframes dsuBeamSpin {
  to { transform: rotate(360deg); }
}

.dsu-hero-particles {
  position: absolute;
  inset: 0;
  z-index: 2;
  background-image:
    radial-gradient(1px 1px at 10% 20%, var(--dsu-glow) 0, transparent 100%),
    radial-gradient(1px 1px at 80% 30%, var(--dsu-gold) 0, transparent 100%),
    radial-gradient(1.5px 1.5px at 40% 70%, var(--dsu-white) 0, transparent 100%),
    radial-gradient(1px 1px at 65% 85%, var(--dsu-glow) 0, transparent 100%);
  background-size: 100% 100%;
  opacity: 0.55;
  animation: dsuParticleDrift 18s ease-in-out infinite alternate;
  pointer-events: none;
}

@keyframes dsuParticleDrift {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-2%, 3%, 0); }
}

.dsu-hero-ui {
  position: relative;
  z-index: 10;
  text-align: center;
  padding: clamp(80px, 12vh, 140px) clamp(20px, 5vw, 48px) clamp(160px, 18vh, 200px);
  max-width: 920px;
  transform: translate3d(calc(var(--mx) * 8px), calc(var(--my) * 6px), 0);
  will-change: transform;
}

.dsu-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 20px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.28em;
  color: var(--dsu-gold);
  text-transform: uppercase;
}

.dsu-pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--dsu-success);
  box-shadow: 0 0 12px var(--dsu-success);
  animation: dsuPulse 1.8s ease-in-out infinite;
}

@keyframes dsuPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.35); opacity: 0.7; }
}

.dsu-h1 {
  margin: 0 0 24px;
  font-weight: 900;
  line-height: 1.02;
  letter-spacing: -0.03em;
  font-size: clamp(42px, 8vw, 110px);
}

.dsu-h1-line {
  display: block;
  color: var(--dsu-white);
  text-shadow:
    0 0 40px rgba(255, 215, 0, 0.35),
    0 0 80px rgba(255, 224, 102, 0.2),
    0 4px 24px rgba(0, 0, 0, 0.8);
}

.dsu-h1-gold {
  background: linear-gradient(105deg, var(--dsu-white) 0%, var(--dsu-gold) 45%, var(--dsu-gold-2) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 28px rgba(255, 215, 0, 0.55));
}

.dsu-sub {
  margin: 0 auto 36px;
  max-width: 700px;
  font-size: clamp(16px, 2.2vw, 20px);
  font-weight: 500;
  line-height: 1.65;
  color: var(--dsu-white);
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9);
}

.dsu-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: center;
  align-items: center;
}

.dsu-ctas-center { margin-top: 8px; }

.dsu-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  padding: 0 28px;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-decoration: none !important;
  transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  overflow: hidden;
  border: 2px solid transparent;
}

.dsu-btn-primary {
  background: linear-gradient(135deg, var(--dsu-gold-2), var(--dsu-gold));
  color: #000 !important;
  box-shadow: 0 8px 32px rgba(255, 215, 0, 0.45), 0 0 0 1px rgba(255, 224, 102, 0.5) inset;
}

.dsu-btn-primary::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
  transform: translateX(-120%);
  transition: transform 0.6s ease;
}

.dsu-btn-primary:hover::after { transform: translateX(120%); }

.dsu-btn-primary:hover {
  transform: scale(1.05) translateY(-2px);
  box-shadow: 0 14px 48px rgba(255, 215, 0, 0.6);
}

.dsu-btn-ghost {
  background: transparent;
  color: var(--dsu-white) !important;
  border-color: var(--dsu-gold);
  box-shadow: 0 0 24px rgba(255, 215, 0, 0.15);
}

.dsu-btn-ghost:hover {
  color: var(--dsu-gold) !important;
  box-shadow: 0 0 36px rgba(255, 215, 0, 0.45);
  transform: scale(1.03);
}

.dsu-home-cta {
  position: relative;
  z-index: 100;
}

.dsu-core-label {
  position: absolute;
  bottom: 28%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.35em;
  color: var(--dsu-gold);
  text-shadow: 0 0 20px rgba(255, 215, 0, 0.8);
  pointer-events: none;
}

/* ── DOCK ── */
.dsu-dock {
  position: fixed;
  left: 50%;
  bottom: clamp(12px, 2vh, 24px);
  transform: translateX(-50%);
  z-index: 90;
  width: min(96vw, 1100px);
  padding: 10px 12px;
  border-radius: 20px;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(255, 215, 0, 0.45);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6), 0 0 40px rgba(255, 215, 0, 0.12);
}

.dsu-dock-track {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.dsu-dock-track::-webkit-scrollbar { display: none; }

.dsu-dock-item {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 215, 0, 0.35);
  color: var(--dsu-white) !important;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none !important;
  white-space: nowrap;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.dsu-dock-item:hover {
  transform: translateY(-3px) scale(1.04);
  border-color: var(--dsu-gold);
  box-shadow: 0 0 28px rgba(255, 215, 0, 0.4);
  color: var(--dsu-gold) !important;
}

.dsu-dock-ico { font-size: 16px; }

/* ── JOI ORB ── */
.dsu-joi {
  position: fixed;
  left: clamp(12px, 2vw, 28px);
  bottom: clamp(88px, 12vh, 120px);
  z-index: 95;
  width: 64px;
  height: 64px;
  border: none;
  background: transparent;
  cursor: pointer;
  padding: 0;
}

.dsu-joi-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid rgba(255, 215, 0, 0.35);
  animation: dsuJoiRing 3s ease-in-out infinite;
}

.dsu-joi-ring-2 { animation-delay: -1.2s; inset: -6px; }

@keyframes dsuJoiRing {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.12); opacity: 1; }
}

.dsu-joi-core {
  position: absolute;
  inset: 12px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--dsu-glow), var(--dsu-gold) 45%, #b8860b 100%);
  box-shadow: 0 0 32px rgba(255, 215, 0, 0.7), 0 0 64px rgba(0, 255, 179, 0.25);
  animation: dsuJoiBreath 2.4s ease-in-out infinite;
}

.dsu-joi-pulse {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid var(--dsu-success);
  opacity: 0;
  animation: dsuJoiVoice 2s ease-out infinite;
}

@keyframes dsuJoiBreath {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

@keyframes dsuJoiVoice {
  0% { transform: scale(0.8); opacity: 0.8; }
  100% { transform: scale(1.5); opacity: 0; }
}

/* ── SECTIONS ── */
.dsu-sec {
  position: relative;
  z-index: 6;
  padding: clamp(80px, 12vh, 140px) clamp(20px, 5vw, 48px);
  background: var(--dsu-black);
}

.dsu-sec-in {
  max-width: 1280px;
  margin: 0 auto;
}

.dsu-lbl {
  display: block;
  margin-bottom: 12px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.3em;
  color: var(--dsu-gold);
}

.dsu-sec-title {
  margin: 0 0 16px;
  font-size: clamp(32px, 5vw, 56px);
  font-weight: 900;
  color: var(--dsu-white);
  text-shadow: 0 0 32px rgba(255, 215, 0, 0.25);
}

.dsu-sec-desc {
  margin: 0 0 40px;
  max-width: 640px;
  font-size: 18px;
  font-weight: 500;
  color: var(--dsu-white);
  line-height: 1.6;
}

/* Product wall */
.dsu-wall {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  gap: 20px;
}

.dsu-wall-card {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(255, 215, 0, 0.3);
  background: #0a0a0a;
  text-decoration: none !important;
  transform-style: preserve-3d;
  transition: transform 0.45s ease, box-shadow 0.45s ease;
}

.dsu-wall-card:hover {
  transform: translateY(-8px) rotateX(4deg);
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5), 0 0 40px rgba(255, 215, 0, 0.25);
}

.dsu-wall-img {
  aspect-ratio: 1;
  background-size: cover;
  background-position: center;
}

.dsu-wall-meta {
  padding: 16px;
}

.dsu-wall-meta h3 {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 800;
  color: var(--dsu-white);
}

.dsu-wall-meta span {
  font-size: 13px;
  font-weight: 700;
  color: var(--dsu-gold);
}

/* AI section */
.dsu-ai-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 40px;
  align-items: center;
}

.dsu-ai-terminal {
  border-radius: 20px;
  border: 1px solid rgba(255, 215, 0, 0.4);
  background: linear-gradient(160deg, #0a0a0a, #111);
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6), 0 0 48px rgba(255, 215, 0, 0.12);
}

.dsu-ai-bar {
  display: flex;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(255, 215, 0, 0.08);
}

.dsu-ai-bar span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--dsu-gold);
}

.dsu-ai-log {
  margin: 0;
  padding: 16px 20px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--dsu-success);
  min-height: 120px;
  white-space: pre-wrap;
}

.dsu-ai-preview {
  height: 180px;
  margin: 0 16px 16px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(0, 255, 179, 0.15));
  border: 1px solid rgba(255, 215, 0, 0.35);
  animation: dsuAiShimmer 3s ease-in-out infinite;
}

@keyframes dsuAiShimmer {
  0%, 100% { filter: hue-rotate(0deg) brightness(1); }
  50% { filter: hue-rotate(20deg) brightness(1.15); }
}

/* Mockups */
.dsu-mockup-stage {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24px;
  min-height: 320px;
  perspective: 1200px;
}

.dsu-mockup {
  width: clamp(100px, 22vw, 200px);
  height: clamp(140px, 30vw, 280px);
  border-radius: 24px;
  border: 2px solid rgba(255, 215, 0, 0.45);
  background: linear-gradient(145deg, #1a1a1a, #000);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 32px rgba(255, 215, 0, 0.2);
  animation: dsuMockSpin 12s linear infinite;
}

.dsu-mockup-b { animation-duration: 14s; animation-direction: reverse; }
.dsu-mockup-c { animation-duration: 16s; }

@keyframes dsuMockSpin {
  0% { transform: rotateY(0deg) rotateX(8deg); }
  100% { transform: rotateY(360deg) rotateX(8deg); }
}

/* Why cards */
.dsu-why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.dsu-why-card {
  padding: 28px;
  border-radius: 20px;
  border: 1px solid rgba(255, 215, 0, 0.35);
  background: linear-gradient(160deg, rgba(255, 215, 0, 0.08), rgba(0, 0, 0, 0.9));
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.dsu-why-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 0 40px rgba(255, 215, 0, 0.25);
}

.dsu-why-card h3 {
  margin: 0 0 10px;
  font-size: 18px;
  font-weight: 800;
  color: var(--dsu-gold);
}

.dsu-why-card p {
  margin: 0;
  font-size: 15px;
  font-weight: 500;
  color: var(--dsu-white);
  line-height: 1.55;
}

/* Showcase */
.dsu-showcase-track {
  display: flex;
  gap: 20px;
  overflow: hidden;
  animation: dsuShowScroll 32s linear infinite;
}

@keyframes dsuShowScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.dsu-show-card {
  flex: 0 0 auto;
  width: 160px;
  padding: 16px;
  border-radius: 16px;
  border: 1px solid rgba(255, 215, 0, 0.3);
  background: rgba(255, 255, 255, 0.03);
  text-align: center;
}

.dsu-show-card img {
  width: 100%;
  height: auto;
  border-radius: 12px;
  margin-bottom: 10px;
}

.dsu-show-card p {
  margin: 0;
  font-size: 12px;
  font-weight: 700;
  color: var(--dsu-white);
}

/* Final CTA */
.dsu-sec-final {
  text-align: center;
  background:
    radial-gradient(ellipse 80% 60% at 50% 100%, rgba(255, 215, 0, 0.18), transparent),
    var(--dsu-black);
}

.dsu-final-title {
  max-width: 900px;
  margin-inline: auto;
}

/* Reveal */
[data-dsu-reveal] {
  opacity: 0;
  transform: translateY(40px);
}

[data-dsu-reveal].dsu-in {
  opacity: 1;
  transform: none;
}

/* Tooltip for 3D orbit items */
.dsu-orbit-tip {
  position: fixed;
  z-index: 200;
  padding: 8px 14px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.9);
  border: 1px solid var(--dsu-gold);
  color: var(--dsu-white);
  font-size: 12px;
  font-weight: 700;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.dsu-orbit-tip.is-on { opacity: 1; }

/* Responsive */
@media (max-width: 900px) {
  .dsu-ai-grid { grid-template-columns: 1fr; }
  .dsu-mockup-stage { flex-wrap: wrap; }
  .dsu-core-label { display: none; }
}

@media (max-width: 640px) {
  .dsu-hero-ui { padding-bottom: 200px; }
  .dsu-dock { width: 94vw; }
  .dsu-joi { width: 52px; height: 52px; }
}

@media (prefers-reduced-motion: reduce) {
  .dsu-hero-beams,
  .dsu-hero-particles,
  .dsu-showcase-track,
  .dsu-mockup,
  .dsu-joi-ring,
  .dsu-joi-core,
  .dsu-joi-pulse { animation: none !important; }
  [data-dsu-reveal] { opacity: 1; transform: none; }
}

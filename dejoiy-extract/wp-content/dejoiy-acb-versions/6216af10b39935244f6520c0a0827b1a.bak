					<?php
					$best = dejoiy_library_query_books(
						array(
							'posts_per_page' => 8,
							'orderby'        => 'rand',
						)
					);
					foreach ( $best->posts as $p ) {
						echo dejoiy_library_render_book_card( $p ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
					}
					wp_reset_postdata();
					?>

/**
 * @return bool
 */
function dejoiy_mobile_home_v2_active() {
	if ( ! function_exists( 'dejoiy_universe_home_is_active' ) || ! dejoiy_universe_home_is_active() ) {
		return false;
	}
	return is_front_page();
}


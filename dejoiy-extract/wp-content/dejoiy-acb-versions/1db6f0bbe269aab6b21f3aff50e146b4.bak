<?php
/**
 * DEJOIY Desktop Marketplace Header — laptop/desktop only (≥1025px).
 *
 * Amazon-inspired layout (logo, delivery, search, account, cart + universe bar)
 * with DEJOIY branding. Does not affect phone/tablet (≤1024px).
 *
 * @package Dejoiy
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * @return bool
 */
function dejoiy_desktop_marketplace_header_enabled() {
	return false; /* Desktop uses Elementor #4228 only — separate from Mobile OS (≤1024px). */
	if ( is_admin() && ! wp_doing_ajax() ) {
		return false;
	}
	if ( function_exists( 'wp_is_json_request' ) && wp_is_json_request() ) {
		return false;
	}
	if ( function_exists( 'dejoiy_mobile_os_is_dedicated_page' ) && dejoiy_mobile_os_is_dedicated_page() ) {
		return false;
	}
	if ( function_exists( 'is_checkout' ) && is_checkout() && ! is_wc_endpoint_url( 'order-received' ) ) {
		return false;
	}
	return true;
}

/**
 * @return string
 */
function dejoiy_desktop_marketplace_delivery_label() {
	if ( function_exists( 'dejoiy_mobile_os_delivery_label' ) ) {
		return dejoiy_mobile_os_delivery_label();
	}
	return __( 'Set delivery location', 'dejoiy' );
}

/**
 * @return string
 */
function dejoiy_desktop_marketplace_delivery_url() {
	if ( function_exists( 'dejoiy_mobile_os_delivery_url' ) ) {
		return dejoiy_mobile_os_delivery_url();
	}
	return home_url( '/my-account/' );
}

/**
 * @return bool
 */
function dejoiy_desktop_marketplace_show_category_rail() {
	if ( is_front_page() ) {
		return true;
	}
	if ( function_exists( 'is_shop' ) && is_shop() ) {
		return true;
	}
	if ( function_exists( 'is_product_taxonomy' ) && is_product_taxonomy() ) {
		return true;
	}
	return false;
}

/**
 * @return array<string, mixed>
 */
function dejoiy_desktop_marketplace_header_config() {
	$account = home_url( '/my-account/' );
	$orders  = function_exists( 'wc_get_account_endpoint_url' )
		? wc_get_account_endpoint_url( 'orders' )
		: $account;

	$categories = array();
	if ( function_exists( 'dejoiy_mobile_os_market_categories' ) ) {
		foreach ( dejoiy_mobile_os_market_categories() as $cat ) {
			$categories[] = array(
				'label' => isset( $cat['label'] ) ? (string) $cat['label'] : '',
				'url'   => isset( $cat['url'] ) ? (string) $cat['url'] : '',
				'icon'  => isset( $cat['icon'] ) ? (string) $cat['icon'] : '',
			);
		}
	}

	return array(
		'cartCount'      => function_exists( 'dejoiy_mobile_os_get_cart_count' ) ? dejoiy_mobile_os_get_cart_count() : 0,
		'deliveryLabel'  => dejoiy_desktop_marketplace_delivery_label(),
		'deliveryUrl'    => dejoiy_desktop_marketplace_delivery_url(),
		'ordersUrl'      => $orders,
		'ordersLabel'    => __( 'Orders', 'dejoiy' ),
		'showCategories' => dejoiy_desktop_marketplace_show_category_rail(),
		'categories'     => $categories,
		'joiSearchLabel' => __( 'Ask JOI', 'dejoiy' ),
		'allWorldsLabel' => __( 'All Worlds', 'dejoiy' ),
	);
}

/**
 * @param array<int, string> $classes Body classes.
 * @return array<int, string>
 */
function dejoiy_desktop_marketplace_header_body_class( $classes ) {
	if ( dejoiy_desktop_marketplace_header_enabled() ) {
		$classes[] = 'dejoiy-dm-desktop-header';
	}
	return $classes;
}
add_filter( 'body_class', 'dejoiy_desktop_marketplace_header_body_class', 21 );

/**
 * Enqueue desktop-only assets.
 */
function dejoiy_desktop_marketplace_header_assets() {
	if ( ! dejoiy_desktop_marketplace_header_enabled() ) {
		return;
	}

	$dir = get_stylesheet_directory();
	$uri = get_stylesheet_directory_uri();
	$css = $dir . '/dejoiy-desktop-marketplace-header.css';
	$js  = $dir . '/dejoiy-desktop-marketplace-header.js';

	if ( is_readable( $css ) ) {
		wp_enqueue_style(
			'dejoiy-desktop-marketplace-header',
			$uri . '/dejoiy-desktop-marketplace-header.css',
			array( 'dejoiy-header-os-v4' ),
			(string) filemtime( $css ),
			'screen and (min-width: 1025px)'
		);
	}

	if ( is_readable( $js ) ) {
		wp_enqueue_script(
			'dejoiy-desktop-marketplace-header',
			$uri . '/dejoiy-desktop-marketplace-header.js',
			array(),
			(string) filemtime( $js ),
			true
		);
		wp_localize_script(
			'dejoiy-desktop-marketplace-header',
			'dejoiyDesktopHeader',
			dejoiy_desktop_marketplace_header_config()
		);
	}
}
add_action( 'wp_enqueue_scripts', 'dejoiy_desktop_marketplace_header_assets', 10060 );

/**
 * Standalone desktop header when Elementor header #4228 is not on the page (e.g. Universe home).
 *
 * @return string
 */
function dejoiy_desktop_marketplace_header_standalone_html() {
	$home    = home_url( '/' );
	$shop    = function_exists( 'wc_get_page_permalink' ) ? wc_get_page_permalink( 'shop' ) : home_url( '/shop/' );
	$cart    = function_exists( 'wc_get_cart_url' ) ? wc_get_cart_url() : home_url( '/cart/' );
	$account = home_url( '/my-account/' );
	$orders  = function_exists( 'wc_get_account_endpoint_url' ) ? wc_get_account_endpoint_url( 'orders' ) : $account;
	$fav     = home_url( '/my-account/?et-wishlist-page' );
	$logo    = '';
	if ( function_exists( 'get_custom_logo' ) ) {
		$logo = get_custom_logo();
	}
	if ( '' === $logo ) {
		$logo = '<a class="ddh-standalone__logo-text" href="' . esc_url( $home ) . '">DEJOIY</a>';
	}

	$v4 = function_exists( 'dejoiy_header_os_v4_config' ) ? dejoiy_header_os_v4_config() : array();
	$worlds = isset( $v4['universeNav'] ) ? $v4['universeNav'] : array();

	ob_start();
	?>
	<header id="dejoiy-desktop-marketplace-header" class="dejoiy-desktop-marketplace-header ddh-standalone" role="banner">
		<div class="ddh-accent-bar" aria-hidden="true"></div>
		<div class="ddh-standalone__row1">
			<div class="ddh-standalone__row1-inner">
				<div class="ddh-standalone__logo"><?php echo $logo; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?></div>
				<a class="ddh-deliver" href="<?php echo esc_url( dejoiy_desktop_marketplace_delivery_url() ); ?>">
					<span class="ddh-deliver__pin" aria-hidden="true">📍</span>
					<span class="ddh-deliver__lines">
						<span class="ddh-deliver__kicker"><?php esc_html_e( 'Deliver to', 'dejoiy' ); ?></span>
						<span class="ddh-deliver__value"><?php echo esc_html( dejoiy_desktop_marketplace_delivery_label() ); ?></span>
					</span>
				</a>
				<form class="ddh-search" action="<?php echo esc_url( $shop ); ?>" method="get" role="search">
					<label class="screen-reader-text" for="ddh-search-input"><?php esc_html_e( 'Search DEJOIY', 'dejoiy' ); ?></label>
					<input id="ddh-search-input" class="ddh-search__input" type="search" name="s" placeholder="<?php echo esc_attr( isset( $v4['joiPlaceholder'] ) ? $v4['joiPlaceholder'] : __( 'Looking for Joy? Ask DEJOIY', 'dejoiy' ) ); ?>" autocomplete="off" />
					<input type="hidden" name="post_type" value="product" />
					<button type="submit" class="ddh-joi-submit"><?php esc_html_e( 'Ask JOI', 'dejoiy' ); ?></button>
				</form>
				<a class="ddh-account" href="<?php echo esc_url( $account ); ?>">
					<span class="ddh-account__kicker"><?php echo is_user_logged_in() ? esc_html__( 'Hello', 'dejoiy' ) : esc_html__( 'Hello, Sign In', 'dejoiy' ); ?></span>
					<span class="ddh-account__label"><?php esc_html_e( 'Account & Lists', 'dejoiy' ); ?></span>
				</a>
				<a class="ddh-orders" href="<?php echo esc_url( $orders ); ?>">
					<span class="ddh-orders__kicker"><?php esc_html_e( 'Returns', 'dejoiy' ); ?></span>
					<span class="ddh-orders__label"><?php esc_html_e( 'Orders', 'dejoiy' ); ?></span>
				</a>
				<a class="ddh-icon-link" href="<?php echo esc_url( $fav ); ?>"><span class="ddh-icon-link__ico" aria-hidden="true">♡</span><span class="ddh-icon-link__label"><?php esc_html_e( 'Lists', 'dejoiy' ); ?></span></a>
				<a class="ddh-icon-link ddh-icon-link--cart" href="<?php echo esc_url( $cart ); ?>">
					<span class="ddh-icon-link__ico-wrap">🛒<?php
					$count = function_exists( 'dejoiy_mobile_os_get_cart_count' ) ? dejoiy_mobile_os_get_cart_count() : 0;
					if ( $count > 0 ) {
						echo '<span class="ddh-cart-badge">' . esc_html( $count > 99 ? '99+' : (string) $count ) . '</span>';
					}
					?></span>
					<span class="ddh-icon-link__label"><?php esc_html_e( 'Cart', 'dejoiy' ); ?></span>
				</a>
			</div>
		</div>
		<div class="ddh-standalone__row2">
			<div class="ddh-standalone__row2-inner dh-os-v4-universe">
				<button type="button" class="ddh-all-worlds" id="ddh-all-worlds-btn">
					<span class="ddh-all-worlds__bars" aria-hidden="true"><span></span><span></span><span></span></span>
					<span><?php esc_html_e( 'All Worlds', 'dejoiy' ); ?></span>
				</button>
				<div class="dh-os-v4-universe__inner">
					<?php foreach ( $worlds as $item ) : ?>
						<a class="dh-os-v4-universe__link" href="<?php echo esc_url( $item['url'] ); ?>" style="--dh-os-world:<?php echo esc_attr( $item['color'] ?? '#2563eb' ); ?>"><?php echo esc_html( $item['label'] ); ?></a>
					<?php endforeach; ?>
				</div>
				<button type="button" class="dh-os-v4-explore" id="ddh-explore-universe-btn">
					<span class="dh-os-v4-explore__icon" aria-hidden="true">&#9670;</span>
					<span><?php esc_html_e( 'Explore Universe', 'dejoiy' ); ?></span>
				</button>
			</div>
		</div>
		<?php if ( dejoiy_desktop_marketplace_show_category_rail() && function_exists( 'dejoiy_mobile_os_market_categories' ) ) : ?>
		<div class="ddh-category-rail" role="navigation" aria-label="<?php esc_attr_e( 'Shop categories', 'dejoiy' ); ?>">
			<div class="ddh-category-rail__inner">
				<span class="ddh-category-rail__title"><?php esc_html_e( 'Browse', 'dejoiy' ); ?></span>
				<ul class="ddh-category-rail__list">
					<?php foreach ( dejoiy_mobile_os_market_categories() as $cat ) : ?>
						<li><a class="ddh-category-rail__link" href="<?php echo esc_url( $cat['url'] ); ?>"><?php if ( ! empty( $cat['icon'] ) ) : ?><span class="ddh-category-rail__emoji" aria-hidden="true"><?php echo esc_html( $cat['icon'] ); ?></span><?php endif; ?><?php echo esc_html( $cat['label'] ); ?></a></li>
					<?php endforeach; ?>
				</ul>
			</div>
		</div>
		<?php endif; ?>
	</header>
	<?php
	return (string) ob_get_clean();
}

/**
 * Ensure Elementor header or standalone desktop header is output (before Mobile OS chrome).
 */
/**
 * Homepage / Universe layout often skips theme header — bootstrap desktop chrome there only.
 *
 * @return bool
 */
function dejoiy_desktop_marketplace_needs_header_bootstrap() {
	if ( ! is_front_page() ) {
		return false;
	}
	if ( function_exists( 'dejoiy_mobile_home_v2_active' ) && dejoiy_mobile_home_v2_active() ) {
		return true;
	}
	if ( function_exists( 'dejoiy_universe_home_is_active' ) && dejoiy_universe_home_is_active() ) {
		return true;
	}
	return false;
}

function dejoiy_desktop_marketplace_ensure_header() {
	if ( ! dejoiy_desktop_marketplace_header_enabled() ) {
		return;
	}
	if ( ! dejoiy_desktop_marketplace_needs_header_bootstrap() ) {
		return;
	}
	static $done = false;
	if ( $done ) {
		return;
	}

	$html = '';
	if ( function_exists( 'elementor_theme_do_location' ) ) {
		ob_start();
		elementor_theme_do_location( 'header' );
		$html = (string) ob_get_clean();
	}

	if ( '' !== trim( $html ) ) {
		// phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
		echo $html;
	} else {
		// phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
		echo dejoiy_desktop_marketplace_header_standalone_html();
	}

	$done = true;
	do_action( 'dejoiy_desktop_marketplace_header_printed' );
}
add_action( 'wp_body_open', 'dejoiy_desktop_marketplace_ensure_header', 1 );
add_action( 'etheme_after_body_open', 'dejoiy_desktop_marketplace_ensure_header', 1 );
